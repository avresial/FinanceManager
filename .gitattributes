# Default: treat unknown files as text, normalize to LF in repo
* text=auto eol=lf

# C# / .NET source — LF in the repository and working tree
*.cs        text eol=lf
*.razor     text eol=lf
*.cshtml    text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.slnx      text eol=lf
*.sln       text eol=lf
*.editorconfig text eol=lf

# Web assets
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.map       text eol=lf

# Config / data — LF
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf
*.http      text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Scripts
*.ps1       text eol=lf
*.sh        text eol=lf

# Binary
*.png       binary
*.jpg       binary
*.JPG       binary
*.ico       binary
*.pdf       binary
*.lscache   binary
