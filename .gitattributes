# Default: treat unknown files as text, normalize to LF in repo
* text=auto eol=lf

# C# / .NET source — CRLF in working tree (matches code/.editorconfig)
*.cs        text eol=crlf
*.razor     text eol=crlf
*.cshtml    text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.slnx      text eol=crlf
*.sln       text eol=crlf
*.editorconfig text eol=crlf

# Web assets
*.html      text eol=crlf
*.css       text eol=crlf
*.js        text eol=crlf
*.map       text eol=crlf

# Config / data — LF
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf
*.http      text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Scripts
*.ps1       text eol=crlf
*.sh        text eol=lf

# Binary
*.png       binary
*.jpg       binary
*.JPG       binary
*.ico       binary
*.pdf       binary
*.lscache   binary
