 public class LiabilitiesService(IFinancialAccountRepository financialAccountService) : ILiabilitiesService
 {
+    // Same-scope read snapshot: caches the fully enumerated (userId, end) account list per instance so repeated
+    // reads of the same key skip re-enumeration. The repository already deduplicates identical (end, end) queries;
+    // this only removes repeated async enumeration and does not eliminate DB access. Stored after successful
+    // enumeration only, so failed reads are retried on next call.
+    private readonly Dictionary<(int UserId, DateTime End), List<CurrencyAccount>> _endAccounts = [];
+
+    // start is intentionally unused as before: the existing call passes end for both bounds (no date truncation).
+    private async Task<List<CurrencyAccount>> GetEndAccountsAsync(int userId, DateTime end)
+    {
+        if (_endAccounts.TryGetValue((userId, end), out var cached))
+            return cached;
+
+        var accounts = new List<CurrencyAccount>();
+        await foreach (var account in financialAccountService.GetAccounts<CurrencyAccount>(userId, end, end))
+            accounts.Add(account);
+
+        _endAccounts[(userId, end)] = accounts;
+        return accounts;
+    }
