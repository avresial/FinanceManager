+            .Returns(new[] { account8 }.ToAsyncEnumerable());
+        accountRepository
+            .Setup(x => x.GetAccounts<InvestmentAccount>(1, nextMinute.AddMinutes(-1), nextMinute))
+            .Returns(new[] { account7 }.ToAsyncEnumerable());
+
+        valuationService
+            .Setup(x => x.GetAccountValueAsync(
