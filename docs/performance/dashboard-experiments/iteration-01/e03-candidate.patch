+        accountRepository.Verify(x => x.GetAccounts<InvestmentAccount>(2, asOfDate.AddMinutes(-1), asOfDate), Times.Once);
+        accountRepository.Verify(x => x.GetAccounts<InvestmentAccount>(1, nextMinute.AddMinutes(-1), nextMinute), Times.Once);
