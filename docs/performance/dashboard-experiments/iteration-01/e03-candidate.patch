+            .Setup(x => x.GetAccountValueAsync(
+                It.Is<IReadOnlyCollection<int>>(ids => ids.Contains(8)),
+                It.IsAny<Currency>(), asOfDate))
+            .ReturnsAsync(new Dictionary<int, decimal> { [8] = 25m });
+        var eur = new Currency(2, "EUR", "€");
+        valuationService
+            .Setup(x => x.GetAccountValueAsync(
