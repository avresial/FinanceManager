+        var asOfDate = new DateTime(2024, 1, 3);
+
+        // Both accounts share a name so no name-based joining can hide an id mismatch.
+        var account7 = new InvestmentAccount(1, 7, "Broker");
+        var account8 = new InvestmentAccount(1, 8, "Broker");
+
+        accountRepository
+            .Setup(x => x.GetAccounts<InvestmentAccount>(1, asOfDate.AddMinutes(-1), asOfDate))
+            .Returns(new[] { account7, account8 }.ToAsyncEnumerable());
+        valuationService
+            .Setup(x => x.GetAccountValueAsync(
+                It.Is<IReadOnlyCollection<int>>(ids => ids.Count == 2 && ids.Contains(7) && ids.Contains(8)),
+                It.IsAny<Currency>(), asOfDate))
+            .ReturnsAsync(new Dictionary<int, decimal> { [7] = 100m, [8] = -20m });
+
+        var service = CreateService(accountRepository.Object, valuationService.Object);
+
+        List<NameValueResult> typeRows = [];
+        List<NameValueResult> accountRows = [];
+        if (typeFirst)
+        {
+            typeRows = await CollectRowsAsync((IAsyncEnumerable<NameValueResult>)service.GetEndAssetsPerType(1, DefaultCurrency.PLN, asOfDate));
+            accountRows = await CollectRowsAsync((IAsyncEnumerable<NameValueResult>)service.GetEndAssetsPerAccount(1, DefaultCurrency.PLN, asOfDate));
+        }
+        else
+        {
+            accountRows = await CollectRowsAsync((IAsyncEnumerable<NameValueResult>)service.GetEndAssetsPerAccount(1, DefaultCurrency.PLN, asOfDate));
+            typeRows = await CollectRowsAsync((IAsyncEnumerable<NameValueResult>)service.GetEndAssetsPerType(1, DefaultCurrency.PLN, asOfDate));
+        }
+
+        // The negative value nets against the positive one: 100 + (-20) = 80.
+        var stockRow = Assert.Single(typeRows);
+        Assert.Equal(InvestmentType.Stock.ToString(), stockRow.Name);
+        Assert.Equal(80m, stockRow.Value);
+
+        // Only the account with a positive value is listed, identified by its id despite the name clash.
+        var accountRow = Assert.Single(accountRows);
+        Assert.Equal(7, accountRow.AccountId);
+        Assert.Equal("Broker", accountRow.Name);
+        Assert.Equal(100m, accountRow.Value);
+
+        // Both distributions hit one shared snapshot: one repository read and one batched valuation.
