+        Assert.Equal(100m, (await CollectRowsAsync((IAsyncEnumerable<NameValueResult>)service.GetEndAssetsPerAccount(1, DefaultCurrency.PLN, asOfDate))).Single().Value);
+        Assert.Equal(25m, (await CollectRowsAsync((IAsyncEnumerable<NameValueResult>)service.GetEndAssetsPerAccount(2, DefaultCurrency.PLN, asOfDate))).Single().Value);
