+            .ReturnsAsync(new Dictionary<int, decimal> { [7] = 400m });
+        valuationService
+            .Setup(x => x.GetAccountValueAsync(
+                It.Is<IReadOnlyCollection<int>>(ids => ids.Contains(7)),
