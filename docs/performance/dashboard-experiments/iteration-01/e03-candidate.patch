+    [Fact]
+    public async Task GetEndAssets_Revalues_WhenServiceInstanceIsFresh()
+    {
+        var accountRepository = new Mock<IFinancialAccountRepository>();
+        var valuationService = new Mock<IInvestmentValuationService>();
+        var asOfDate = new DateTime(2024, 1, 3);
+        var account7 = new InvestmentAccount(1, 7, "Broker");
+
+        accountRepository
+            .Setup(x => x.GetAccounts<InvestmentAccount>(1, asOfDate.AddMinutes(-1), asOfDate))
+            .Returns(new[] { account7 }.ToAsyncEnumerable());
+        valuationService
+            .Setup(x => x.GetAccountValueAsync(It.IsAny<IReadOnlyCollection<int>>(), It.IsAny<Currency>(), asOfDate))
+            .ReturnsAsync(new Dictionary<int, decimal> { [7] = 100m });
+
+        var firstService = CreateService(accountRepository.Object, valuationService.Object);
+        Assert.Equal(100m, (await CollectRowsAsync((IAsyncEnumerable<NameValueResult>)firstService.GetEndAssetsPerType(1, DefaultCurrency.PLN, asOfDate))).Single().Value);
+
+        // A new service instance (a fresh DI scope) must revalue even for the identical key.
+        valuationService
+            .Setup(x => x.GetAccountValueAsync(It.IsAny<IReadOnlyCollection<int>>(), It.IsAny<Currency>(), asOfDate))
+            .ReturnsAsync(new Dictionary<int, decimal> { [7] = 200m });
+
+        var secondService = CreateService(accountRepository.Object, valuationService.Object);
+        Assert.Equal(200m, (await CollectRowsAsync((IAsyncEnumerable<NameValueResult>)secondService.GetEndAssetsPerType(1, DefaultCurrency.PLN, asOfDate))).Single().Value);
+
+        // Scope freshness: one call per service instance.
+        valuationService.Verify(
+            x => x.GetAccountValueAsync(It.IsAny<IReadOnlyCollection<int>>(), It.IsAny<Currency>(), asOfDate),
+            Times.Exactly(2));
