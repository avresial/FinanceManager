+    [Fact]
+    public async Task GetNetWorth_OverRange_FetchesCurrencyAndBondsInMetadataFreeMode_AndKeepsValues()
+    {
+        const int userId = 1;
+        var start = new DateTime(2024, 1, 1, 0, 0, 0, DateTimeKind.Utc);
+        var end = new DateTime(2024, 1, 3, 0, 0, 0, DateTimeKind.Utc);
+
+        // Accounts are built straight from entry lists (no Add/RecalculateEntryValues) so the
+        // asserted values are exactly what GetThisOrNextOlder reads.
+        var currencyAccount = new CurrencyAccount(userId, 1, "Cash", [
+            new CurrencyAccountEntry(1, 1, start, 100m, 100m),
+            new CurrencyAccountEntry(1, 2, start.AddDays(1), 150m, 50m)
+        ], AccountLabel.Other);
+
+        var bondDetails = new BondDetails("Bond", "Issuer", new DateOnly(2023, 1, 1), new DateOnly(2025, 1, 1), [
+            new BondCalculationMethod { DateOperator = DateOperator.UntilDate, DateValue = "2025-01-01", Rate = 0m }
+        ], DefaultCurrency.PLN, BondType.InflationBond, unitValue: 100m)
+        { Id = 1 };
+
+        var bondAccount = new BondAccount(userId, 2, "Bonds", [
+            new BondAccountEntry(2, 1, start, 10m, 10m, 1)
+        ], AccountLabel.Other);
+
+        _financialAccountRepositoryMock.Setup(r => r.GetAccounts<CurrencyAccount>(userId, start, end, false))
+            .Returns(new[] { currencyAccount }.ToAsyncEnumerable());
+        _financialAccountRepositoryMock.Setup(r => r.GetAccounts<BondAccount>(userId, start, end, false))
+            .Returns(new[] { bondAccount }.ToAsyncEnumerable());
+        _bondDetailsRepositoryMock.Setup(x => x.GetByIdsAsync(It.IsAny<IReadOnlyCollection<int>>(), It.IsAny<CancellationToken>()))
+            .ReturnsAsync((IReadOnlyList<BondDetails>)new[] { bondDetails });
+
+        var result = await _netWorthService.GetNetWorth(userId, DefaultCurrency.PLN, start, end);
+
+        // Currency: 100 (Jan 1) / 150 (Jan 2-3). Bond: 10 units * unitValue 100 at zero rate.
+        Assert.Equal(1100m, result[start]);
+        Assert.Equal(1150m, result[start.AddDays(1)]);
+        Assert.Equal(1150m, result[end]);
+
+        _financialAccountRepositoryMock.Verify(r => r.GetAccounts<CurrencyAccount>(userId, start, end, false), Times.Once);
+        _financialAccountRepositoryMock.Verify(r => r.GetAccounts<CurrencyAccount>(userId, start, end, true), Times.Never);
+        _financialAccountRepositoryMock.Verify(r => r.GetAccounts<BondAccount>(userId, start, end, false), Times.Once);
