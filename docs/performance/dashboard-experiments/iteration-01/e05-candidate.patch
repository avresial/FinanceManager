+
+    [Fact]
+    public async Task GetNetWorth_OverRange_BondAccounts_ValueEachInstrumentOncePerAccount()
+    {
+        const int userId = 1;
+        var start = new DateTime(2024, 1, 1, 0, 0, 0, DateTimeKind.Utc);
+        var end = new DateTime(2024, 1, 3, 0, 0, 0, DateTimeKind.Utc);
+
+        // Account 1 references instrument 1 twice (in-range entries plus a boundary entry), so an
+        // undeduplicated id list would price it twice; instrument 2 exists only as a boundary entry.
+        var sharedBondAccount = new BondAccount(
+            userId, 1, "Bonds A",
+            [
+                new BondAccountEntry(1, 3, new DateTime(2024, 1, 3), 15m, 5m, 1),
+                new BondAccountEntry(1, 1, new DateTime(2024, 1, 1), 10m, 10m, 1)
+            ],
+            AccountLabel.Other,
+            new Dictionary<int, BondAccountEntry>
+            {
+                [1] = new BondAccountEntry(1, 2, new DateTime(2023, 12, 20), 5m, 5m, 1),
+                [2] = new BondAccountEntry(1, 4, new DateTime(2023, 12, 28), 4m, 4m, 2)
+            });
+
+        // Account 2 holds the same instrument (id 1) from its own entry; it must be priced independently.
+        var sharedInstrumentAccount = new BondAccount(userId, 2, "Bonds B",
+            [new BondAccountEntry(2, 5, new DateTime(2023, 12, 15), 7m, 7m, 1)],
+            AccountLabel.Other);
+
+        var emptyAccount = new BondAccount(userId, 3, "Bonds C", AccountLabel.Other);
+
+        _financialAccountRepositoryMock.Setup(r => r.GetAccounts<BondAccount>(userId, It.IsAny<DateTime>(), It.IsAny<DateTime>()))
+            .Returns(new[] { sharedBondAccount, sharedInstrumentAccount, emptyAccount }.ToAsyncEnumerable());
+        _bondDetailsRepositoryMock.Setup(x => x.GetByIdsAsync(It.IsAny<IReadOnlyCollection<int>>(), It.IsAny<CancellationToken>()))
+            .ReturnsAsync(new[] { CreateZeroRateDetails(1), CreateZeroRateDetails(2) });
+
+        var result = await _netWorthService.GetNetWorth(userId, DefaultCurrency.PLN, start, end);
+
+        // Day 1: A's day-1 entry (10) selected for its posting day + boundary-only instrument 2 (4)
+        //         + B's pre-range entry on the shared instrument (7).
+        Assert.Equal(2_100m, result[start]);
+        // Day 2: no new entry; A's next-older entry (10) carries over, same selections as day 1.
+        Assert.Equal(2_100m, result[start.AddDays(1)]);
+        // Day 3: A switches to its day-3 entry (15); the boundary instrument and B are unchanged.
+        Assert.Equal(2_600m, result[end]);
+
+        Assert.Equal(3, result.Count);
+        Assert.Equal(new[] { end, start.AddDays(1), start }, result.Keys.ToList());
+    }
+
+    private static BondDetails CreateZeroRateDetails(int id) => new(
+        "Bond",
+        "Issuer",
+        new DateOnly(2023, 1, 1),
+        new DateOnly(2025, 1, 1),
+        [new BondCalculationMethod { DateOperator = DateOperator.UntilDate, DateValue = "2025-01-01", Rate = 0m }],
+        DefaultCurrency.PLN,
+        BondType.InflationBond,
+        100m)
+    { Id = id };
 }
