{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UseInMemoryDatabase": "false",
  "JwtConfig": {
    "Issuer": "FinanceManager.api",
    "Audience": "FinanceManager.Frontend",
    "TokenValidityMins": "60"
  },
  "ReverseProxy": {
    "KnownProxies": [ "127.0.0.1" ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7206",
      "http://localhost:5235"
    ]
  }
}