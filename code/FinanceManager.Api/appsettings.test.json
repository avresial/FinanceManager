{
  "McpOAuth": {
    "Enabled": true,
    "Issuer": "http://localhost/",
    "Resource": "http://localhost/mcp",
    "LoginUrl": "http://localhost/login",
    "DisplayName": "Finance Manager MCP",
    "Clients": [
      {
        "ClientId": "finance-manager-mcp-test",
        "DisplayName": "Finance Manager MCP (Test)",
        "RequirePkce": true,
        "RedirectUris": [ "http://127.0.0.1:6274/oauth/callback" ]
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UseInMemoryDatabase": "false",
  "JwtConfig": {
    "Issuer": "FinanceManager.api",
    "Audience": "FinanceManager.Frontend",
    "TokenValidityMins": "60"
  },
  "ReverseProxy": {
    "KnownProxies": [ "127.0.0.1" ]
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7206",
      "http://localhost:5235"
    ]
  }
}
