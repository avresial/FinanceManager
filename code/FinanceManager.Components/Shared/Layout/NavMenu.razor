@using FinanceManager.Domain.Identity.Entities
<MudNavMenu Class="pt-2" aria-label="Primary">
    <MudTooltip Text="@($"Version {ApplicationVersion.Version}")" Placement="Placement.Right" Inline="false" Style="pointer-events: none;">
        <MudText Typo="Typo.h6" Class="px-4" Color="Color.Primary" aria-label="@($"FinanceManager, version {ApplicationVersion.Version}")"
                 tabindex="0" data-testid="nav-brand">@(DrawerIsOpen ? "FinanceManager" : "FM")</MudText>
    </MudTooltip>
    <MudDivider Class="my-2" />
    <MudNavLink Icon="@Icons.Material.Filled.Dashboard" Href="" Match="NavLinkMatch.All" data-testid="nav-dashboard">Dashboard</MudNavLink>

    @if (_displayAssetsLink)
    {
        <MudNavLink Icon="@Icons.Material.Filled.TrendingUp" Href="Assets" data-testid="nav-assets">Assets</MudNavLink>
    }

    @if (_displayLiabilitiesLink)
    {
        <MudNavLink Icon="@Icons.Material.Filled.TrendingDown" Href="Liabilities" data-testid="nav-liabilities">Liabilities</MudNavLink>
    }

    <MudNavLink Icon="@Icons.Material.Filled.ReceiptLong" Href="Transactions" data-testid="nav-transactions">Transactions</MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.Subscriptions" Href="Subscriptions" data-testid="nav-subscriptions">Subscriptions</MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.Timeline" Href="CashFlowForecast" data-testid="nav-cash-flow-forecast">Cash flow forecast</MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.Notifications" Href="Alerts" data-testid="nav-alerts">Alerts</MudNavLink>
    <MudNavLink Icon="@Icons.Material.Filled.AutoFixHigh" Href="TransactionRules" data-testid="nav-transaction-rules">Automation</MudNavLink>
    <MudDivider Class="my-2" />

    <MudText Typo="Typo.h6" Class="px-5 mud-text-secondary">
        @if (DrawerIsOpen)
        {
            @("Accounts")
        }
        else
        {
            @("A")
        }
    </MudText>
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mx-2">
            @ErrorMessage
            <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="_isRetrying" OnClick="RetryAsync">Retry</MudButton>
        </MudAlert>
    }
    @if (Accounts is not null && Accounts.Any())
    {
        @foreach (var account in Accounts)
        {
            <MudNavLink Icon="@Icons.Material.Filled.Wallet" Href="@($"AccountDetails/{account.Key}")">@account.Value</MudNavLink>
        }
    }

    <MudNavLink Icon="@Icons.Material.Filled.Add" Href="AddAccount" data-testid="nav-add-account" aria-label="Add account">Add</MudNavLink>

</MudNavMenu>
