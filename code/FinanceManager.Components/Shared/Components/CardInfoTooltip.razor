<MudTooltip Text="@(ChildContent is null ? Text : null)"
            TooltipContent="ChildContent"
            Arrow="true"
            Placement="@Placement"
            Class="@TooltipClass"
            RootClass="fm-card-info-anchor">
    <MudIconButton Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Color="Color.Default"
                   aria-label="@ResolvedAriaLabel" />
</MudTooltip>
