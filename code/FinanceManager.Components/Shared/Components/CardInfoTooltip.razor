<MudTooltip TooltipContent="TooltipBody"
            Arrow="true"
            Placement="@Placement"
            Class="@ResolvedTooltipClass"
            RootClass="fm-card-info-root">
    <div class="fm-card-info-trigger"
         tabindex="0"
         aria-label="@ResolvedAriaLabel">
        @ChildContent
    </div>
</MudTooltip>
