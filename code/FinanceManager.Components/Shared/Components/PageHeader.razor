<SectionContent SectionName="page-title">
    <MudText Typo="Typo.h6" HtmlTag="h1" Class="fm-page-title" tabindex="-1">@Title</MudText>
</SectionContent>

@if (!string.IsNullOrWhiteSpace(Subtitle) || Actions is not null)
{
    <div class="fm-page-header">
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <div class="fm-page-header-text">
                <MudText Class="mud-text-secondary" Typo="Typo.body1">@Subtitle</MudText>
            </div>
        }
        @if (Actions is not null)
        {
            <div class="fm-page-header-actions">@Actions</div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
