<div class="single-category-distribution" data-testid="single-category-distribution"
     role="img" aria-label="@(MoneyFormatter.Format(Total, CurrencyShortName) + ", 100% of " + DistributionName)">
    <div class="single-category-ring" style="border-color: @Color">
        <span class="single-category-total">@MoneyFormatter.Format(Total, CurrencyShortName)</span>
        <span class="single-category-percent">100%</span>
    </div>
</div>

@code {
    [Parameter] public decimal Total { get; set; }
    [Parameter] public string CurrencyShortName { get; set; } = "PLN";
    [Parameter] public string Color { get; set; } = "";
    [Parameter] public string DistributionName { get; set; } = "";
}
