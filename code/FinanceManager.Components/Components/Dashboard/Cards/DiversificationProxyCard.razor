@using ApexCharts

<MudCard Outlined Class="d-flex flex-column" Style="@($"height:{Height};")">
    <MudPaper Class="pa-3 pb-0" Elevation="0">
        <div class="d-flex align-center gap-1">
            <MudText Typo="Typo.h5">Diversification proxy</MudText>
            <MudTooltip Text="Based on number of asset classes and unique holdings; not investment advice.">
                <MudIconButton Icon="@Icons.Material.Filled.Info" Size="MudBlazor.Size.Small" AriaLabel="Diversification proxy information" />
            </MudTooltip>
        </div>
    </MudPaper>

    <MudPaper Class="flex-grow-1 d-flex flex-column align-center justify-center pa-3 pt-0" Elevation="0">
        @if (_isLoading)
        {
            <ChartSpinner MaxHeight=@Height />
        }
        else if (_score is not null && _chartOptions is not null)
        {
            <div style="width:100%;max-width:320px;">
                <ApexChart TItem="ScorePoint" Options="@_chartOptions" Height="220">
                    <ApexPointSeries TItem="ScorePoint"
                                     Items="@_series"
                                     Name="Diversification"
                                     SeriesType="SeriesType.RadialBar"
                                     XValue="@(p => (object)p.Label)"
                                     YValue="@(p => (decimal?)p.Value)" />
                </ApexChart>
            </div>

            @if (_explanations.Count > 0)
            {
                <div class="d-flex flex-column gap-1 mt-3" style="width:100%;">
                    @foreach (var explanation in _explanations)
                    {
                        <div class="d-flex align-start gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.Info" Color="@_bandColor" Size="MudBlazor.Size.Small" />
                            <MudText Typo="Typo.caption" Class="text-muted" Style="line-height:1.3;">@explanation</MudText>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <MudText Typo="Typo.button" HtmlTag="h3">No data</MudText>
        }
    </MudPaper>
</MudCard>
