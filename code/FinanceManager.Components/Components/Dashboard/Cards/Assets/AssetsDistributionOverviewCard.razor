@using ApexCharts
@using FinanceManager.Components.Components.SharedComponents
@using FinanceManager.Domain.Entities.MoneyFlowModels
@using FinanceManager.Domain.Providers

<MudCard Outlined Class="d-flex flex-column" Style="@($"height:{Height};")">
    <MudPaper Class="d-flex align-start justify-space-between gap-4 pa-3 pb-0 flex-shrink-0" Elevation="0">
        <div>
            <MudText Typo="Typo.h5">Assets distribution</MudText>
            @if (_isLoading)
            {
                <MudText Typo="Typo.h6" Class="text-muted">
                    <StringSpinner CharactersCount="4" />
                </MudText>
            }
            else if (_totalAssets != 0)
            {
                <MudText Class="ad-total">@_totalAssets.ToString("0.00") @_currency.ShortName</MudText>
            }
        </div>
        <MudToggleGroup T="string" Value="@_view" ValueChanged="OnViewChangedAsync"
                        Outlined="true" Dense="true" Class="flex-shrink-0 mt-1">
            <MudToggleItem Value="@_viewByType" Text="By type" />
            <MudToggleItem Value="@_viewByWallet" Text="By wallet" />
        </MudToggleGroup>
    </MudPaper>

    <MudPaper Class="flex-grow-1 overflow-hidden d-flex align-center" Elevation="0">
        @if (_isLoading)
        {
            <div style="width:100%;height:100%">
                <ChartSpinner MaxHeight=@Height />
            </div>
        }
        else if (ActiveData.Any())
        {
            <div class="ad-body">
                <div class="ad-chart-wrap">
                    <ApexChart @ref="_chart" TItem="NameValueResult" Options="_chartOptions" Width="150" Height="150">
                        <ApexPointSeries TItem="NameValueResult"
                                         Items="ActiveData"
                                         Name="Assets"
                                         SeriesType="SeriesType.Pie"
                                         XValue="e => e.Name"
                                         YAggregate="@(e => e.Sum(x => Math.Round(x.Value, 2)))"
                                         OrderByDescending="@(e => e.Y)" />
                    </ApexChart>
                </div>
                <div class="ad-legend">
                    @{
                        var sorted = ActiveData.OrderByDescending(x => x.Value).ToList();
                        var colors = ColorsProvider.GetColors();
                        for (int i = 0; i < sorted.Count; i++)
                        {
                            var item = sorted[i];
                            var color = colors[i % colors.Count];
                            var pct = _totalAssets == 0 ? 0m : Math.Round(item.Value / _totalAssets * 100m, 1);
                            <div class="ad-legend-row">
                                <span class="ad-legend-dot" style="background: @color"></span>
                                <span class="ad-legend-name">@item.Name</span>
                                <span class="ad-legend-vals">
                                    <span class="ad-legend-amt">@item.Value.ToString("0.00")</span>
                                    <span class="ad-legend-pct">@pct.ToString("0.0")%</span>
                                </span>
                            </div>
                        }
                    }
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-grow-1 justify-center align-content-center flex-wrap">
                <MudText Typo="Typo.button" HtmlTag="h3">No data</MudText>
            </div>
        }
    </MudPaper>
</MudCard>
