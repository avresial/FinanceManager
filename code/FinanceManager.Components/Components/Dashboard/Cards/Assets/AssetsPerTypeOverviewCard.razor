<MudCard Outlined Class="d-flex flex-nowrap" Style="@($"height:{Height};")">
    <MudPaper Class="flex-grow-0 p-3" Elevation="0">
        <MudText Typo=Typo.h5>Assets per type</MudText>
        @if (_isLoading)
        {
            <MudText Typo=Typo.h6 Class="mb-2 text-muted">
                <StringSpinner CharactersCount="4" />
            </MudText>
        }
        else if (_data.Any())
        {
            <MudText Typo=Typo.h6 Class="mb-2 text-muted">@_totalAssets.ToString("0.00") @_currency</MudText>
        }
    </MudPaper>
    <MudPaper Class="flex-grow-1 overflow-hidden d-flex align-center justify-center" Elevation="0">
        @if (_isLoading)
        {
            <div style="height:100%">
                <ChartSpinner MaxHeight=@Height />
            </div>
        }
        else if (_data.Any())
        {
            <div class="d-flex align-center justify-center" style="width:100%; height:100%;">
                <MudChart T="double" ChartType="ChartType.Pie" ChartSeries="@_chartSeries" ChartLabels="@_labels" Width="82%"
                          Height="82%" ChartOptions=_chartOptions Class="p-3" />
            </div>
        }
        else
        {
            <div class="d-flex flex-grow-1 justify-center align-content-center flex-wrap">
                <MudText Typo="Typo.button" HtmlTag="h3">No data</MudText>
            </div>
        }
    </MudPaper>
</MudCard>