<MudCard Outlined Class="d-flex flex-nowrap" Style="@($"height:{Height};")">
    <MudPaper Class="flex-grow-0 p-3" Elevation="0">
        <MudText Typo=Typo.h5>Labels</MudText>
    </MudPaper>

    <MudPaper Class="flex-grow-1 overflow-auto" Elevation="0">
        @if (_isLoading)
        {
            <div style="height:100%">
                <ChartSpinner MaxHeight=@Height />
            </div>
        }
        else if (_data.Any())
        {
            <MudList T="string" ReadOnly Class="pa-3">
                @foreach (var label in _data)
                {
                    var percentage = GetPercentage(label.Value);
                    var isIncome = label.Value > 0;
                    var categoryIcon = GetCategoryIcon(label.Name);
                    var barColor = isIncome ? Color.Success : Color.Error;

                    <MudListItem Class="pa-2">
                        <div class="d-flex align-items-center gap-3 w-100">
                            <MudIcon Icon="@categoryIcon" Size="Size.Small" />
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.body2" Class="font-weight-500">@label.Name</MudText>
                                <MudProgressLinear Value="@percentage" Color="@barColor"                                                 Class="mt-1" Size="Size.Small" />
                            </div>
                            <MudText Typo="Typo.body2" Color="@barColor" Class="@($"font-weight-600")"
                                     Style="min-width: 120px; text-align: right;">
                                @($"{(isIncome ? "+" : "")}{label.Value:0.00} {_currency}")
                            </MudText>
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
        else
        {
            <div class="d-flex flex-grow-1 justify-center align-content-center flex-wrap">
                <MudText Typo="Typo.button" HtmlTag="h3">No data</MudText>
            </div>
        }
    </MudPaper>
</MudCard>