@using ApexCharts
@using FinanceManager.Domain.Entities.MoneyFlowModels

@if (IsMobile)
{
    @* On mobile the account name moves into the top app bar (next to the menu button) so the
       hero is just the chart and a compact range strip — no title competing for the row. *@
    <SectionContent SectionName="page-title">
        <MudText Typo="Typo.h6" Class="ml-2" Style="color: var(--mud-palette-text-primary);">@AccountName</MudText>
    </SectionContent>
}

<MudPaper Elevation="0" Class="pa-6 pb-0 mb-0" Style="background-color: transparent;">
    @if (!IsMobile)
    {
        <MudStack Spacing="4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudAvatar Color="MudBlazor.Color.Primary" Variant="Variant.Filled" Size="MudBlazor.Size.Large">
                    @GetInitial()
                </MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.overline" Color="MudBlazor.Color.Default">@AccountTypeLabel · @Currency</MudText>
                    <MudText Typo="Typo.h5">@AccountName</MudText>
                </MudStack>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.End" Justify="Justify.SpaceBetween" Spacing="4">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.overline" Color="MudBlazor.Color.Default">Balance</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1">
                        <MudText Typo="Typo.h3" Class="fm-tabular">@Balance.ToString("N2")</MudText>
                        <MudText Typo="Typo.h5" Color="MudBlazor.Color.Default">@Currency</MudText>
                    </MudStack>
                </MudStack>

                <MudStack Spacing="1" AlignItems="AlignItems.End">
                    <MudText Typo="Typo.overline" Color="MudBlazor.Color.Default">Change · @SelectedRange</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@(BalanceChange >= 0 ? Icons.Material.Filled.TrendingUp : Icons.Material.Filled.TrendingDown)"
                                 Color="@(BalanceChange >= 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error)" Size="MudBlazor.Size.Small" />
                        <MudText Typo="Typo.h6" Color="@(BalanceChange >= 0 ? MudBlazor.Color.Success : MudBlazor.Color.Error)" Class="fm-tabular">
                            @(BalanceChange >= 0 ? "+" : "")@BalanceChange.ToString("N2") @Currency
                        </MudText>
                        @if (BalanceChangePercent.HasValue)
                        {
                            <MudText Typo="Typo.body2" Color="MudBlazor.Color.Default" Class="fm-tabular">
                                · @(BalanceChange >= 0 ? "+" : "")@BalanceChangePercent.Value.ToString("0.0")%
                            </MudText>
                        }
                    </MudStack>
                </MudStack>
            </MudStack>
        </MudStack>
    }

    <div class="mx-n6 mt-2" style="min-height: 200px; position: relative;">
        @if (IsChartLoading)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" Height="200px" Width="100%" />
        }
        else
        {
            <ApexChart TItem="TimeSeriesModel" Options="_heroChartOptions" Height="200">
                <ApexPointSeries TItem="TimeSeriesModel"
                                 Items="ChartData"
                                 Name="Balance"
                                 SeriesType="SeriesType.Area"
                                 XValue="@(p => p.DateTime.ToLocalTime())"
                                 YValue="@(p => p.Value)" />
            </ApexChart>
        }
    </div>

    @* Borderless range selector under the chart — light text labels with the active one in the
       accent colour, plus a calendar icon for a custom range (Apple Stocks / Robinhood pattern). *@
    <div class="d-flex justify-center align-center flex-wrap mt-1 pb-1" style="gap: 2px;">
        @foreach (var range in _ranges)
        {
            <MudButton Variant="Variant.Text" Size="MudBlazor.Size.Small"
                       Color="@(SelectedRange == range ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                       Style="@($"min-width: 44px; font-weight: {(SelectedRange == range ? 700 : 500)};")"
                       OnClick="@(() => OnRangeChanged(range))">@range</MudButton>
        }
        <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth" Size="MudBlazor.Size.Small"
                       Color="@(SelectedRange == "Range" ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                       OnClick="@(() => OnRangeChanged("Range"))" aria-label="Custom date range" />
    </div>

    @if (SelectedRange == "Range")
    {
        <div class="pb-2">
            <MudStack Spacing="2">
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Justify="Justify.Center">
                    @foreach (var preset in _presets)
                    {
                        <MudButton Variant="Variant.Text" Size="MudBlazor.Size.Small"
                                   Color="@(IsPresetActive(preset.Key) ? MudBlazor.Color.Primary : MudBlazor.Color.Default)"
                                   Style="@($"min-width: 100px; font-weight: {(IsPresetActive(preset.Key) ? 600 : 400)};")"
                                   OnClick="@(() => ApplyPreset(preset.Key))">@preset.Key</MudButton>
                    }
                </MudStack>
                <MudDateRangePicker @ref="_picker" @bind-DateRange="_pendingRange"
                                    PickerVariant="PickerVariant.Static"
                                    DisplayMonths="@(IsMobile ? 1 : 2)"
                                    Color="MudBlazor.Color.Primary"
                                    AutoClose="false"
                                    Editable="false"
                                    Class="w-100" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="px-2">
                    <MudText Typo="Typo.body2" Class="fm-tabular" Color="MudBlazor.Color.Default">
                        @RangeReadout
                    </MudText>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Text" Size="MudBlazor.Size.Small" OnClick="CancelCustomRange">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small"
                                   Disabled="@(_pendingRange?.Start is null || _pendingRange?.End is null)"
                                   OnClick="ApplyCustomRange">Apply</MudButton>
                    </MudStack>
                </MudStack>
            </MudStack>
        </div>
    }
</MudPaper>

@code {
    private MudDateRangePicker? _picker;
    private DateRange? _pendingRange;
    private string? _activePreset;
    private string _previousFixedRange = "3M";

    [Parameter] public required string AccountName { get; set; }
    [Parameter] public string AccountTypeLabel { get; set; } = "Cash account";
    [Parameter] public required string Currency { get; set; }
    [Parameter] public decimal Balance { get; set; }
    [Parameter] public decimal BalanceChange { get; set; }
    [Parameter] public decimal? BalanceChangePercent { get; set; }
    [Parameter] public string SelectedRange { get; set; } = "3M";
    [Parameter] public EventCallback<string> SelectedRangeChanged { get; set; }
    [Parameter] public DateRange? CustomDateRange { get; set; }
    [Parameter] public EventCallback<DateRange?> CustomDateRangeChanged { get; set; }
    [Parameter] public bool IsChartLoading { get; set; }
    [Parameter] public List<TimeSeriesModel> ChartData { get; set; } = [];
    [Parameter] public bool IsMobile { get; set; }

    private readonly string[] _ranges = ["1M", "3M", "6M", "1Y"];

    private IReadOnlyDictionary<string, Func<DateRange>> _presets => new Dictionary<string, Func<DateRange>>
    {
        ["Last 7 days"]    = () => new DateRange(DateTime.Today.AddDays(-6), DateTime.Today),
        ["Last 30 days"]   = () => new DateRange(DateTime.Today.AddDays(-29), DateTime.Today),
        ["Last 3 months"]  = () => new DateRange(DateTime.Today.AddMonths(-3), DateTime.Today),
        ["Last 6 months"]  = () => new DateRange(DateTime.Today.AddMonths(-6), DateTime.Today),
        ["Year to date"]   = () => new DateRange(new DateTime(DateTime.Today.Year, 1, 1), DateTime.Today),
    };

    private bool IsPresetActive(string presetName) => _activePreset == presetName;

    private string RangeReadout
    {
        get
        {
            if (_pendingRange?.Start is null && _pendingRange?.End is null) return "Select a date range";
            var start = _pendingRange?.Start?.ToString("dd MMM yyyy") ?? "…";
            var end = _pendingRange?.End?.ToString("dd MMM yyyy") ?? "…";
            return $"{start}  ›  {end}";
        }
    }

    private void ApplyPreset(string presetName)
    {
        _activePreset = presetName;
        _pendingRange = _presets[presetName]();
    }

    private async Task ApplyCustomRange()
    {
        if (_pendingRange is null) return;
        CustomDateRange = _pendingRange;
        await CustomDateRangeChanged.InvokeAsync(_pendingRange);
    }

    private async Task CancelCustomRange()
    {
        _pendingRange = CustomDateRange;
        _activePreset = null;
        SelectedRange = _previousFixedRange;
        await SelectedRangeChanged.InvokeAsync(SelectedRange);
    }

    private static readonly ApexChartOptions<TimeSeriesModel> _heroChartOptions = new()
    {
        Chart = new Chart
        {
            Background = "transparent",
            Toolbar = new Toolbar { Show = false },
            Animations = new Animations { Enabled = false },
        },
        Colors = ["#ffab00"],
        Stroke = new Stroke { Curve = Curve.Smooth, Width = 2, LineCap = LineCap.Round },
        DataLabels = new DataLabels { Enabled = false },
        Legend = new Legend { Show = false },
        Fill = new Fill
        {
            Type = [FillType.Gradient],
            Gradient = new FillGradient { OpacityFrom = 0.45, OpacityTo = 0d, Stops = [0, 100] },
        },
        Grid = new Grid { Show = false, Padding = new Padding { Left = 0, Right = 0, Top = 0, Bottom = 0 } },
        Xaxis = new XAxis
        {
            Labels = new XAxisLabels { Show = false },
            AxisBorder = new AxisBorder { Show = false },
            AxisTicks = new AxisTicks { Show = false },
        },
        Yaxis = [new YAxis { Show = false, Labels = new YAxisLabels { Show = false } }],
        Tooltip = new Tooltip { Enabled = false },
    };

    private string GetInitial() => string.IsNullOrWhiteSpace(AccountName) ? "?" : AccountName.Trim()[..1].ToUpperInvariant();

    private async Task OnRangeChanged(string value)
    {
        if (value == "Range" && _ranges.Contains(SelectedRange))
            _previousFixedRange = SelectedRange;
        SelectedRange = value;
        if (value == "Range")
            _pendingRange = CustomDateRange;
        await SelectedRangeChanged.InvokeAsync(value);
    }
}
