@using CsvHelper
@using CsvHelper.Configuration
@using FinanceManager.Infrastructure.Readers
@using Microsoft.AspNetCore.Components.Forms
@using System.Globalization

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-2">

    <MudStack Spacing="1" Class="mb-6">
        <MudText Typo="Typo.h5">
            Import to <MudText Inline="true" Typo="Typo.h5" Color="Color.Primary"><b>@AccountName</b></MudText>
        </MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Upload a CSV export, map your columns, and resolve any conflicts with existing entries.
        </MudText>
    </MudStack>

    <MudPaper Outlined="true" Elevation="0" Class="rounded-lg">
        <MudStepper @bind-ActiveIndex="_stepIndex" OnPreviewInteraction="OnPreviewInteraction">
            <ChildContent>

                <MudStep Title="Select file" SecondaryText="CSV upload" @bind-Completed="_step1Complete">
                    <MudStack Spacing="3" Class="pa-4">
                        @foreach (var error in _erorrs)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true">@error</MudAlert>
                        }

                        @if (!_rawPreview.Any() && (_isImportingData || !string.IsNullOrEmpty(_fileName)))
                        {
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="2" Class="py-12">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    Reading <b>@_fileName</b>…
                                </MudText>
                            </MudStack>
                        }
                        else if (!_rawPreview.Any())
                        {
                            <MudFileUpload T="IBrowserFile" Hidden="@false"
                                           InputClass="absolute mud-width-full mud-height-full overflow-hidden z-10"
                                           InputStyle="opacity:0" ErrorText="@string.Empty" tabindex="-1"
                                           @ondrop="@ClearDragClass" @ondragenter="@SetDragClass"
                                           @ondragleave="@ClearDragClass" @ondragend="@ClearDragClass"
                                           OnFilesChanged="UploadFiles">
                                <CustomContent>
                                    <MudPaper Elevation="0" Class="@_dragClass">
                                        <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="3" Class="py-6">
                                            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Square="false" Size="Size.Large">
                                                <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" />
                                            </MudAvatar>
                                            <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                                <MudText Typo="Typo.body1"><b>Drop CSV file here, or click to browse</b></MudText>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                    We support exports from mBank, ING, PKO, Santander and Revolut.
                                                </MudText>
                                            </MudStack>
                                            <MudStack Row="true" Spacing="6" Class="mt-2">
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary"><b>Format</b> · CSV</MudText>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary"><b>Max size</b> · 20 MB</MudText>
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary"><b>Encoding</b> · UTF-8 / Win-1250</MudText>
                                            </MudStack>
                                        </MudStack>
                                    </MudPaper>
                                </CustomContent>
                                <SelectedTemplate>@* suppress default file chip *@</SelectedTemplate>
                            </MudFileUpload>
                        }
                        else
                        {
                            <MudPaper Outlined="true" Elevation="0" Class="pa-4">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Square="true" Size="Size.Medium">
                                        <MudIcon Icon="@Icons.Material.Outlined.Description" />
                                    </MudAvatar>
                                    <MudStack Spacing="0" Style="flex:1;min-width:0;">
                                        <MudText Typo="Typo.body1"><b>@_fileName</b></MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            <b>@($"{_fileSize / 1024.0:F1} KB")</b> ·
                                            <b>@_totalRowCount rows</b> ·
                                            <b>@_headers.Count columns</b> detected
                                        </MudText>
                                    </MudStack>
                                    <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="Clear">Replace</MudButton>
                                </MudStack>
                            </MudPaper>

                            <MudStack Row="true" AlignItems="AlignItems.End" Class="mt-2 mud-width-full">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">
                                        Preview
                                        <MudText Inline="true" Typo="Typo.caption" Class="mud-text-secondary">
                                            · first @_rawPreview.Count of @_totalRowCount rows
                                        </MudText>
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        Check that columns split correctly. If they don't, change the delimiter.
                                    </MudText>
                                </MudStack>
                                <MudSelect T="string" Label="Delimiter" @bind-Value="Delimiter"
                                           Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Class="ml-auto" Style="max-width: 220px;">
                                    <MudSelectItem T="string" Value="@(",")">Comma  ( , )</MudSelectItem>
                                    <MudSelectItem T="string" Value="@(";")">Semicolon  ( ; )</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("\t")">Tab  ( \t )</MudSelectItem>
                                </MudSelect>
                            </MudStack>

                            <MudSimpleTable Dense="true" Hover="true" Style="overflow-x: auto;" Elevation="0">
                                <thead>
                                    <tr>
                                        @foreach (var h in _headers)
                                        {
                                            <th>@h</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _rawPreview)
                                    {
                                        <tr>
                                            @for (int i = 0; i < _headers.Count; i++)
                                            {
                                                <td>
                                                    @{
                                                        if (i < row.Count)
                                                        {
                                                            var rowContent = new string(row[i].Take(20).ToArray());
                                                            if (rowContent.Length == 20) rowContent += "…";
                                                            @(rowContent)
                                                        }
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </MudStack>
                </MudStep>

                <MudStep Title="Map columns" SecondaryText="Required &amp; optional" @bind-Completed="_step2Complete"
                         Disabled="@(_step1Complete == false)">
                    <MudStack Spacing="4" Class="pa-4">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle2">Column mapping</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                We've guessed mappings from your CSV headers. Adjust if anything looks wrong, then preview the result below.
                            </MudText>
                        </MudStack>

                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" Label="Posting date" Required="true"
                                           Variant="Variant.Outlined" Margin="Margin.Dense"
                                           HelperText="Date the transaction was booked"
                                           Value="_selectedPostingDateHeader"
                                           ValueChanged="@((string v) => { _selectedPostingDateHeader = v; OnMappingChanged(); })">
                                    @foreach (var h in _headers)
                                    {
                                        <MudSelectItem T="string" Value="@h">@h</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" Label="Value change" Required="true"
                                           Variant="Variant.Outlined" Margin="Margin.Dense"
                                           HelperText="Signed amount (negative = outflow)"
                                           Value="_selectedValueChangeHeader"
                                           ValueChanged="@((string v) => { _selectedValueChangeHeader = v; OnMappingChanged(); })">
                                    @foreach (var h in _headers)
                                    {
                                        <MudSelectItem T="string" Value="@h">@h</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" Label="Contractor details"
                                           Variant="Variant.Outlined" Margin="Margin.Dense"
                                           HelperText="Counterparty name or account (optional)"
                                           Value="_selectedContractorDetailsHeader"
                                           ValueChanged="@((string v) => { _selectedContractorDetailsHeader = v; OnMappingChanged(); })"
                                           Clearable="true">
                                    @foreach (var h in _headers)
                                    {
                                        <MudSelectItem T="string" Value="@h">@h</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" Label="Description"
                                           Variant="Variant.Outlined" Margin="Margin.Dense"
                                           HelperText="Free-text description / title (optional)"
                                           Value="_selectedDescriptionHeader"
                                           ValueChanged="@((string v) => { _selectedDescriptionHeader = v; OnMappingChanged(); })"
                                           Clearable="true">
                                    @foreach (var h in _headers)
                                    {
                                        <MudSelectItem T="string" Value="@h">@h</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        </MudGrid>

                        <MudDivider />

                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Outlined.SwapHoriz" Size="Size.Small" Color="Color.Primary" />
                            <MudText Typo="Typo.subtitle2">Mapped preview</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">· how rows will be imported</MudText>
                        </MudStack>

                        @if (_mappedPreview.Any())
                        {
                            <MudSimpleTable Dense="true" Hover="true" Style="overflow-x: auto;" Elevation="0">
                                <thead>
                                    <tr>
                                        <th>Posting date</th>
                                        <th>Value change</th>
                                        <th>Contractor</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _mappedPreview)
                                    {
                                        <tr>
                                            <td>@row.PostingDate.ToString("dd-MM-yyyy")</td>
                                            <td>
                                                <MudText Inline="true" Color="@(row.ValueChange < 0 ? Color.Error : Color.Success)">
                                                    @(row.ValueChange > 0 ? "+" : "")@row.ValueChange.ToString("0.00")
                                                </MudText>
                                            </td>
                                            <td>@(row.ContractorDetails ?? "-")</td>
                                            <td>@(row.Description ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }

                        @foreach (var error in _erorrs)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true">@error</MudAlert>
                        }
                    </MudStack>
                </MudStep>

                <MudStep Title="Review" SecondaryText="Resolve conflicts" @bind-Completed="_step3Complete"
                         Disabled="@(_step2Complete == false)">
                    <MudStack Spacing="3" Class="pa-4">

                        @if (ShowImportProgress && _activeJobStatus is not null)
                        {
                            <MudStack Spacing="2">
                                <MudProgressLinear Color="Color.Primary" Value="@ImportProgressValue" BufferValue="100"
                                                   Style="height: 6px;" Rounded="true" />
                                <MudStack Row="true" Spacing="4">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        Processed @_activeJobStatus.ProcessedEntries / @_activeJobStatus.TotalEntries
                                    </MudText>
                                    @if (_activeJobStatus.ConflictCount > 0)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @_activeJobStatus.ConflictCount conflicts
                                        </MudText>
                                    }
                                    @if (_activeJobStatus.Failed > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Error">
                                            @_activeJobStatus.Failed failed
                                        </MudText>
                                    }
                                </MudStack>
                            </MudStack>
                        }
                        else if (_isImportingData || (_activeImportJobId.HasValue && _activeJobStatus is null))
                        {
                            <MudSkeleton Height="40px" Animation="Animation.Wave" />
                        }

                        @foreach (var errorInfo in _erorrs)
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true">@errorInfo</MudAlert>
                        }

                        @foreach (var warningInfo in _warnings)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Dense="true">@warningInfo</MudAlert>
                        }

                        @if (!string.IsNullOrWhiteSpace(_jobError))
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Text" Dense="true">@_jobError</MudAlert>
                        }

                        @if (_activeImportJobId.HasValue && _liveConflicts.Any(x => !x.IsResolved && !x.Conflict.IsExactMatch))
                        {
                            <CurrencyEntryConflictResolver @ref="_resolverRef"
                                JobConflicts="@_liveConflicts.Where(x => !x.IsResolved && !x.Conflict.IsExactMatch).ToList()"
                                JobId="_activeImportJobId" AccountName="@AccountName"
                                OnConflictsResolved="OnConflictsResolved"
                                OnResolutionChanged="StateHasChanged" />
                        }
                        else if (_importResult is not null && _importResult.Conflicts.Any())
                        {
                            <CurrencyEntryConflictResolver @ref="_resolverRef"
                                Conflicts="_importResult.Conflicts" AccountName="@AccountName"
                                OnResolutionChanged="StateHasChanged" />
                        }
                        else if (ShowImportCompletedMessage)
                        {
                            <MudStack AlignItems="AlignItems.Center" Spacing="3" Class="py-8">
                                <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Large">
                                    <MudIcon Icon="@Icons.Material.Filled.Check" />
                                </MudAvatar>
                                <MudText Typo="Typo.h5">Import complete</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width:460px;text-align:center;">
                                    All entries have been added to <b>@AccountName</b> and any conflicts you flagged were resolved.
                                </MudText>
                                <MudStack Row="true" Spacing="2" Class="mt-2">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="Clear">
                                        Import another file
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               Href="@($"AccountDetails/{AccountId}")"
                                               EndIcon="@Icons.Material.Filled.ArrowForward">
                                        Return to @AccountName
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        }

                    </MudStack>
                </MudStep>
            </ChildContent>

            <ActionContent Context="stepper">
                @* Custom footer rendered below the stepper instead — keep this empty to suppress default buttons. *@
            </ActionContent>
        </MudStepper>

        <MudDivider />
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pa-4">
            <MudButton Variant="Variant.Text" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Close"
                       Disabled="@(_step3Complete)"
                       OnClick="@Clear">Clear</MudButton>

            <MudStack Row="true" Spacing="2">
                @if (ShowBackAction)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.ArrowBack"
                               OnClick="GoToPreviousStep">Back</MudButton>
                }
                @if (ShowPrimaryAction)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward"
                               Disabled="@(!CanContinue)"
                               OnClick="OnPrimaryClick">@PrimaryLabel</MudButton>
                }
            </MudStack>
        </MudStack>
    </MudPaper>
</MudContainer>
