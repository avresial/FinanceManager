@using FinanceManager.Domain.Entities.Shared.Accounts

<MudPaper Outlined="true" Class="d-flex flex-wrap align-center gap-2 pa-1 rounded-lg mb-4" Style="padding: 6px 8px;">
    @* Group 1: search + type filter — wrap together as a unit *@
    <div class="d-flex align-center gap-2" style="flex: 1 1 auto; min-width: 0;">
        <MudTextField T="string" Value="SearchText" ValueChanged="OnSearchChanged"
                      Placeholder="Search transactions, notes, labels…" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" DebounceInterval="150" Clearable="true"
                      Class="flex-grow-1" Style="min-width: 80px;" />

        <MudToggleGroup T="string" Value="@TypeValue" ValueChanged="OnTypeChanged"
                        SelectionMode="SelectionMode.SingleSelection"
                        Color="@(ActiveFilter switch { TxFilter.Income => Color.Success, TxFilter.Expense => Color.Error, _ => Color.Default })"
                        Outlined="true" Dense="true" CheckMark="false" Size="Size.Small" Style="flex: 0 0 auto;">
            <MudToggleItem Value="@("All")" Text="All" />
            <MudToggleItem Value="@("Income")">
                <MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Style="margin-right: 3px;" />Income
            </MudToggleItem>
            <MudToggleItem Value="@("Expense")">
                <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Style="margin-right: 3px;" />Expense
            </MudToggleItem>
        </MudToggleGroup>
    </div>

    @* Group 2: label filter + add-entry — wrap together as a unit *@
    <div class="d-flex align-center gap-2" style="flex: 0 0 auto;">
        @if (AvailableLabels is not null && AvailableLabels.Any())
        {
            <MudMenu @ref="_labelMenu" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined"
                               Color="@(SelectedLabels.Count > 0 ? Color.Primary : Color.Default)"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Label"
                               EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                               Style="text-transform: none; padding: 0 8px;">
                        @LabelButtonText
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <MudText Typo="Typo.overline" Class="px-4 pt-2 pb-1" Style="display:block">Filter by label</MudText>
                    @foreach (var label in AvailableLabels)
                    {
                        <MudMenuItem OnClick="@(() => ToggleLabel(label))" AutoClose="false">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudCheckBox Value="@SelectedLabels.Contains(label)" T="bool" Dense="true" ReadOnly="true" />
                                <MudText Typo="Typo.body2">@label</MudText>
                            </MudStack>
                        </MudMenuItem>
                    }
                    <MudDivider />
                    <div class="d-flex justify-space-between px-2 py-1">
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   Disabled="@(SelectedLabels.Count == 0)" OnClick="ClearLabels">Clear all</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="CloseLabelMenu">Done</MudButton>
                    </div>
                </ChildContent>
            </MudMenu>
        }

        <MudButtonGroup Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small">
            <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="OnAddEntry"
                       Style="padding: 0 10px;">Add entry</MudButton>
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                               Style="min-width: 24px; padding: 0 4px;">
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    @if (ShowInsightsButton)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Insights" OnClick="OnInsightsClick">Insights</MudMenuItem>
                        <MudDivider />
                    }
                    <MudMenuItem Icon="@Icons.Material.Filled.FileUpload" Href="@($"/Import/{AccountId}")">Import…</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.FileDownload" Href="@($"/Export/{AccountId}")">Export CSV</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Settings" Href="@($"/ManageAccount/{AccountId}")">Manage account</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </MudButtonGroup>
    </div>
</MudPaper>
