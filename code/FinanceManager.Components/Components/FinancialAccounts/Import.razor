@page "/Import/{AccountId:int}"
@inherits AccountTypePageBase

<PageTitle>Import transactions</PageTitle>

@if (IsLoading)
{
    <DisplaySpinner />
}
else
{
    <div class="container-fluid px-0" @ref="MyElementReference">
        @if (ErrorMessage != string.Empty)
        {
            <div class="alert alert-warning" role="alert">
                @ErrorMessage
            </div>
        }
        else if (AccountDescriptor?.Kind == FinancialAccountKind.Currency)
        {
            <ImportCurrencyEntriesComponent AccountId="@AccountId" />
        }
        else if (AccountDescriptor?.Kind == FinancialAccountKind.Stock)
        {
            <ImportStockEntriesComponent AccountId="@AccountId" />
        }
        else if (AccountDescriptor?.Kind == FinancialAccountKind.Bond)
        {
            <ImportBondEntriesComponent AccountId="@AccountId" />
        }
        else
        {
            <div class="alert alert-danger" role="alert">
                @AccountType type is not supported.
            </div>
        }
    </div>
}
