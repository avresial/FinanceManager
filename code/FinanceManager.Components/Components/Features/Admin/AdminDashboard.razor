@page "/Admin/Dashboard"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@using ApexCharts
@using FinanceManager.Domain.Shared.Charting
@using FinanceManager.Domain.Identity.Entities
@using Microsoft.AspNetCore.Authorization

<PageTitle>Admin dashboard</PageTitle>

<MudGrid Spacing="3">
    <MudItem xs="6" md="3">
        <MudCard Outlined>
            <MudCardContent>
                <MudPaper Class="d-flex justify-start gap-3 flex-grow-1 flex-column px-3 py-1" Elevation="0">
                    <MudText>Total users count</MudText>
                    <MudText Typo="Typo.h3" Color="MudBlazor.Color.Primary">
                        <b>
                            @if (_userCount.HasValue)
                            {
                                @_userCount
                            }
                            else
                            {
                                <StringSpinner CharactersCount="3" />
                            }
                        </b>
                    </MudText>
                    <MudStack Row>
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Title="TrendingUp" />
                        <MudText Typo="Typo.subtitle2">
                            <StringSpinner Characters="!#$^&*" />%
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="6" md="3">
        <MudCard Outlined>
            <MudCardContent>
                <MudPaper Class="d-flex justify-start gap-3 flex-grow-1 flex-column px-3 py-1" Elevation="0">
                    <MudText>Accounts count</MudText>
                    <MudText Typo="Typo.h3" Color="MudBlazor.Color.Primary">
                        <b>
                            @if (_accountsCount.HasValue)
                            {
                                @_accountsCount
                            }
                            else
                            {
                                <StringSpinner CharactersCount="3" />
                            }
                        </b>
                    </MudText>
                    <MudStack Row>
                        <MudIcon Icon="@Icons.Material.Filled.TrendingFlat" Title="TrendingFlat" />
                        <MudText Typo="Typo.subtitle2">
                            <StringSpinner Characters="!#$^&*" />%
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="6" md="3">
        <MudCard Outlined>
            <MudCardContent>
                <MudPaper Class="d-flex justify-start gap-3 flex-grow-1 flex-column px-3 py-1" Elevation="0">
                    <MudText>Total tracked money</MudText>
                    <MudText Typo="Typo.h3" Color="MudBlazor.Color.Primary">
                        <b>
                            @if (_totalTrackedMoney.HasValue)
                            {
                                @_totalTrackedMoney
                            }
                            else
                            {
                                <StringSpinner CharactersCount="3" />
                            }
                        </b>
                    </MudText>
                    <MudStack Row>
                        <MudIcon Icon="@Icons.Material.Filled.TrendingDown" Title="TrendingDown" />
                        <MudText Typo="Typo.subtitle2">
                            <StringSpinner Characters="!#$^&*" />%
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="6" md="3">
        <MudCard Outlined>
            <MudCardContent>
                <MudPaper Class="d-flex justify-start gap-3 flex-grow-1 flex-column px-3 py-1" Elevation="0">
                    <MudText>Todays new visitors</MudText>
                    <MudText Typo="Typo.h3" Color="MudBlazor.Color.Primary">
                        @if (_newVisitorsToday.HasValue)
                        {
                            @_newVisitorsToday
                        }
                        else
                        {
                            <StringSpinner CharactersCount="3" />
                        }
                    </MudText>
                    <MudStack Row>
                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Title="TrendingUp" />
                        <MudText Typo="Typo.subtitle2">
                            <StringSpinner Characters="!#$^&*" />%
                        </MudText>
                    </MudStack>
                </MudPaper>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Outlined>
            <MudCardContent>
                <MudText>Daily active users</MudText>
                @if (_dailyActiveUsers is not null)
                {
                    <ApexChart TItem="ChartEntryModel" Options="_chartOptions" Height="300">
                        <ApexPointSeries TItem="ChartEntryModel"
                                         Items="_dailyActiveUsers"
                                         Name="Users count"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(e => e.Date.ToString("dd MMM"))"
                                         YValue="@(e => (decimal)e.Value)" />
                    </ApexChart>
                }
                else
                {
                    <div style="height:300px">
                        <ChartSpinner MaxHeight="400px" />
                    </div>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Outlined>
            <MudCardContent>
                <MudText>New users</MudText>
                @if (_newUsers is not null)
                {
                    <ApexChart TItem="ChartEntryModel" Options="_chartOptions" Height="300">
                        <ApexPointSeries TItem="ChartEntryModel"
                                         Items="_newUsers"
                                         Name="Users count"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(e => e.Date.ToString("dd MMM"))"
                                         YValue="@(e => (decimal)e.Value)" />
                    </ApexChart>
                }
                else
                {
                    <div style="height:300px">
                        <ChartSpinner MaxHeight="400px" />
                    </div>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <LabelSetterProgressCard />
    </MudItem>

    <MudItem xs="12" md="6">
        <AdminLogsCard />
    </MudItem>
</MudGrid>