@page "/Admin/Stocks/BulkImport"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

<PageTitle>Bulk import stock prices - Admin</PageTitle>

<MudGrid Spacing="3">
    <MudItem xs="12">
        <MudText Typo="Typo.h4">Bulk import stock close prices</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
            Upload CSV with columns: TICKER, PER, DATE, TIME, OPEN, HIGH, LOW, CLOSE, VOL, OPENINT.
            Only existing tickers are imported.
        </MudText>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="0">
            <MudStack Spacing="2">
                <MudFileUpload T="IBrowserFile" Hidden="@false"
                               InputClass="absolute mud-width-full mud-height-full overflow-hidden z-10"        InputStyle="opacity:0"
                               ErrorText="@string.Empty" tabindex="-1"                          OnFilesChanged="UploadFile">
                    <CustomContent>
                        <MudPaper Height="90px" Outlined="true"
                                  Class="relative d-flex align-center justify-center pa-3">
                            <MudText Typo="Typo.body1">Select CSV file</MudText>
                        </MudPaper>
                    </CustomContent>
                </MudFileUpload>

                @if (!string.IsNullOrWhiteSpace(_selectedFileName))
                {
                    <MudChip T="string" Color="Color.Dark" Text="@_selectedFileName" />
                }

                <MudStack Row Spacing="1">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Disabled="@(_selectedFile is null || _isImporting)"         OnClick="BeginImport">
                        Import
                    </MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@_isImporting"
                               OnClick="ClearSelection">
                        Clear
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudStack Spacing="2">
            @foreach (var message in _errors)
            {
                <MudAlert Severity="Severity.Error">@message</MudAlert>
            }

            @if (_result is not null)
            {
                <MudAlert Severity="Severity.Success">Imported or updated @_result.ImportedOrUpdatedRows row(s).</MudAlert>
                <MudAlert Severity="Severity.Info">Total rows: @_result.TotalRows</MudAlert>
                <MudAlert Severity="Severity.Warning">Skipped unknown ticker rows: @_result.SkippedUnknownTickerRows
                </MudAlert>
                <MudAlert Severity="Severity.Warning">Invalid rows: @_result.InvalidRows</MudAlert>

                @if (_result.UnknownTickers.Count > 0)
                {
                    <MudAlert Severity="Severity.Info">
                        Unknown tickers: @string.Join(", ", _result.UnknownTickers)
                    </MudAlert>
                }
            }
        </MudStack>
    </MudItem>
</MudGrid>