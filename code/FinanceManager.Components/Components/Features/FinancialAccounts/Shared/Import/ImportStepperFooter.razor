<MudDivider />
<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pa-4">
    <MudButton Variant="Variant.Text" Color="Color.Default"
               StartIcon="@Icons.Material.Filled.Close"
               Disabled="DisableClear"
               OnClick="Clear">Clear</MudButton>

    <MudStack Row="true" Spacing="2">
        @if (ShowBackAction)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="Back">Back</MudButton>
        }
        @if (ShowPrimaryAction)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       EndIcon="@Icons.Material.Filled.ArrowForward"
                       Disabled="@(!CanContinue)"
                       OnClick="PrimaryClick">@PrimaryLabel</MudButton>
        }
    </MudStack>
</MudStack>
