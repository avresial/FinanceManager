@namespace FinanceManager.Components.Components.Features.FinancialAccounts.InvestmentAccountComponents

@* Stock-type accounts now cover both the legacy stock model (StockEntries) and the new investment
   model (InvestmentTransactions). Until the final cutover the two coexist, so dispatch on which data
   the account actually holds: investment transactions render the new view, everything else the legacy one. *@
@if (_isLoading)
{
    <AccountDetailsPageContentSkeleton />
}
else if (_hasInvestmentTransactions)
{
    <InvestmentAccountDetailsPageContent AccountId="@AccountId" />
}
else
{
    <StockAccountDetailsPageContent AccountId="@AccountId" />
}

@code {
    [Parameter] public required int AccountId { get; set; }

    [Inject] public required InvestmentTransactionHttpClient TransactionHttpClient { get; set; }

    private bool _isLoading = true;
    private bool _hasInvestmentTransactions;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        var transactions = await TransactionHttpClient.GetByAccountAsync(AccountId);
        _hasInvestmentTransactions = transactions.Count > 0;
        _isLoading = false;
    }
}
