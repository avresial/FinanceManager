<MudContainer MaxWidth="MaxWidth.Small" style="height:100vh;" Class="d-flex flex-column justify-center">
    <MudGrid Justify="Justify.Center">
        <MudItem sm="10" xs="12">
            <MudPaper Class="p-5">
                <MudText Typo="Typo.h4" Class="text-center mb-3 mt-3">Finance Manager</MudText>
                <MudText Typo="Typo.h2" Class="mb-4 fs-6 fw-normal text-center">Choose a new password</MudText>

                @if (_resetComplete)
                {
                    <MudAlert Severity="Severity.Success" Class="my-3" data-testid="reset-success">
                        Your password has been reset. You can now sign in with your new password.
                    </MudAlert>
                    <MudButton Href="login" Class="my-2" Variant="Variant.Filled" Color="Color.Primary"
                               FullWidth data-testid="reset-go-to-login">
                        <MudText Typo="Typo.h5">Go to sign in</MudText>
                    </MudButton>
                }
                else if (string.IsNullOrWhiteSpace(Token))
                {
                    <MudAlert Severity="Severity.Error" Class="my-3" data-testid="reset-missing-token">
                        This password reset link is invalid or incomplete. Please request a new one.
                    </MudAlert>
                    <MudLink Href="forgot-password" Class="mt-3">
                        <MudText Typo="Typo.subtitle1">Request a new link</MudText>
                    </MudLink>
                }
                else
                {
                    @if (_errors is not null)
                    {
                        @foreach (var error in _errors)
                        {
                            <MudAlert Severity="Severity.Error" Class="my-3">@error</MudAlert>
                        }
                    }

                    <MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors" @onkeydown="OnKeyDown">
                        <MudTextField @bind-Value="_newPassword" T="string" Label="New password" Variant="Variant.Outlined"
                                      Class="mt-5" Immediate Required InputType="InputType.Password" data-testid="reset-password" />
                        <MudTextField @bind-Value="_confirmPassword" T="string" Label="Confirm password" Variant="Variant.Outlined"
                                      Class="mb-5" Immediate Required InputType="InputType.Password"
                                      Validation="@(new Func<string, string?>(PasswordMatch))" data-testid="reset-confirm" />

                        <MudButton Class="my-2" Variant="Variant.Filled" Color="Color.Primary"
                                   @onclick="Reset" Disabled="@_isProcessing" FullWidth data-testid="reset-submit">
                            <MudText Typo="Typo.h5">Reset password</MudText>
                        </MudButton>
                        <MudLink Href="login" Class="mt-3">
                            <MudText Typo="Typo.subtitle1">Back to sign in</MudText>
                        </MudLink>
                    </MudForm>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
