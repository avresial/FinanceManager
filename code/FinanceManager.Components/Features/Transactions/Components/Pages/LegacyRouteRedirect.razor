@page "/AccountDetails/{LegacyId:int}"
@page "/ManageAccount/{LegacyId:int}"
@page "/Import/{LegacyId:int}"
@page "/Export/{LegacyId:int}"
@page "/AddAccount"
@* Accounts no longer exist. These routes only keep old bookmarks and links working by sending them to Transactions. *@

@code {
    // The router needs a matching property for the {LegacyId} route segment, but it is not used.
    [Parameter] public int LegacyId { get; set; }

    [Inject] public required NavigationManager Navigation { get; set; }

    protected override void OnInitialized()
    {
        // The router matches "/AddAccount/" too, so the trailing slash must not change the destination.
        var isAddAccount = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Equals("/AddAccount", StringComparison.OrdinalIgnoreCase);
        Navigation.NavigateTo(isAddAccount ? "Transactions?dialog=add-entry" : "Transactions", replace: true);
    }
}
