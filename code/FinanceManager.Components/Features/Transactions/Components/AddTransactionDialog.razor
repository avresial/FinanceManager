@using FinanceManager.Components.Features.FinancialAccounts.Components.BondAccountComponents.Crud
@using FinanceManager.Components.Features.FinancialAccounts.Components.CurrencyAccountComponents.Crud
@using FinanceManager.Components.Features.FinancialAccounts.Components.InvestmentAccountComponents
@using FinanceManager.Domain.Dashboard.Dtos

@* Add a cash, bond or investment transaction without picking an account: the existing entry forms in owner mode. *@
<MudOverlay Visible="@Visible" DarkBackground="true" ZIndex="1300">
    <MudPaper Class="pa-4 pa-sm-6 fm-entry-dialog" role="dialog" aria-modal="true" aria-label="Add transaction">
        <MudText Typo="Typo.h6" Class="mb-3">Add transaction</MudText>
        <div class="fm-view-toggle fm-view-toggle--block mb-4">
            <MudToggleGroup T="TransactionKind" Value="_kind" ValueChanged="OnKindChanged"
                            SelectionMode="SelectionMode.SingleSelection" Dense="true" Size="Size.Small" Color="Color.Default"
                            aria-label="Transaction kind" data-testid="add-transaction-kind">
                <MudToggleItem Value="TransactionKind.Cash" Text="Cash" />
                <MudToggleItem Value="TransactionKind.Bond" Text="Bond" />
                <MudToggleItem Value="TransactionKind.Investment" Text="Investment" />
            </MudToggleGroup>
        </div>
        @* The key discards a half-filled form when the kind changes. *@
        @switch (_kind)
        {
            case TransactionKind.Bond:
                <AddBondEntry @key="_kind" ActionCompleted="CloseAsync" />
                break;
            case TransactionKind.Investment:
                <InvestmentTransactionFormBody @key="_kind" OnSaved="OnInvestmentSavedAsync" OnCancel="CloseAsync" />
                break;
            default:
                <AddCurrencyEntry @key="_kind" ActionCompleted="CloseAsync" />
                break;
        }
    </MudPaper>
</MudOverlay>
