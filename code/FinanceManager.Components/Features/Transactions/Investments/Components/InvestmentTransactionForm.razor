@namespace FinanceManager.Components.Features.Transactions.Investments.Components

<MudOverlay Visible="@Visible" DarkBackground="true" ZIndex="1300">
    <MudPaper Class="pa-4 pa-sm-6 fm-entry-dialog" role="dialog" aria-modal="true" aria-label="@Title">
        <MudText Typo="Typo.h6" Class="mb-3">@Title</MudText>
        <InvestmentTransactionFormBody @key="Transaction?.Id" Transaction="Transaction"
                                       OnSaved="OnSaved" OnCancel="CloseAsync" />
    </MudPaper>
</MudOverlay>
