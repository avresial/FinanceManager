@page "/Admin/Dashboard"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout

@using ApexCharts
@using FinanceManager.Domain.Shared.Charting
@using FinanceManager.Domain.Identity.Entities
@using Microsoft.AspNetCore.Authorization

<PageTitle>Admin dashboard</PageTitle>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="3">
        <MudCard Outlined Class="h-100">
            <MudCardContent>
                <MudPaper Class="d-flex justify-start gap-3 flex-grow-1 flex-column px-3 py-1" Elevation="0">
                    <div class="fm-card-info-header">
                        <CardInfoTooltip Text="All registered user accounts on the platform."
                                         AriaLabel="About total users count card">
                            <MudText>Total users count</MudText>
                        </CardInfoTooltip>
                    </div>
                    <ComponentStateView ErrorMessage="@(_userCountLoadFailed && !_userCount.HasValue ? "Unable to load this metric. Reload the page to try again." : null)">
                        <MudText Typo="Typo.h3" Color="MudBlazor.Color.Primary" Style="font-size: clamp(1.25rem, 5.5vw, 3rem);">
                            <b>
                                @if (_userCount.HasValue)
                                {
                                    @_userCount
                                }
                                else
                                {
                                    <StringSpinner CharactersCount="3" />
                                }
                            </b>
                        </MudText>
                    </ComponentStateView>
                </MudPaper>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Outlined Class="h-100">
            <MudCardContent>
                <MudPaper Class="d-flex justify-start gap-3 flex-grow-1 flex-column px-3 py-1" Elevation="0">
                    <div class="fm-card-info-header">
                        <CardInfoTooltip Text="All financial accounts created across all users."
                                         AriaLabel="About accounts count card">
                            <MudText>Accounts count</MudText>
                        </CardInfoTooltip>
                    </div>
                    <ComponentStateView ErrorMessage="@(_accountsCountLoadFailed && !_accountsCount.HasValue ? "Unable to load this metric. Reload the page to try again." : null)">
                        <MudText Typo="Typo.h3" Color="MudBlazor.Color.Primary" Style="font-size: clamp(1.25rem, 5.5vw, 3rem);">
                            <b>
                                @if (_accountsCount.HasValue)
                                {
                                    @_accountsCount
                                }
                                else
                                {
                                    <StringSpinner CharactersCount="3" />
                                }
                            </b>
                        </MudText>
                    </ComponentStateView>
                </MudPaper>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Outlined Class="h-100">
            <MudCardContent>
                <MudPaper Class="d-flex justify-start gap-3 flex-grow-1 flex-column px-3 py-1" Elevation="0">
                    <div class="fm-card-info-header">
                        <CardInfoTooltip Text="Combined balance of all tracked accounts across all users, converted to PLN."
                                         AriaLabel="About total tracked money card">
                            <MudText>Total tracked money</MudText>
                        </CardInfoTooltip>
                    </div>
                    <ComponentStateView ErrorMessage="@(_totalTrackedMoneyLoadFailed && !_totalTrackedMoney.HasValue ? "Unable to load this metric. Reload the page to try again." : null)">
                        <MudText Typo="Typo.h3" Color="MudBlazor.Color.Primary" Style="font-size: clamp(1.25rem, 5.5vw, 3rem); overflow-wrap: anywhere;">
                            <b>
                                @if (_totalTrackedMoney.HasValue)
                                {
                                    @MoneyFormatter.Format(_totalTrackedMoney.Value, "PLN")
                                }
                                else
                                {
                                    <StringSpinner CharactersCount="3" />
                                }
                            </b>
                        </MudText>
                    </ComponentStateView>
                </MudPaper>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Outlined Class="h-100">
            <MudCardContent>
                <MudPaper Class="d-flex justify-start gap-3 flex-grow-1 flex-column px-3 py-1" Elevation="0">
                    <div class="fm-card-info-header">
                        <CardInfoTooltip Text="New users who signed up today."
                                         AriaLabel="About today's new visitors card">
                            <MudText>Today's new visitors</MudText>
                        </CardInfoTooltip>
                    </div>
                    <ComponentStateView ErrorMessage="@(_newVisitorsTodayLoadFailed && !_newVisitorsToday.HasValue ? "Unable to load this metric. Reload the page to try again." : null)">
                        <MudText Typo="Typo.h3" Color="MudBlazor.Color.Primary" Style="font-size: clamp(1.25rem, 5.5vw, 3rem);">
                            <b>
                                @if (_newVisitorsToday.HasValue)
                                {
                                    @_newVisitorsToday
                                }
                                else
                                {
                                    <StringSpinner CharactersCount="3" />
                                }
                            </b>
                        </MudText>
                    </ComponentStateView>
                </MudPaper>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Outlined>
            <MudCardContent>
                <div class="fm-card-info-header">
                    <CardInfoTooltip Text="Users who signed in, counted once per day."
                                     AriaLabel="About daily active users card">
                        <MudText>Daily active users</MudText>
                    </CardInfoTooltip>
                </div>
                @if (_dailyActiveUsers is not null)
                {
                    <ApexChart @key="_dailyActiveUsersChartVersion" TItem="ChartEntryModel" Options="_chartOptions" Height="300">
                        <ApexPointSeries TItem="ChartEntryModel"
                                         Items="_dailyActiveUsers"
                                         Name="Users count"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(e => DateFormatter.FormatDayMonth(e.Date))"
                                         YValue="@(e => (decimal)e.Value)" />
                    </ApexChart>
                }
                else if (_dailyActiveUsersLoadFailed)
                {
                    <MudAlert Severity="Severity.Error">Unable to load daily active users. Reload the page to try again.</MudAlert>
                }
                else
                {
                    <div style="height:300px">
                        <ChartSpinner MaxHeight="400px" />
                    </div>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudCard Outlined>
            <MudCardContent>
                <div class="fm-card-info-header">
                    <CardInfoTooltip Text="New user signups per day."
                                     AriaLabel="About new users card">
                        <MudText>New users</MudText>
                    </CardInfoTooltip>
                </div>
                @if (_newUsers is not null)
                {
                    <ApexChart @key="_newUsersChartVersion" TItem="ChartEntryModel" Options="_newUsersChartOptions" Height="300">
                        <ApexPointSeries TItem="ChartEntryModel"
                                         Items="_newUsers"
                                         Name="Users count"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(e => DateFormatter.FormatDayMonth(e.Date))"
                                         YValue="@(e => (decimal)e.Value)" />
                    </ApexChart>
                }
                else if (_newUsersLoadFailed)
                {
                    <MudAlert Severity="Severity.Error">Unable to load new users. Reload the page to try again.</MudAlert>
                }
                else
                {
                    <div style="height:300px">
                        <ChartSpinner MaxHeight="400px" />
                    </div>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        <LabelSetterProgressCard />
    </MudItem>

    <MudItem xs="12" md="6">
        <AdminLogsCard />
    </MudItem>
</MudGrid>
