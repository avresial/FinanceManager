@page "/Admin/EditLabel/{LabelId:int}"
@attribute [Authorize(Roles = "Admin")]
@layout AdminLayout
@using FinanceManager.Domain.FinancialAccounts.Shared.Entities

<PageTitle>Edit label - Admin</PageTitle>

@if (_isLoadingPage)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate aria-label="Loading label" />
    <MudText role="status">Loading label…</MudText>
}
else if (_labelData is not null)
{ 
    <MudGrid Spacing="6">
        <MudItem xs="12">
            <MudText Typo="Typo.h4">@_labelData.Name</MudText>
        </MudItem>


        <MudItem xs="12">
            <MudText Typo="Typo.h6">Change name</MudText>
            <MudGrid>
                <MudItem xs="12" sm="8">
                    <MudForm @ref="_nameForm" @bind-IsValid="@_success" Spacing="3">

                        <MudTextField T="string" Label="Name" HelperText="Choose a name" @bind-value="NameField"
                                      InputType="InputType.Text" Validation="@(new Func<string, IEnumerable<string>>(ValidateName))" Required
                                      RequiredError="Name is required!" />


                        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-4 align-self-start" OnClick="UpdateNameAsync" Disabled="@(!_success || _isUpdatingName)">@(_isUpdatingName ? "Updating…" : "Update name")</MudButton>
                    </MudForm>
                </MudItem>
            </MudGrid>
            @* <MudDivider Class="my-3" /> *@
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.h6">Spending classification</MudText>
            <MudGrid>
                <MudItem xs="12" sm="8">
                    <MudSelect T="string" Label="Classification" @bind-Value="_selectedClassification"
                               HelperText="Categorise this label for the expense distribution chart">
                        <MudSelectItem Value="@FinancialLabelClassificationCatalog.EssentialValue">Essential</MudSelectItem>
                        <MudSelectItem Value="@FinancialLabelClassificationCatalog.WantValue">Want</MudSelectItem>
                        <MudSelectItem Value="@FinancialLabelClassificationCatalog.InvestmentValue">Investment</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-4"
                               OnClick="SetClassificationAsync"
                               Disabled="@(string.IsNullOrEmpty(_selectedClassification))">Set classification</MudButton>
                </MudItem>
            </MudGrid>
        </MudItem>

        <MudItem xs="12">
            <MudStack Spacing="2">

                @foreach (var message in _errors)
                {
                    <MudAlert Severity="Severity.Error">@message</MudAlert>
                }

                @foreach (var message in _warnings)
                {
                    <MudAlert Severity="Severity.Warning">@message</MudAlert>
                }

                @foreach (var message in _info)
                {
                    <MudAlert Severity="Severity.Info">@message</MudAlert>
                }
            </MudStack>
        </MudItem>
    </MudGrid>
}
else
{
    @foreach (var message in _errors)
    {
        <MudAlert Severity="Severity.Error">@message</MudAlert>
    }
    @if (_errors.Count == 0)
    {
        <MudAlert Severity="Severity.Error">Label with id @LabelId could not be found.</MudAlert>
    }
}
