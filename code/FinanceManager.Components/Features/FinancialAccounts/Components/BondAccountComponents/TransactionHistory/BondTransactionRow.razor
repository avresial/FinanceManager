<div class="d-flex align-start pa-2 mud-list-item-clickable" style="cursor: pointer;"
     role="button" tabindex="0" @onclick="ToggleExpanded" @onkeydown="OnKeyDown">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Start" Class="w-100">
        @if (!IsMobile)
        {
            <MudAvatar Size="Size.Medium" Variant="Variant.Filled" Color="Color.Default">
                @GetAvatarLabel()
            </MudAvatar>
        }

        <MudStack Spacing="0" Class="flex-grow-1" Style="min-width: 0;">
            <MudText Typo="Typo.body1" Class="text-truncate">@GetTitle()</MudText>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Style="min-width: 0;">
                @if (Entry.Labels is not null && Entry.Labels.Any())
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Style="height: 20px; font-size: 11px;">@Entry.Labels.First().Name</MudChip>
                }
                @if (BondDetails is not null && !string.IsNullOrWhiteSpace(BondDetails.Issuer))
                {
                    <MudText Typo="Typo.caption" Color="Color.Default" Class="text-truncate" Style="min-width: 0;">@BondDetails.Issuer</MudText>
                }
                @if (!IsMobile)
                {
                    <MudText Typo="Typo.caption" Color="Color.Default">· @Entry.PostingDate.ToLocalTime().ToString("HH:mm")</MudText>
                }
            </MudStack>
        </MudStack>

        @if (IsMobile)
        {
            <MudStack Spacing="0" AlignItems="AlignItems.End" Style="flex-shrink: 0;">
                <MudText Typo="Typo.body1" Class="fm-tabular" Style="white-space: nowrap;"
                         Color="@(Entry.ValueChange >= 0 ? Color.Success : Color.Error)">
                    @(Entry.ValueChange >= 0 ? "+" : "")@FormatUnits(Entry.ValueChange) units
                </MudText>
                <MudText Typo="Typo.caption" Class="fm-tabular" Style="white-space: nowrap;">Position: @FormatUnits(Entry.Value) units</MudText>
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.body1" Class="fm-tabular" Style="flex-shrink: 0; white-space: nowrap;"
                     Color="@(Entry.ValueChange >= 0 ? Color.Success : Color.Error)">
                @(Entry.ValueChange >= 0 ? "+" : "")@FormatUnits(Entry.ValueChange) units
            </MudText>

            <MudStack Spacing="0" AlignItems="AlignItems.End" Style="min-width: 110px; flex-shrink: 0;">
                <MudText Typo="Typo.overline" Color="Color.Default">Position</MudText>
                <MudText Typo="Typo.caption" Class="fm-tabular" Style="white-space: nowrap;">@FormatUnits(Entry.Value) units</MudText>
            </MudStack>
        }
    </MudStack>
</div>

<MudCollapse Expanded="_expanded">
    <div class="px-4 pb-3" style="padding-left: 60px;">
        <MudGrid Spacing="2">
            <MudItem xs="6">
                <MudText Typo="Typo.caption" Color="Color.Default">Posting date</MudText>
                <MudText Typo="Typo.body2">@DateFormatter.FormatDateTime(Entry.PostingDate.ToLocalTime())</MudText>
            </MudItem>
            <MudItem xs="6">
                <MudText Typo="Typo.caption" Color="Color.Default">Units</MudText>
                <MudStack Row Spacing="1" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Class="fm-tabular">@FormatUnits(Entry.Value)</MudText>
                    <MudText Typo="Typo.caption" Class="fm-tabular"
                             Color="@(Entry.ValueChange >= 0 ? Color.Success : Color.Error)">
                        (@(Entry.ValueChange >= 0 ? "+" : "")@FormatUnits(Entry.ValueChange))
                    </MudText>
                </MudStack>
            </MudItem>
            @if (BondDetails is not null)
            {
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Issuer</MudText>
                    <MudText Typo="Typo.body2">@BondDetails.Issuer</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Unit value</MudText>
                    <MudText Typo="Typo.body2">@MoneyFormatter.Format(BondDetails.UnitValue, BondDetails.Currency.ShortName)</MudText>
                </MudItem>
            }
            @if (_showValuation)
            {
                <MudItem xs="12">
                    <MudDivider Class="my-1" Style="border-style: dashed;" />
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Unit price at transaction</MudText>
                    <MudText Typo="Typo.body2" Class="fm-tabular">@MoneyFormatter.Format(_unitPriceAtPosting, _valuationCurrency)</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Unit price now</MudText>
                    <MudText Typo="Typo.body2" Class="fm-tabular">@MoneyFormatter.Format(_unitPriceNow, _valuationCurrency)</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Value at transaction</MudText>
                    <MudText Typo="Typo.body2" Class="fm-tabular">@MoneyFormatter.Format(_valueAtPosting, _valuationCurrency)</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Value now</MudText>
                    <MudText Typo="Typo.body2" Class="fm-tabular">@MoneyFormatter.Format(_valueNow, _valuationCurrency)</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Default">Gain / loss</MudText>
                    <MudText Typo="Typo.body2" Class="fm-tabular"
                             Color="@(_gainLoss >= 0 ? Color.Success : Color.Error)">
                        @MoneyFormatter.FormatSigned(_gainLoss, _valuationCurrency)
                        (@(_gainLoss >= 0 ? "+" : "")@_gainLossPercent.ToString("N2")%)
                    </MudText>
                </MudItem>
            }
            @if (Entry.Labels is not null && Entry.Labels.Any())
            {
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="Color.Default">Labels</MudText>
                    <MudStack Row Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var label in Entry.Labels)
                        {
                            <MudChip T="string" Size="Size.Small" Style="max-width: 100%; height: auto;">
                                <span style="white-space: normal; overflow-wrap: anywhere; min-width: 0;">@label.Name</span>
                            </MudChip>
                        }
                    </MudStack>
                </MudItem>
            }
            <MudItem xs="12">
                <MudButton Variant="Variant.Text" OnClick="ShowEditOverlay">Edit</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ShowRemoveOverlay">Remove</MudButton>
            </MudItem>
        </MudGrid>
    </div>
</MudCollapse>

<MudOverlay @bind-Visible="_updateEntryVisibility" DarkBackground="true" ZIndex="1150">
    <MudPaper Class="pa-4 pa-sm-6" Style="width: min(720px, 92vw); max-height: 90vh; overflow-y: auto;">
        <UpdateBondEntry BondAccount="Account" BondAccountEntry="Entry" ActionCompleted="HideOverlay" />
    </MudPaper>
</MudOverlay>

<MudOverlay @bind-Visible="_removeEntryVisibility" DarkBackground="true" ZIndex="1150">
    <MudPaper Class="pa-4 pa-sm-6" Style="width: min(720px, 92vw); max-height: 90vh; overflow-y: auto;">
        <RemoveBondEntry BondAccountName="@Account.Name" BondAccountEntry="Entry"
                         Cancel="HideOverlay" Confirm="ConfirmRemove" />
    </MudPaper>
</MudOverlay>

