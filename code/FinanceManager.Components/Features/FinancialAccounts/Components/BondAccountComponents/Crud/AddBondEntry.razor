@using FinanceManager.Domain.Identity.Entities
@using FinanceManager.Components.Shared.CustomValidationAttributes
@using FinanceManager.Domain.FinancialAccounts.Shared.Repositories
@using FinanceManager.Domain.FinancialAccounts.Bond.Entities

<MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="px-0">

        <MudGrid Justify="Justify.FlexStart" Spacing="3">
            <MudItem xs="12" sm="12" md="12">
                <MudText Typo="Typo.h6">Add new entry</MudText>
                <MudText Typo="Typo.subtitle1">@BondAccount.Name</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Variant="Variant.Outlined" Label="Posting date" @bind-Date="_postingDate" DateFormat="@DateFormatter.PickerFormat" Culture="@DateFormatter.Culture"
                               Validation="@(new NotInFutureAttribute())" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTimePicker Variant="Variant.Outlined" Label="Time" @bind-Time="_time"
                               Validation="@(new NotInFutureAttributeTime(_postingDate))" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField Required="true" HideSpinButtons="true" @bind-Value="ValueChange" Label="Units change"
                                 Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect Variant="Variant.Outlined" T="BondDetails" Label="Bond" @bind-Value="_selectedBond" ToStringFunc="@(b => b?.Name)">
                    @foreach (var bond in _possibleBonds)
                    {
                        <MudSelectItem T="BondDetails" Value="@bond">@bond.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (_selectedBond is not null)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Unit value: @_selectedBond.UnitValue
                        @_selectedBond.Currency.ShortName</MudText>
                    </MudItem>
                }
                <MudItem xs="12" sm="6">
                    <MudSelect Variant="Variant.Outlined" T="string" Label="Label" MultiSelection="true" @bind-Value="_labelValue"
                               @bind-SelectedValues="_selectedLabels">
                        @foreach (var state in _possibleLabels.Select(x => x.Name))
                        {
                            <MudSelectItem T="string" Value="@state">@state</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <FormActions>
                        @if (CustomButton is not null)
                        {
                            @CustomButton
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Default" DropShadow="false" OnClick=Cancel>Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" OnClick=Add Disabled="@_isAdding">
                            @if (_isAdding)
                            {
                                <MudProgressCircular Class="mr-2" Color="Color.Inherit" Size="Size.Small" Indeterminate="true" />
                            }
                            Add
                        </MudButton>
                    </FormActions>
                </MudItem>

                @if (_errors.Any())
                {
                    <MudItem xs="12">
                        @foreach (var error in _errors)
                        {
                            <MudAlert Severity="Severity.Error">@error</MudAlert>
                        }
                    </MudItem>
                }
            </MudGrid>
        </MudContainer>
    </MudForm>
