@using FinanceManager.Components.Shared.Helpers
<div class="@(IsMobile ? "py-2 px-4" : "pa-2") mud-list-item-clickable"
     style="@(_expanded ? "background: rgba(255,171,0,0.06);" : "")"
     role="button" tabindex="0" @onclick="ToggleExpanded" @onkeydown="OnKeyDown">
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="w-100">
        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown"
                 Style="@($"transition: transform 220ms; transform: rotate({(_expanded ? 180 : 0)}deg); flex-shrink: 0; color: {(_expanded ? "var(--mud-palette-primary)" : "var(--mud-palette-text-secondary)")}")"
                 Size="Size.Small" />

        @if (!IsMobile)
        {
            <MudAvatar Size="Size.Small" Variant="Variant.Filled" Color="Color.Default" Style="flex-shrink: 0;">
                <MudIcon Icon="@GetAvatarIcon()" Size="Size.Small" />
            </MudAvatar>
        }

        <MudStack Spacing="0" Class="flex-grow-1" Style="min-width: 0;">
            <MudText Typo="Typo.body1" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@GetTitle()</MudText>
            @if (HasMeta)
            {
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    @if (Entry.Labels is not null && Entry.Labels.Any())
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                 Style="height: 18px; font-size: 11px; margin: 0;">@Entry.Labels.First().Name</MudChip>
                    }
                    @if (ShowTimeLabel)
                    {
                        @if (Entry.Labels is not null && Entry.Labels.Any())
                        {
                            <MudText Typo="Typo.caption" Color="Color.Default">·</MudText>
                        }
                        <MudText Typo="Typo.caption" Color="Color.Default">@Entry.PostingDate.ToLocalTime().ToString("HH:mm")</MudText>
                    }
                </MudStack>
            }
        </MudStack>

        @if (IsMobile)
        {
            @* Side by side, amount and balance left the title a few characters on a phone; stack them. *@
            <MudStack Spacing="0" AlignItems="AlignItems.End" Style="flex-shrink: 0;">
                <MudText Typo="Typo.body1" Class="fm-tabular"
                         Color="@AmountSign.ColorFor(Entry.ValueChange)"
                         Style="white-space: nowrap;">
                    @MoneyFormatter.FormatSigned(Entry.ValueChange, Currency)
                </MudText>
                <MudText Typo="Typo.caption" Class="fm-tabular" Style="white-space: nowrap; color: var(--mud-palette-text-secondary);">@MoneyFormatter.Format(Entry.Value, Currency)</MudText>
            </MudStack>
        }
        else
        {
            <MudText Typo="Typo.body1" Class="fm-tabular"
                     Color="@AmountSign.ColorFor(Entry.ValueChange)"
                     Style="flex-shrink: 0; white-space: nowrap;">
                @MoneyFormatter.FormatSigned(Entry.ValueChange, Currency)
            </MudText>

            <MudStack Spacing="0" AlignItems="AlignItems.End" Style="min-width: 110px; flex-shrink: 0;">
                <MudText Typo="Typo.caption" Class="fm-tabular" Style="white-space: nowrap;">@MoneyFormatter.Format(Entry.Value, Currency)</MudText>
            </MudStack>
        }
    </MudStack>
</div>

<MudCollapse Expanded="_expanded">
    <div class="px-4 pb-3" style="@(IsMobile ? "" : "padding-left: 60px;")" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
        <MudDivider Class="mb-3" Style="border-style: dashed;" />
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Posting date</MudText>
                <MudText Typo="Typo.body2" Class="fm-tabular">@DateFormatter.FormatDateTime(Entry.PostingDate.ToLocalTime())</MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Running balance</MudText>
                <MudText Typo="Typo.body2" Class="fm-tabular">@MoneyFormatter.Format(Entry.Value, Currency)</MudText>
            </MudItem>
            @if (!string.IsNullOrWhiteSpace(Entry.Description))
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.overline" Color="Color.Default">Description</MudText>
                    <MudText Typo="Typo.body2">@Entry.Description</MudText>
                </MudItem>
            }
            @if (!string.IsNullOrWhiteSpace(Entry.ContractorDetails))
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.overline" Color="Color.Default">Contractor details</MudText>
                    <MudText Typo="Typo.body2">@Entry.ContractorDetails</MudText>
                </MudItem>
            }
            @if (Entry.Labels is not null && Entry.Labels.Count > 1)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.overline" Color="Color.Default">Labels</MudText>
                    <MudStack Row="true" Spacing="1" Class="mt-1" Wrap="Wrap.Wrap">
                        @foreach (var label in Entry.Labels)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@label.Name</MudChip>
                        }
                    </MudStack>
                </MudItem>
            }
            <MudItem xs="12">
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Edit" OnClick="ShowEditOverlay">Edit</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Delete" OnClick="ShowRemoveOverlay">Delete</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </div>
</MudCollapse>

<MudOverlay @bind-Visible="_updateEntryVisibility" DarkBackground="true">
    <MudPaper Class="p-5">
        <UpdateCurrencyEntry CurrencyAccount="Account" CurrencyAccountEntry="Entry"
                             ActionCompleted="HideOverlay" />
    </MudPaper>
</MudOverlay>

<MudOverlay @bind-Visible="_removeEntryVisibility" DarkBackground="true">
    <MudPaper Class="p-5">
        <RemoveCurrencyEntry CurrencyAccountName="@Account.Name" CurrencyAccountEntry="Entry"
                             Cancel="HideOverlay" Confirm="ConfirmRemove" />
    </MudPaper>
</MudOverlay>

