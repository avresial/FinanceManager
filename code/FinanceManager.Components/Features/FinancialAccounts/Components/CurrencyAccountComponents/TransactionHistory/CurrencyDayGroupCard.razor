@using FinanceManager.Components.Shared.Helpers
@using FinanceManager.Domain.FinancialAccounts.Currencies.Entities

<MudCard Outlined="true" Class="mb-3" Style="background-color: transparent;">
    <MudCardHeader Class="@(IsMobile ? "py-1 px-4" : "py-1 pl-4 pr-2")">
        <CardHeaderContent>
            @* Same columns as TransactionRow: the description grows, the day net sits over the amounts and Balance over
               the 110px balance column, so the header's figures share the rows' right edges. *@
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Baseline" Class="w-100">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Baseline" Class="flex-grow-1" Style="min-width: 0;">
                    <MudText Typo="Typo.subtitle2">@DateFormatter.FormatDayMonth(Day)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">@DateFormatter.FormatWeekday(Day)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">· @_renderedEntries.Length @(_renderedEntries.Length == 1 ? "entry" : "entries")</MudText>
                </MudStack>
                <MudText Typo="Typo.caption" Class="fm-tabular" Style="white-space: nowrap;"
                         Color="@AmountSign.ColorFor(DailyNet)">
                    @MoneyFormatter.FormatSigned(DailyNet, Currency)
                </MudText>
                @if (!IsMobile)
                {
                    <MudText Typo="Typo.overline" Color="Color.Default" Style="min-width: 110px; text-align: right;">Balance</MudText>
                }
            </MudStack>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="pa-0">
        <MudStack Spacing="0">
            @{
                // Evaluated once per render: the check scans every entry of the day.
                var siblingsShareSameTime = TransactionRowPresentation.AllShareSameTime(_renderedEntries.Select(e => e.PostingDate.ToLocalTime()));
            }
            @foreach (var entry in _renderedEntries)
            {
                <TransactionRow @key="entry.EntryId" Account="Account" Entry="entry" Currency="@Currency" IsMobile="@IsMobile"
                                InitiallyExpanded="@(HighlightedEntryId == entry.EntryId)"
                                SiblingsShareSameTime="@siblingsShareSameTime" />
                <MudDivider />
            }
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public DateTime Day { get; set; }
    [Parameter] public required CurrencyAccount Account { get; set; }
    [Parameter] public required IEnumerable<CurrencyAccountEntry> Entries { get; set; }
    [Parameter] public required string Currency { get; set; }
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public int? HighlightedEntryId { get; set; }

    private decimal DailyNet => _renderedEntries.Sum(e => e.ValueChange);

    // The page regroups its entries on every render (e.g. when the chart data arrives), which handed each day
    // card new parameters and re-rendered all ~100 rows. Skip the render when the same entry objects come back.
    private CurrencyAccountEntry[] _renderedEntries = [];
    private (DateTime Day, CurrencyAccount Account, string Currency, bool IsMobile, int? HighlightedEntryId) _renderedParameters;
    private bool _parametersChanged = true;

    protected override void OnParametersSet()
    {
        var entries = Entries as CurrencyAccountEntry[] ?? Entries.ToArray();
        var parameters = (Day, Account, Currency, IsMobile, HighlightedEntryId);
        _parametersChanged = parameters != _renderedParameters || entries.Length != _renderedEntries.Length
            || !entries.Zip(_renderedEntries).All(pair => ReferenceEquals(pair.First, pair.Second));
        _renderedEntries = entries;
        _renderedParameters = parameters;
    }

    protected override bool ShouldRender() => _parametersChanged;
}
