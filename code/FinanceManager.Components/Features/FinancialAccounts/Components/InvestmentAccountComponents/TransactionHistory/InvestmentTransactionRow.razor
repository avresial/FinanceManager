@namespace FinanceManager.Components.Features.FinancialAccounts.Components.InvestmentAccountComponents.TransactionHistory

<div class="pa-2 mud-list-item-clickable"
     style="@(_expanded ? "background: rgba(255,171,0,0.06);" : "")"
     role="button" tabindex="0" @onclick="ToggleExpanded" @onkeydown="OnKeyDown">
    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="w-100">
        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown"
                 Style="@($"transition: transform 220ms; transform: rotate({(_expanded ? 180 : 0)}deg); flex-shrink: 0; color: {(_expanded ? "var(--mud-palette-primary)" : "var(--mud-palette-text-secondary)")}")"
                 Size="Size.Small" />

        <MudChip T="string" Size="Size.Small" Color="@TypeColor" Variant="Variant.Filled" Style="flex-shrink: 0;">@TypeLabel</MudChip>

        <MudStack Spacing="0" Class="flex-grow-1" Style="min-width: 0;">
            <MudText Typo="Typo.body1" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@Transaction.Ticker</MudText>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.caption" Color="Color.Default" Class="fm-tabular">@Transaction.Quantity.ToString("N4") @@ @Transaction.UnitPrice.ToString("N2") @Transaction.Currency</MudText>
                @if (Transaction.UnitPrice <= 0m)
                {
                    <MudTooltip Text="Price cannot be obtained">
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" aria-label="Price cannot be obtained" />
                    </MudTooltip>
                }
                @if (!IsMobile && !string.IsNullOrWhiteSpace(Transaction.ExchangeName))
                {
                    <MudText Typo="Typo.caption" Color="Color.Default">·</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">@Transaction.ExchangeName</MudText>
                }
            </MudStack>
        </MudStack>

        <MudStack Spacing="0" AlignItems="AlignItems.End" Style="flex-shrink: 0;">
            <MudText Typo="Typo.body1" Class="fm-tabular"
                     Color="@(PrimaryAmount >= 0 ? Color.Success : Color.Error)">
                @(PrimaryAmount >= 0 ? "+" : "")@PrimaryAmount.ToString("N2") @PrimaryCurrency
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Default">
                @(ShowGainLoss
                    ? $"Gain / loss · {(Valuation!.GainLoss >= 0 ? "+" : "")}{Valuation.GainLossPercent.ToString("N2")}%"
                    : "Cash impact")
            </MudText>
        </MudStack>
    </MudStack>
</div>

<MudCollapse Expanded="_expanded">
    <div class="@(IsMobile ? "px-3 pb-3" : "px-4 pb-3")" style="@(IsMobile ? "" : "padding-left: 60px;")" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
        <MudDivider Class="mb-2" Style="border-style: dashed;" />
        <MudGrid Spacing="2">
            <MudItem xs="6" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Trade date</MudText>
                <MudText Typo="Typo.body2" Class="fm-tabular">@Transaction.TradeDate.ToString("dd-MM-yyyy")</MudText>
            </MudItem>
            <MudItem xs="6" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Type</MudText>
                <MudText Typo="Typo.body2">@TypeLabel</MudText>
            </MudItem>
            <MudItem xs="6" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Ticker</MudText>
                <MudText Typo="Typo.body2">@Transaction.Ticker</MudText>
            </MudItem>
            <MudItem xs="6" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Exchange</MudText>
                <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(Transaction.ExchangeName) ? "—" : Transaction.ExchangeName)</MudText>
            </MudItem>
            <MudItem xs="6" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Quantity</MudText>
                <MudText Typo="Typo.body2" Class="fm-tabular">@Transaction.Quantity.ToString("N4")</MudText>
            </MudItem>
            <MudItem xs="6" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Unit price</MudText>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.body2" Class="fm-tabular">@Transaction.UnitPrice.ToString("N2") @Transaction.Currency</MudText>
                    @if (Transaction.UnitPrice <= 0m)
                    {
                        <MudTooltip Text="Price cannot be obtained">
                            <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Warning" Size="Size.Small" aria-label="Price cannot be obtained" />
                        </MudTooltip>
                    }
                </MudStack>
            </MudItem>
            <MudItem xs="6" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Gross value</MudText>
                <MudText Typo="Typo.body2" Class="fm-tabular">@GrossValue.ToString("N2") @Transaction.Currency</MudText>
            </MudItem>
            <MudItem xs="6" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Fee</MudText>
                <MudText Typo="Typo.body2" Class="fm-tabular">@((Transaction.Fee ?? 0m).ToString("N2")) @Transaction.Currency</MudText>
            </MudItem>
            <MudItem xs="6" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Cash impact</MudText>
                <MudText Typo="Typo.body2" Class="fm-tabular"
                         Color="@(CashImpact >= 0 ? Color.Success : Color.Error)">
                    @(CashImpact >= 0 ? "+" : "")@CashImpact.ToString("N2") @Transaction.Currency
                </MudText>
            </MudItem>
            <MudItem xs="6" sm="6">
                <MudText Typo="Typo.overline" Color="Color.Default">Currency</MudText>
                <MudText Typo="Typo.body2">@Transaction.Currency</MudText>
            </MudItem>
            @if (ShowValuation)
            {
                <MudItem xs="12">
                    <MudDivider Class="my-1" Style="border-style: dashed;" />
                </MudItem>
                <MudItem xs="6" sm="6">
                    <MudText Typo="Typo.overline" Color="Color.Default">Unit price at purchase</MudText>
                    <MudText Typo="Typo.body2" Class="fm-tabular">@Valuation!.PurchaseUnitPrice.ToString("N2") @Valuation.Currency</MudText>
                </MudItem>
                <MudItem xs="6" sm="6">
                    <MudText Typo="Typo.overline" Color="Color.Default">Unit price now</MudText>
                    <MudText Typo="Typo.body2" Class="fm-tabular">
                        @(Valuation!.HasCurrentPrice ? $"{Valuation.CurrentPrice:N2} {Valuation.Currency}" : "—")
                    </MudText>
                </MudItem>
                <MudItem xs="6" sm="6">
                    <MudText Typo="Typo.overline" Color="Color.Default">Value at purchase</MudText>
                    <MudText Typo="Typo.body2" Class="fm-tabular">@Valuation!.PurchaseValue.ToString("N2") @Valuation.Currency</MudText>
                </MudItem>
                <MudItem xs="6" sm="6">
                    <MudText Typo="Typo.overline" Color="Color.Default">Value now</MudText>
                    <MudText Typo="Typo.body2" Class="fm-tabular">
                        @(Valuation!.HasCurrentPrice ? $"{Valuation.CurrentValuation:N2} {Valuation.Currency}" : "—")
                    </MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.overline" Color="Color.Default">Gain / loss</MudText>
                    @if (Valuation!.HasCurrentPrice)
                    {
                        <MudText Typo="Typo.body2" Class="fm-tabular"
                                 Color="@(Valuation.GainLoss >= 0 ? Color.Success : Color.Error)">
                            @(Valuation.GainLoss >= 0 ? "+" : "")@Valuation.GainLoss.ToString("N2") @Valuation.Currency
                            (@(Valuation.GainLoss >= 0 ? "+" : "")@Valuation.GainLossPercent.ToString("N2")%)
                        </MudText>
                    }
                    else
                    {
                        <MudTooltip Text="No current market price is available for this instrument.">
                            <MudText Typo="Typo.body2" Color="Color.Default">Price unavailable</MudText>
                        </MudTooltip>
                    }
                </MudItem>
                @if (!Valuation!.IsConverted)
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Color="Color.Default">
                            Shown in @Valuation.Currency — no conversion to your default currency was available.
                        </MudText>
                    </MudItem>
                }
            }
            @if (!string.IsNullOrWhiteSpace(Transaction.Notes))
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.overline" Color="Color.Default">Notes</MudText>
                    <MudText Typo="Typo.body2">@Transaction.Notes</MudText>
                </MudItem>
            }
            <MudItem xs="12">
                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Edit" OnClick="OnEditClicked">Edit</MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Delete" OnClick="OnDeleteClicked">Delete</MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </div>
</MudCollapse>
