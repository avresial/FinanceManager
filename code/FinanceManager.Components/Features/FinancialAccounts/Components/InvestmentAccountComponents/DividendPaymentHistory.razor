@using FinanceManager.Components.Shared.Helpers

@* The sizing hooks live on a plain wrapper: scoped CSS is stamped on markup elements, not on a child component's root. *@
<div class="@(Height is null ? "fm-dividend-sizer" : "fm-dividend-sizer fm-dividend-sizer--sized")" style="@(Height is null ? null : $"--fm-card-height:{Height}")">
<MudCard Outlined="true" Class="fm-dividend-card rounded-lg d-flex flex-column">
    <section aria-label="Dividend income" class="d-flex flex-column overflow-hidden" inert="@(_editVisible || _confirmingDelete)">
        <CardHeader Title="Dividend income" Subtitle="@Subtitle" InfoText="Recorded payouts do not change balances or investment returns.">
            <Actions>
                <MudButton @ref="_recordButton" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                           Disabled="@(Busy || _error is not null)" OnClick="ShowRecord" aria-label="Record dividend">Record</MudButton>
            </Actions>
        </CardHeader>
        <div class="fm-dividend-content overflow-y-auto px-4 pb-3">
            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate Color="Color.Primary" aria-label="Loading dividend payments" />
                <MudText Typo="Typo.body2" role="status">Loading dividend payments…</MudText>
            }
            else
            {
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="my-3">@_error <MudButton OnClick="ReloadHistoryAsync">Retry</MudButton></MudAlert>
                }
                @if (_payments.Count == 0 && _error is null)
                {
                    <MudAlert Severity="Severity.Info">No dividend payments yet.</MudAlert>
                }
                else if (_payments.Count > 0)
                {
                    <ul class="dividend-list" aria-label="Dividend payment history">
                        @foreach (var payment in _payments)
                        {
                            <li @key="payment.Id">
                                <div class="dividend-holding">
                                    <strong>@payment.Ticker</strong>
                                    <span class="mud-typography-caption mud-text-secondary">@DateFormatter.Format(payment.PaymentDate) · @payment.HoldingName</span>
                                    @if (!string.IsNullOrWhiteSpace(payment.Notes))
                                    {
                                        <span class="mud-typography-caption">@payment.Notes</span>
                                    }
                                </div>
                                <span class="dividend-amount">@FormatCashReceived(payment)</span>
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Disabled="@Busy"
                                         AriaLabel="@($"Actions for {payment.Ticker} on {DateFormatter.Format(payment.PaymentDate)}")">
                                    <MudMenuItem OnClick="@(() => ShowEdit(payment))" aria-label="@($"Edit dividend {payment.Ticker} on {DateFormatter.Format(payment.PaymentDate)}")">Edit</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => ConfirmDeleteAsync(payment))" aria-label="@($"Delete dividend {payment.Ticker} on {DateFormatter.Format(payment.PaymentDate)}")">Delete</MudMenuItem>
                                </MudMenu>
                            </li>
                        }
                    </ul>
                }
                @if (_hasMore)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="Busy" OnClick="LoadOlderPaymentsAsync" Class="my-3">@(_isHistoryLoading ? "Loading older payments…" : "Load older payments")</MudButton>
                }
            }
        </div>
    </section>
</MudCard>
</div>
@if (_editVisible)
{
    <MudOverlay Visible DarkBackground ZIndex="1300">
        <MudFocusTrap DefaultFocus="DefaultFocus.None">
            <MudPaper Class="pa-5" Style="width:min(520px,92vw);max-height:90dvh;overflow-y:auto" role="dialog" aria-modal="true" aria-label="@(_editingPayment is null ? "Record dividend" : "Edit dividend")"
                      @onkeydown="OnDialogKeyDown">
                <MudText Typo="Typo.h6" Class="mb-3">@(_editingPayment is null ? "Record dividend" : "Edit dividend")</MudText>
                <MudStack Spacing="2">
                    @if (_holdings.Count == 0) { <MudAlert Severity="Severity.Info">Record a trade before recording its dividend.</MudAlert> }
                    @if (_holdings.Count > 0)
                    {
                        <MudSelect T="long" Label="Holding" Value="_formHoldingId" ValueChanged="OnHoldingChanged" ToStringFunc="HoldingLabel" Disabled="_savingEdit" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var holding in _holdings) { <MudSelectItem Value="holding.AssetListingId">@holding.Name (@holding.Ticker)</MudSelectItem> }
                        </MudSelect>
                    }
                    <MudDatePicker Label="Received date" @bind-Date="_formPaymentDate" MaxDate="DateTime.UtcNow.Date" DateFormat="@DateFormatter.PickerFormat" Culture="@DateFormatter.Culture" Disabled="_savingEdit" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudNumericField @ref="_amountField" T="decimal?" Label="Cash received" @bind-Value="_formAmount" Min="0.00000001m" Step="0.01m" Disabled="_savingEdit" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudSelect T="string" Label="Payout currency" Value="_formCurrency" ValueChanged="OnCurrencyChanged" Disabled="_savingEdit" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var currency in _availableCurrencies) { <MudSelectItem Value="currency">@currency</MudSelectItem> }
                    </MudSelect>
                    <MudTextField T="string" Label="Notes (optional)" @bind-Value="_formNotes" MaxLength="512" Disabled="_savingEdit" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    @if (_formError is not null) { <MudAlert Severity="Severity.Error" role="alert">@_formError</MudAlert> }
                    <MudStack Row Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton OnClick="CloseEdit" Disabled="_savingEdit">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEditAsync" Disabled="@(!CanSaveEdit)">Save</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudFocusTrap>
    </MudOverlay>
}
