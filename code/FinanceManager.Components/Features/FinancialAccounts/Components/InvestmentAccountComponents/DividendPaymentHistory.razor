@using FinanceManager.Components.Shared.Helpers

<section aria-label="Dividend income" class="my-4 pb-12" inert="@(_editVisible || _confirmingDelete)">
    <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudText Typo="Typo.h5">Dividend income</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="@(Busy || _error is not null)" OnClick="ShowRecord">Record dividend</MudButton>
    </MudStack>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">Manual cash received. These records do not change account balances or investment returns.</MudText>
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" aria-label="Loading dividend payments" />
        <MudText Typo="Typo.body2" role="status">Loading dividend payments…</MudText>
    }
    else
    {
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="my-3">@_error <MudButton OnClick="ReloadHistoryAsync">Retry</MudButton></MudAlert>
        }
        @if (_payments.Count == 0 && _error is null)
        {
            <MudAlert Severity="Severity.Info">No dividend payments yet.</MudAlert>
        }
        else if (_payments.Count > 0)
        {
            <MudTable Items="_payments" Dense Breakpoint="Breakpoint.Sm" Elevation="0" aria-label="Dividend payment history">
                <HeaderContent><MudTh>Received date</MudTh><MudTh>Holding</MudTh><MudTh>Cash received</MudTh><MudTh>Notes</MudTh><MudTh>Actions</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Received date">@DateFormatter.Format(context.PaymentDate)</MudTd>
                    <MudTd DataLabel="Holding">@context.HoldingName · @context.Ticker</MudTd>
                    <MudTd DataLabel="Cash received">@FormatCashReceived(context)</MudTd>
                    <MudTd DataLabel="Notes"><span style="overflow-wrap:anywhere">@(context.Notes ?? "—")</span></MudTd>
                    <MudTd DataLabel="Actions"><MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                        <MudButton Disabled="Busy" Size="Size.Small" OnClick="@(() => ShowEdit(context))" aria-label="@($"Edit dividend {context.Ticker} on {DateFormatter.Format(context.PaymentDate)}")">Edit</MudButton>
                        <MudButton Disabled="Busy" Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDeleteAsync(context))" aria-label="@($"Delete dividend {context.Ticker} on {DateFormatter.Format(context.PaymentDate)}")">Delete</MudButton>
                    </MudStack></MudTd>
                </RowTemplate>
            </MudTable>
        }
        @if (_hasMore)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="Busy" OnClick="LoadOlderPaymentsAsync" Class="my-3">@(_isHistoryLoading ? "Loading older payments…" : "Load older payments")</MudButton>
        }
    }
</section>
@if (_editVisible)
{
    <MudOverlay Visible DarkBackground ZIndex="1300">
        <MudFocusTrap DefaultFocus="DefaultFocus.FirstChild">
            <MudPaper Class="pa-5" Style="width:min(520px,92vw);max-height:90dvh;overflow-y:auto" role="dialog" aria-modal="true" aria-label="@(_editingPayment is null ? "Record dividend" : "Edit dividend")">
                <MudText Typo="Typo.h6" Class="mb-3">@(_editingPayment is null ? "Record dividend" : "Edit dividend")</MudText>
                <MudStack Spacing="2">
                    @if (_holdings.Count == 0) { <MudAlert Severity="Severity.Info">Record a trade in this account before recording its dividend.</MudAlert> }
                    <MudSelect T="long" Label="Holding" @bind-Value="_formHoldingId" Disabled="_savingEdit" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var holding in _holdings) { <MudSelectItem Value="holding.AssetListingId">@holding.Name (@holding.Ticker)</MudSelectItem> }
                    </MudSelect>
                    <MudDatePicker Label="Received date" @bind-Date="_formPaymentDate" MaxDate="DateTime.UtcNow.Date" DateFormat="@DateFormatter.PickerFormat" Culture="@DateFormatter.Culture" Disabled="_savingEdit" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudNumericField T="decimal" Label="Cash received" @bind-Value="_formAmount" Min="0.00000001m" Step="0.01m" Disabled="_savingEdit" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudSelect T="string" Label="Payout currency" @bind-Value="_formCurrency" Disabled="_savingEdit" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var currency in _availableCurrencies) { <MudSelectItem Value="currency">@currency</MudSelectItem> }
                    </MudSelect>
                    <MudTextField T="string" Label="Notes (optional)" @bind-Value="_formNotes" MaxLength="512" Disabled="_savingEdit" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    @if (_formError is not null) { <MudAlert Severity="Severity.Error" role="alert">@_formError</MudAlert> }
                    <MudStack Row Justify="Justify.FlexEnd" Spacing="2">
                        <MudButton OnClick="CloseEdit" Disabled="_savingEdit">Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEditAsync" Disabled="@(!CanSaveEdit)">Save</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudFocusTrap>
    </MudOverlay>
}
