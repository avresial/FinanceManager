@namespace FinanceManager.Components.Features.FinancialAccounts.Components.InvestmentAccountComponents
@using FinanceManager.Components.Features.FinancialAccounts.Models
@using FinanceManager.Domain.Assets.Entities

@* The sizing hooks live on a plain wrapper: scoped CSS is stamped on markup elements, not on a child component's root. *@
<div class="@(Height is null ? "fm-holdings-sizer" : "fm-holdings-sizer fm-holdings-sizer--sized")" style="@(Height is null ? null : $"--fm-card-height:{Height}")">
<MudCard Outlined="true" Class="fm-holdings-card rounded-lg d-flex flex-column">
    <CardHeader Title="Holdings" Subtitle="@Subtitle" InfoText="Open positions valued at the latest trade price on or before the selected date."
                InfoAriaLabel="About holdings card" />
    <MudCardContent Class="fm-holdings-content pa-0 overflow-y-auto">
        @if (IsLoading)
        {
            <MudSkeleton Height="120px" Class="mx-4" aria-label="Loading holdings" />
        }
        else if (HasError && Holdings.Count == 0)
        {
            <MudAlert Severity="Severity.Error" Class="ma-4" role="alert">Couldn't load holdings.
                @if (OnRetry.HasDelegate) { <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="OnRetry">Retry</MudButton> }
            </MudAlert>
        }
        else if (Holdings.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="ma-4">No open holdings.</MudAlert>
            <MudButton Href="/Transactions?dialog=add-entry&amp;kind=investment" Color="Color.Primary" Class="mx-4">Add trade</MudButton>
        }
        else
        {
            @if (HasError)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mx-4 mb-2" role="alert">Couldn't refresh holdings.
                    @if (OnRetry.HasDelegate) { <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="OnRetry">Retry</MudButton> }
                </MudAlert>
            }
            <div class="@($"fm-holdings-list {(_showAll ? "" : "fm-holdings-compact")}")" role="list" aria-label="Holdings">
                @foreach (var holding in Holdings)
                {
                    <article class="fm-holding-item px-4 py-3" role="listitem" @key="holding.ListingId">
                        <div class="fm-holding-header">
                            <div class="fm-holding-title-group">
                                <MudText Typo="Typo.subtitle2" Class="fm-holding-ticker">@holding.Ticker</MudText>
                                <MudText Typo="Typo.caption" Class="fm-holding-exchange mud-text-secondary">
                                    Exchange · @(string.IsNullOrWhiteSpace(holding.ExchangeName) ? "Not specified" : holding.ExchangeName)
                                </MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default"
                                     Class="fm-holding-type-chip">
                                @FormatAssetType(holding.AssetType)
                            </MudChip>
                        </div>

                        <div class="fm-holding-grid mt-2">
                            <div class="fm-holding-field">
                                <MudText Typo="Typo.overline" Color="Color.Default" Class="fm-field-label">Units</MudText>
                                <MudText Typo="Typo.body2" Class="fm-field-value fm-tabular">@holding.Quantity.ToString("N4")</MudText>
                            </div>
                            <div class="fm-holding-field">
                                <MudText Typo="Typo.overline" Color="Color.Default" Class="fm-field-label">Last trade price</MudText>
                                <MudText Typo="Typo.body2" Class="fm-field-value fm-tabular">@MoneyFormatter.Format(holding.LatestPrice, holding.Currency)</MudText>
                            </div>
                            <div class="fm-holding-field">
                                <MudText Typo="Typo.overline" Color="Color.Default" Class="fm-field-label">Current value</MudText>
                                <MudText Typo="Typo.body2" Class="fm-field-value fm-tabular">@MoneyFormatter.Format(holding.Value, holding.Currency)</MudText>
                            </div>
                        </div>
                    </article>

                }
            </div>
            @if (Holdings.Count > 1)
            {
                <div class="fm-holdings-totals px-4 py-3" aria-label="Total value per currency">
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Total value</MudText>
                    <MudText Typo="Typo.body2" Class="fm-tabular">@string.Join(" · ", Totals)</MudText>
                </div>
            }
            @if (Holdings.Count > 3)
            {
                <div class="d-flex d-sm-none justify-center">
                    <MudButton OnClick="@(() => _showAll = !_showAll)" Color="Color.Primary">
                        @(_showAll ? "Show less" : $"Show all {Holdings.Count}")
                    </MudButton>
                </div>
            }
        }
    </MudCardContent>
</MudCard>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<InvestmentHoldingModel> Holdings { get; set; } = [];

    /// <summary>Card height on wide screens; on phones it is only a ceiling so a short list does not leave blank space.</summary>
    [Parameter] public string? Height { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool HasError { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    private bool _showAll;

    private string? Subtitle => IsLoading ? "Loading open positions" : Holdings.Count == 0 ? null : Holdings.Count == 1 ? "1 open position" : $"{Holdings.Count} open positions";

    // Native currencies are never converted into one figure, so each currency gets its own total.
    private IEnumerable<string> Totals => Holdings.GroupBy(h => h.Currency, StringComparer.OrdinalIgnoreCase)
        .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
        .Select(g => MoneyFormatter.Format(g.Sum(h => h.Value), g.Key));

    private static string FormatAssetType(AssetType type) => type switch
    {
        AssetType.MutualFund => "Mutual fund",
        AssetType.ETF => "ETF",
        _ => type.ToString()
    };
}
