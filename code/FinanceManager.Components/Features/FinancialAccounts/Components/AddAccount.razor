@page "/AddAccount"
@using FinanceManager.Domain.FinancialAccounts.Currencies.Entities

<PageTitle>Add account</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <PageHeader Title="Add account" Subtitle="Create a currency, investment or bond account to start tracking it." />
    <MudForm Spacing="3" @bind-IsValid="@_success" @bind-Errors="@_errors" Style="max-width:600px;">
        <MudTextField T="string" @bind-Value=_accountName Label="Account name" Required="true" RequiredError="User name is required!"
                      Validation="@(new Func<string, IEnumerable<string>>(AccountNameValidation))" data-testid="account-name" />

            <MudStack>
                <MudSelect @bind-Value="_selectedAccountType"
                           Variant="Variant.Text"
                           Label="Account type" Required data-testid="account-type">
                    @foreach (var state in _accountTypes)
                    {
                        <MudSelectItem Value="state">@state</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            @if (_selectedAccountType == "Currency account")
            {
                <MudSelect T="int" @bind-Value="_currencyId" Label="Currency" Required data-testid="account-currency">
                    @foreach (var currency in _currencies)
                    {
                        <MudSelectItem Value="@currency.Id">@currency.ShortName</MudSelectItem>
                    }
                </MudSelect>
            }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_success)" Class="ml-auto" @onclick=Add data-testid="account-submit">Add</MudButton>
        @if (_addedAccountId is not null)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="my-3">
                Account was succesfully added.
                <MudLink Color="Color.Success" Href="@($"AccountDetails/{_addedAccountId}")" Class="ml-2"><b>Go!</b></MudLink>
            </MudAlert>
        }
        <MudStack>
            @foreach (var error in _errors)
            {
                <MudAlert Severity="Severity.Warning">@error</MudAlert>
            }
        </MudStack>
    </MudForm>
</MudContainer>
