@page "/Export/{AccountId:int}"
<PageTitle>Export</PageTitle>

<ComponentStateView IsLoading="@_isLoading" ErrorMessage="@ErrorMessage">
    <AccountFormContainer>
        <PageHeader Title="Export" />
        <MudPaper Outlined Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle1">@GetAccountTypeLabel() account</MudText>
                @if (!string.IsNullOrWhiteSpace(AccountName))
                {
                    <MudText Typo="Typo.subtitle2">@AccountName</MudText>
                }

                @if (HasAvailableDateRange)
                {
                    <MudText Typo="Typo.body2">
                        Available range: @DateFormatter.FormatRange(_availableStartDate!.Value, _availableEndDate!.Value)
                    </MudText>

                    <MudDatePicker Variant="Variant.Outlined" Label="Start date" @bind-Date="_startDate" DateFormat="@DateFormatter.PickerFormat" Culture="@DateFormatter.Culture" MinDate="_availableStartDate"
                                   MaxDate="_availableEndDate" />
                    <MudDatePicker Variant="Variant.Outlined" Label="End date" @bind-Date="_endDate" DateFormat="@DateFormatter.PickerFormat" Culture="@DateFormatter.Culture" MinDate="_availableStartDate"
                                   MaxDate="_availableEndDate" />
                }
                else if (AccountDescriptor?.Kind == FinancialAccountKind.Stock)
                {
                    <MudAlert Severity="Severity.Info">CSV export isn't available for investment accounts.</MudAlert>
                }
                else if (string.IsNullOrEmpty(ErrorMessage))
                {
                    <MudAlert Severity="Severity.Info">This account has no entries available to export.</MudAlert>
                }

                <div class="mt-4">
                    <FormActions>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   Disabled="@(!HasAvailableDateRange || _isDownloading)" OnClick="DownloadAll">
                            Export all
                        </MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Default" href="@($"/AccountDetails/{AccountId}")">
                            Cancel
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanDownload || _isDownloading)"
                                   OnClick="DownloadSelected">
                            @if (_isDownloading)
                            {
                                <MudProgressCircular Class="mr-2" Color="Color.Inherit" Size="Size.Small" Indeterminate="true" />
                            }
                            Export
                        </MudButton>
                    </FormActions>
                </div>
            </MudStack>
        </MudPaper>
    </AccountFormContainer>
</ComponentStateView>
