<div class="fm-tx-toolbar mb-4">
    @* Single compact row: type filter · category · date range · search · add entry *@
    @* overflow-x is the safety valve for viewports narrower than the controls: the row scrolls
       itself instead of pushing the page into horizontal overflow. *@
    <div class="d-flex align-center" style="@($"min-height: 40px; overflow-x: auto; gap: {(IsMobile ? "2px" : "8px")};")">
        @* Search — collapsed to an icon; the input lives in the panel below *@
        <MudIconButton Icon="@(_isSearchExpanded ? Icons.Material.Filled.SearchOff : Icons.Material.Filled.Search)"
                       Size="Size.Small" Color="@(_isSearchExpanded || !string.IsNullOrWhiteSpace(SearchText) ? Color.Primary : Color.Default)"
                       OnClick="ToggleSearch" Style="flex-shrink: 0;"
                       aria-label="@(_isSearchExpanded ? "Hide search" : "Search transactions")"
                       title="@(_isSearchExpanded ? "Hide search" : "Search transactions")"
                       aria-expanded="@_isSearchExpanded" aria-controls="@_searchPanelId" />

        @* Income / Expense toggle group *@
        <MudToggleGroup T="TxFilter?" Value="ActiveFilter" ValueChanged="ActiveFilterChanged"
                        SelectionMode="SelectionMode.ToggleSelection" Color="Color.Default" Dense="true" Size="Size.Small" Outlined
                        Delimiters>
            <MudToggleItem Value="@((TxFilter?)TxFilter.All)">All</MudToggleItem>
            <MudToggleItem Value="@((TxFilter?)TxFilter.Income)">Income</MudToggleItem>
            <MudToggleItem Value="@((TxFilter?)TxFilter.Expense)">Expense</MudToggleItem>
        </MudToggleGroup>

        @* Category filter — icon only, badged with the number of active categories *@
        @if (AvailableLabels is not null && AvailableLabels.Any())
        {
            <MudMenu @ref="_labelMenu" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                     Style="flex-shrink: 0;">
                <ActivatorContent>
                    <MudBadge Content="@SelectedLabels.Count" Color="Color.Primary" Overlap="true" Bordered="true"
                              Visible="@(SelectedLabels.Count > 0)">
                        <MudIconButton Icon="@Icons.Material.Filled.FilterList" Size="Size.Small"
                                       Color="@(SelectedLabels.Count > 0 ? Color.Primary : Color.Default)"
                                       OnClick="ToggleLabelMenu" aria-label="@CategoryButtonText" title="@CategoryButtonText"
                                       aria-haspopup="menu" />
                    </MudBadge>
                </ActivatorContent>
                <ChildContent>
                    <MudText Typo="Typo.overline" Class="px-4 pt-2 pb-1" Style="display:block">Filter by category</MudText>
                    @foreach (var label in AvailableLabels)
                    {
                        <MudMenuItem OnClick="@(() => ToggleLabel(label))" AutoClose="false" Style="padding: 2.65px;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudCheckBox Value="@SelectedLabels.Contains(label)" T="bool" Dense="true" ReadOnly="true" />
                                <MudText Typo="Typo.body2">@label</MudText>
                            </MudStack>
                        </MudMenuItem>
                    }
                    <MudDivider />
                    <div class="d-flex justify-space-between px-2 py-1">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(SelectedLabels.Count == 0)"
                                   OnClick="ClearLabels">Clear all</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CloseLabelMenu">
                            Done</MudButton>
                    </div>
                </ChildContent>
            </MudMenu>
        }

        @* Date range — one dropdown showing the active range *@
        <MudMenu @ref="_rangeMenu" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                 Style="flex-shrink: 0;">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           EndIcon="@Icons.Material.Filled.KeyboardArrowDown" OnClick="ToggleRangeMenu"
                           aria-label="@RangeButtonAccessibleText" title="@RangeButtonAccessibleText" aria-haspopup="menu"
                           Class="fm-range-button">
                    @if (IsCustomRange)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
                    }
                    else
                    {
                        @RangeButtonText
                    }
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudText Typo="Typo.overline" Class="px-4 pt-2 pb-1" Style="display:block">Date range</MudText>
                @foreach (var range in Ranges)
                {
                    <MudMenuItem OnClick="@(() => OnRangeSelected(range))">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small"
                                     Style="@(SelectedRange == range ? "" : "visibility: hidden;")" />
                            <MudText Typo="Typo.body2">@range</MudText>
                        </MudStack>
                    </MudMenuItem>
                }
                <MudDivider />
                <MudMenuItem OnClick="OpenCustomDateRangePicker">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Custom range…</MudText>
                    </MudStack>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudSpacer />

        @* Add entry split button — plus icon + Import / Export / Manage in the dropdown *@
        <MudButtonGroup Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" Style="flex-shrink: 0;">
            <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="OnAddEntry" aria-label="Add entry" title="Add entry" />
            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown" AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight" Dense Style="align-self: auto;" class="p-0"
                     aria-label="More account actions">
                @if (ShowInsightsButton)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Insights" OnClick="OnInsightsClick">Insights</MudMenuItem>
                    <MudDivider />
                }
                <MudMenuItem Icon="@Icons.Material.Filled.FileUpload" Href="@($"/Import/{AccountId}")">Import…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.FileDownload" Href="@($"/Export/{AccountId}")">Export CSV
                </MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Settings" Href="@($"/ManageAccount/{AccountId}")">Manage account
                </MudMenuItem>
            </MudMenu>
        </MudButtonGroup>
    </div>

    @* Search panel — sits directly below the toolbar, hidden until the search icon is used *@
    <MudCollapse Expanded="_isSearchExpanded">
        <div id="@_searchPanelId" class="pt-2">
            <MudTextField @ref="_searchField" T="string" Value="SearchText" ValueChanged="OnSearchChanged"
                          Placeholder="Search transactions, notes, labels…" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate
                          DebounceInterval="150" Clearable OnKeyDown="OnSearchKeyDown" FullWidth="true"
                          aria-label="Search transactions" />
        </div>
    </MudCollapse>

    @* Hidden picker opened programmatically from the date-range menu; Dialog variant avoids
       the broken nested-popover behaviour of embedding the picker inside a MudMenu. *@
    <div class="fm-custom-range-picker">
        <MudDateRangePicker @ref="_customDateRangePicker" DateRange="CustomDateRange" DateFormat="dd/MM/yyyy"
                            DateRangeChanged="OnCustomDateRangeChanged" PickerVariant="PickerVariant.Dialog" />
    </div>
</div>
