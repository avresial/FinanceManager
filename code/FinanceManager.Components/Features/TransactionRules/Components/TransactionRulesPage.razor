@page "/TransactionRules"
@attribute [Authorize]
@using FinanceManager.Domain.TransactionRules
@using FinanceManager.Domain.TransactionRules.Commands
@using FinanceManager.Domain.TransactionRules.Conditions
@using FinanceManager.Domain.TransactionRules.Dtos
@using FinanceManager.Domain.TransactionRules.Models

<PageTitle>Transaction automation</PageTitle>

<SectionContent SectionName="page-title">
    <MudText Typo="Typo.h6">Transaction automation</MudText>
</SectionContent>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <div class="d-flex flex-wrap justify-space-between align-center gap-3 mb-5">
        <div>
            <MudText Typo="Typo.h4" HtmlTag="h1">Transaction automation</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                Rules run from top to bottom. Each rule sees changes made by earlier rules.
            </MudText>
        </div>
        <div class="d-flex flex-wrap gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(_isLoading || _isSaving)" OnClick="BeginCreate" aria-label="Create a new rule">Create rule</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@(_isLoading || IsBusy)" OnClick="RefreshAsync">Refresh</MudButton>
        </div>
    </div>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
    }

    @if (_isLoading && _rules.Count == 0)
    {
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="180px" />
    }
    else if (_rules.Count == 0 && _error is null && !_isCreating)
    {
        <MudPaper Outlined Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.h6" Class="mt-2">No automation rules yet</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Create your first rule to keep new and imported transactions tidy.</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="BeginCreate" Class="mt-3">Create your first rule</MudButton>
        </MudPaper>
    }
    else if (_rules.Count > 0)
    {
        <div class="rules-heading">
            <MudText Typo="Typo.h6">Rules · @_rules.Count</MudText>
            <MudText Typo="Typo.caption">Change order in rule details</MudText>
        </div>
        <ol class="rule-list" aria-label="Ordered transaction rules">
            @for (var index = 0; index < _rules.Count; index++)
            {
                var rule = _rules[index];
                var number = (index + 1).ToString("D2");
                var isExpanded = _expandedId == rule.Id;
                <li @key="rule.Id" class="rule-item @(isExpanded ? "is-expanded" : null)" data-rule-id="@rule.Id">
                    <button type="button" class="rule-row" aria-expanded="@isExpanded.ToString().ToLowerInvariant()"
                            aria-controls="@DetailId(rule)" aria-label="@($"Rule {number}: {rule.Name}")"
                            disabled="@_isSaving" @onclick="@(() => ExpandRuleAsync(rule))">
                        <span class="rule-number">@number</span>
                        <span class="rule-row-copy">
                            <span class="rule-name">@rule.Name</span>
                            <span class="rule-summary">@DescribeConditions(rule) → @DescribeActions(rule)</span>
                        </span>
                        <span class="rule-state @(rule.IsEnabled ? "enabled" : null)">@(rule.IsEnabled ? "Enabled" : "Disabled")</span>
                        <span class="rule-chevron" aria-hidden="true">@(isExpanded ? "−" : "+")</span>
                    </button>
                    @if (isExpanded)
                    {
                        <section id="@DetailId(rule)" class="rule-detail" aria-label="@($"Details for {rule.Name}")">
                            <div class="rule-detail-header">
                                <div>
                                    <MudText Typo="Typo.overline" Color="Color.Primary">Rule @number · @(rule.IsEnabled ? "Enabled" : "Disabled")</MudText>
                                    <MudText Typo="Typo.h6">@rule.Name</MudText>
                                </div>
                                @if (_editingId != rule.Id)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@IsBusy" OnClick="@(() => BeginEdit(rule))" aria-label="@($"Edit {rule.Name}")">Edit fields</MudButton>
                                }
                            </div>
                            <div class="rule-workspace">
                                <div class="rule-definition">
                                    @if (_editingId == rule.Id)
                                    {
                                        @RuleEditor
                                    }
                                    else
                                    {
                                        <div class="rule-step">
                                            <span class="step-label">IF</span>
                                            <div>
                                                <MudText Typo="Typo.subtitle2">All conditions must match</MudText>
                                                <ul class="condition-list">
                                                    @foreach (var condition in rule.Conditions)
                                                    {
                                                        <li>@DescribeCondition(condition, true)</li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                        <div class="rule-step">
                                            <span class="step-label do-label">DO</span>
                                            <div>
                                                <MudText Typo="Typo.subtitle2">Apply actions in order</MudText>
                                                <ol class="action-list">
                                                    @foreach (var action in rule.Actions)
                                                    {
                                                        <li>@DescribeAction(action)</li>
                                                    }
                                                </ol>
                                            </div>
                                        </div>
                                        <div class="rule-options">
                                            <MudSwitch T="bool" Value="@rule.IsEnabled" ValueChanged="@(value => ToggleAsync(rule, value))" Disabled="@IsBusy" Color="Color.Primary" Label="Enabled" aria-label="@($"Enable {rule.Name}")" />
                                            <MudText Typo="Typo.body2"><strong>Stop after match:</strong> @(rule.StopProcessing ? "On" : "Off")</MudText>
                                            <MudText Typo="Typo.caption">When all conditions match, run this rule's actions first, then @(rule.StopProcessing ? "skip the remaining rules." : "continue to the next rule.")</MudText>
                                        </div>
                                    }
                                </div>
                                @RuleTestResults
                            </div>
                            <div class="rule-detail-actions">
                                <div class="d-flex flex-wrap gap-2">
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.KeyboardArrowUp" Disabled="@(index == 0 || IsBusy)" OnClick="@(() => MoveAsync(rule, -1))" aria-label="@($"Move {rule.Name} up")">Move up</MudButton>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.KeyboardArrowDown" Disabled="@(index == _rules.Count - 1 || IsBusy)" OnClick="@(() => MoveAsync(rule, 1))" aria-label="@($"Move {rule.Name} down")">Move down</MudButton>
                                </div>
                                @if (_confirmDeleteId == rule.Id)
                                {
                                    <div class="delete-confirmation" role="alert">
                                        <MudText Typo="Typo.body2">Delete “@rule.Name”? This cannot be undone.</MudText>
                                        <MudButton Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => DeleteAsync(rule))">Confirm delete</MudButton>
                                        <MudButton Size="Size.Small" OnClick="@(() => _confirmDeleteId = null)">Cancel</MudButton>
                                    </div>
                                }
                                else
                                {
                                    <MudButton Color="Color.Error" Size="Size.Small" Disabled="@IsBusy" OnClick="@(() => _confirmDeleteId = rule.Id)" aria-label="@($"Delete {rule.Name}")">Delete rule</MudButton>
                                }
                            </div>
                        </section>
                    }
                </li>
            }
        </ol>
    }
    @if (_isCreating)
    {
        <section class="creation-workspace mt-4" aria-label="Create a rule">
            <div class="rule-workspace">
                @RuleEditor
                @RuleTestResults
            </div>
        </section>
    }
    @if (_rules.Count > 0)
    {
        <MudPaper Outlined Class="pa-4 mt-5">
            <MudText Typo="Typo.h6">Test the full sequence</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Test the current saved rule set against a transaction without changing your data.
            </MudText>
            <MudGrid Spacing="2" Class="mx-0 w-100">
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_previewContractor" @bind-Value:after="InvalidatePreview" Label="Contractor" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_previewDescription" @bind-Value:after="InvalidatePreview" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="int?" @bind-Value="_previewAccountId" @bind-Value:after="InvalidatePreview" Label="Account" Required="true"
                               ToStringFunc="@(accountId => accountId is int id ? GetAccountLabel(id) : string.Empty)"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var account in _accounts)
                        {
                            <MudSelectItem T="int?" Value="@((int?)account.AccountId)">@GetAccountLabel(account)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3">
                    <MudNumericField T="decimal" @bind-Value="_previewAmount" @bind-Value:after="InvalidatePreview" Label="Amount" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="3">
                    <MudSelect T="TransactionDirection" @bind-Value="_previewDirection" @bind-Value:after="InvalidatePreview" Label="Direction" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var direction in Enum.GetValues<TransactionDirection>())
                        {
                            <MudSelectItem T="TransactionDirection" Value="@direction">@direction</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@_isPreviewing" OnClick="PreviewAsync">Preview sequence</MudButton>
                </MudItem>
            </MudGrid>
            @if (_preview is not null)
            {
                <div class="sequence-results mt-3" role="status" aria-live="polite">
                    <MudText Typo="Typo.subtitle2">Saved sequence results</MudText>
                    <ol class="sequence-trail">
                        @foreach (var outcome in _preview.RuleOutcomes)
                        {
                            <li><strong>@outcome.RuleName</strong> · @DescribeOutcome(outcome)</li>
                        }
                    </ol>
                    @BeforeAfter(_preview.OriginalFacts, _preview.FinalFacts)
                    @if (!_preview.HasChanges)
                    {
                        <MudText Typo="Typo.body2">No effective change.</MudText>
                    }
                </div>
            }
        </MudPaper>
        <MudPaper Outlined Class="pa-4 mt-5">
            <MudText Typo="Typo.h6">Apply to existing currency transactions</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Retroactive application changes matching transactions in your accounts. Confirm before running it.
            </MudText>
            <MudCheckBox T="bool" @bind-Value="_confirmApply" Label="I understand that matching transactions will be updated" Color="Color.Warning" />
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(!_confirmApply || _isApplying)" OnClick="ApplyAsync">
                Apply to all currency transactions
            </MudButton>
            @if (_applyResult is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-2">Checked @_applyResult.Examined transactions and updated @_applyResult.Updated.</MudText>
            }
        </MudPaper>

    }
</MudContainer>

@code {
    private RenderFragment RuleEditor => @<text>
<MudForm @ref="_ruleForm" FieldChanged="OnEditorChanged">
        <MudPaper Outlined Class="pa-4 rule-editor">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.h6">@(_editingId is null ? "Create a rule" : "Edit rule")</MudText>
                @if (_editingId is not null || _isCreating)
                {
                    <MudButton Variant="Variant.Text" OnClick="ResetForm">Cancel</MudButton>
                }
            </div>

        <MudGrid Spacing="2" Class="mx-0 w-100">
            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_name" Label="Rule name"
                              Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="200" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSwitch T="bool" @bind-Value="_enabled" Color="Color.Primary" Label="Enabled" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSwitch T="bool" @bind-Value="_stopProcessing" Color="Color.Primary" Label="Stop after match" />
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption">Stop after match takes effect after this rule's actions, only when all conditions match.</MudText>

        <div class="d-flex flex-wrap justify-space-between align-center mt-4 mb-2">
            <MudText Typo="Typo.subtitle2">Match all of these conditions</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddCondition">
                Add condition
            </MudButton>
        </div>
        @for (var index = 0; index < _conditions.Count; index++)
        {
            var condition = _conditions[index];
            var conditionIndex = index;
            <MudPaper Outlined Class="pa-3 mb-3" @key="condition">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle2">Condition @(conditionIndex + 1)</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   Disabled="@(_conditions.Count == 1)" OnClick="@(() => RemoveCondition(condition))"
                                   aria-label="@(string.Concat("Remove condition ", conditionIndex + 1))" />
                </div>
                <MudGrid Spacing="2" Class="mx-0 w-100">
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="condition.Type" Label="Condition" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("Contractor")">Contractor</MudSelectItem>
                            <MudSelectItem Value="@("Description")">Description</MudSelectItem>
                            <MudSelectItem Value="@("Account")">Account</MudSelectItem>
                            <MudSelectItem Value="@("Amount")">Amount</MudSelectItem>
                            <MudSelectItem Value="@("Direction")">Direction</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    @if (condition.Type is "Contractor" or "Description")
                    {
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" @bind-Value="condition.Pattern" Label="Text" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudSelect T="TextMatchOperator" @bind-Value="condition.MatchOperator" Label="Match" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@TextMatchOperator.Equals">Equals</MudSelectItem>
                                <MudSelectItem Value="@TextMatchOperator.Contains">Contains</MudSelectItem>
                                <MudSelectItem Value="@TextMatchOperator.StartsWith">Starts with</MudSelectItem>
                                <MudSelectItem Value="@TextMatchOperator.EndsWith">Ends with</MudSelectItem>
                                <MudSelectItem Value="@TextMatchOperator.RegularExpression">Regular expression</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudCheckBox T="bool" @bind-Value="condition.IgnoreCase" Label="Ignore case" Color="Color.Primary" />
                        </MudItem>
                    }
                    else if (condition.Type == "Account")
                    {
                        <MudItem xs="12" sm="8">
                            <MudSelect T="int" @bind-SelectedValues="condition.AccountIds" Label="Accounts" MultiSelection="true"
                                       ToStringFunc="GetAccountLabel"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var account in _accounts)
                                {
                                    <MudSelectItem T="int" Value="@account.AccountId">@GetAccountLabel(account)</MudSelectItem>
                                }
                                @foreach (var accountId in condition.AccountIds.Where(IsMissingAccount))
                                {
                                    <MudSelectItem T="int" Value="@accountId">@GetMissingAccountLabel(accountId)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    else if (condition.Type == "Direction")
                    {
                        <MudItem xs="12" sm="4">
                            <MudSelect T="TransactionDirection" @bind-Value="condition.Direction" Label="Direction" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var direction in Enum.GetValues<TransactionDirection>())
                                {
                                    <MudSelectItem T="TransactionDirection" Value="@direction">@direction</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" sm="4">
                            <MudSelect T="TransactionDirection" @bind-Value="condition.Direction" Label="Direction" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var direction in Enum.GetValues<TransactionDirection>())
                                {
                                    <MudSelectItem T="TransactionDirection" Value="@direction">@direction</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudNumericField T="decimal?" @bind-Value="condition.MinAmount" Label="Minimum" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudNumericField T="decimal?" @bind-Value="condition.MaxAmount" Label="Maximum" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudNumericField T="decimal?" @bind-Value="condition.Threshold" Label="Threshold" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSelect T="AmountComparison" @bind-Value="condition.Comparison" Label="Amount comparison" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (var comparison in Enum.GetValues<AmountComparison>())
                                {
                                    <MudSelectItem T="AmountComparison" Value="@comparison">@DescribeComparison(comparison)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption">Use either an inclusive minimum/maximum range or a threshold with its comparison.</MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        }

        <div class="d-flex flex-wrap justify-space-between align-center mt-4 mb-2">
            <MudText Typo="Typo.subtitle2">Actions</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAction">
                Add action
            </MudButton>
        </div>
        @for (var index = 0; index < _actions.Count; index++)
        {
            var action = _actions[index];
            var actionIndex = index;
            <MudPaper Outlined Class="pa-3 mb-3" @key="action">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle2">Action @(actionIndex + 1)</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                   Disabled="@(_actions.Count == 1)" OnClick="@(() => RemoveAction(action))"
                                   aria-label="@(string.Concat("Remove action ", actionIndex + 1))" />
                </div>
                <MudGrid Spacing="2" Class="mx-0 w-100">
                    <MudItem xs="12" sm="4">
                        <MudSelect T="string" @bind-Value="action.Type" Label="Action" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("SetLabels")">Set labels</MudSelectItem>
                            <MudSelectItem Value="@("NormalizeContractor")">Normalize contractor</MudSelectItem>
                            <MudSelectItem Value="@("NormalizeDescription")">Normalize description</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    @if (action.Type == "SetLabels")
                    {
                        <MudItem xs="12" sm="5">
                            <MudTextField T="string" @bind-Value="action.LabelsText" Label="Labels" HelperText="Comma-separated labels" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudCheckBox T="bool" @bind-Value="action.ReplaceExisting" Label="Replace existing" Color="Color.Primary" />
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" sm="8">
                            <MudTextField T="string" @bind-Value="action.Value" Label="Normalized value" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        }

            <div class="d-flex flex-wrap justify-end gap-2 mt-4">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(_isSaving || _isTesting)" OnClick="TestAsync">
                    @(_isTesting ? "Testing..." : "Test")
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isSaving || _isTesting)" OnClick="SaveAsync">
                    @(_editingId is null ? "Create rule" : "Save changes")
                </MudButton>
            </div>

        </MudPaper>
    </MudForm>
    </text>;

    private RenderFragment RuleTestResults => @<aside class="rule-preview" aria-label="Transaction preview">
        <div class="d-flex flex-wrap justify-space-between align-center gap-2 mb-3">
            <MudText Typo="Typo.h6">Transaction preview</MudText>
            @if (_editingId is null && !_isCreating && ExpandedRule is TransactionRuleDto rule)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@IsBusy" OnClick="@(() => TestSavedRuleAsync(rule))">@(_isTesting ? "Testing..." : "Test this rule")</MudButton>
            }
        </div>
        <MudText Typo="Typo.caption">Read-only test against up to five existing transactions. No rule or transaction is saved.</MudText>
        @if (_testResults is null)
        {
            <MudText Typo="Typo.body2" Class="mt-4">@(_isTesting ? "Finding matching transactions…" : "Run a test to see actual before → after results.")</MudText>
        }
        else
        {
            <div role="status" aria-live="polite">
                <MudText Typo="Typo.subtitle2" Class="mt-3">@(_editingId is not null || _isCreating ? "Draft test results" : "Test results")</MudText>
                @if (!_testEnabled)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">Disabled rule: no actions are applied.</MudAlert>
                }
                else if (_testResults.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">No matching transactions found.</MudAlert>
                }
                else
                {
                    @foreach (var result in _testResults)
                    {
                        <div class="transaction-result">
                            <div class="d-flex flex-wrap justify-space-between gap-2 mb-2">
                                <MudText Typo="Typo.subtitle2">@result.AccountName · @result.Date.ToString("d")</MudText>
                                <MudText Typo="Typo.subtitle2">@result.Amount.ToString("N2") · @result.Before.Direction</MudText>
                            </div>
                            @BeforeAfter(result.Before, result.After)
                            <MudText Typo="Typo.caption">@(result.HasChanges ? "Matched · changes shown above." : "Rule matches but produces no effective change.")</MudText>
                        </div>
                    }
                }
            </div>
        }
    </aside>;

    private RenderFragment BeforeAfter(TransactionFacts before, TransactionFacts after) => @<div class="before-after">
        <div class="facts-column">
            <span class="facts-heading">Before</span>
            <dl>
                <dt>Contractor</dt><dd>@DisplayText(before.Contractor)</dd>
                <dt>Description</dt><dd>@DisplayText(before.Description)</dd>
                <dt>Labels</dt><dd>@FormatLabels(before.Labels)</dd>
            </dl>
        </div>
        <span class="facts-arrow" aria-hidden="true">→</span>
        <div class="facts-column">
            <span class="facts-heading">After</span>
            <dl>
                <dt>Contractor</dt><dd class="@(before.Contractor != after.Contractor ? "changed-value" : null)">@DisplayText(after.Contractor)</dd>
                <dt>Description</dt><dd class="@(before.Description != after.Description ? "changed-value" : null)">@DisplayText(after.Description)</dd>
                <dt>Labels</dt><dd class="@(!before.Labels.SequenceEqual(after.Labels) ? "changed-value" : null)">@FormatLabels(after.Labels)</dd>
            </dl>
        </div>
    </div>;
}
