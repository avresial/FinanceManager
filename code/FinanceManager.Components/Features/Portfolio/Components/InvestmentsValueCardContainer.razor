@using FinanceManager.Components.Features.Portfolio.Models
@inherits PortfolioCardBase<InvestmentsValueModel>

<TimeSeriesValueCard data-testid="investments-value-card" Title="Investments value" Data="@(Model?.Series ?? [])" Overlays="@(Model?.Overlays ?? [])"
                     SummaryValue="@Model?.CurrentValue" DeltaBaseline="@(Model is { HasPricedPositions: true } ? Model.CostBasis : null)"
                     CurrencyShortName="@(Model?.Currency ?? string.Empty)"
                     SummaryCaption="@Caption"
                     Description="Value of your shares and ETFs, capital contributed (the cost basis of what you still hold), and a benchmark bought with the same contributions. The all-time unrealized gain compares the current value with the cost basis of your open positions, whatever date range is selected."
                     Height="@Height" IsLoading="@Loading" HasError="@Failed" OnRetry="Reload" />
