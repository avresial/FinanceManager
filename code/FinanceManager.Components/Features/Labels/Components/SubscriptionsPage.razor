@page "/Subscriptions"

<PageTitle>Subscriptions</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <PageHeader Title="Subscriptions">
        <Actions>
            <MudCheckBox T="bool" @bind-Value="_showInactive"
                         Label="Show muted and cancelled"
                         Color="Color.Primary" />
        </Actions>
    </PageHeader>

    <SubscriptionsSummaryView Model="_summary"
                              IsLoading="_isSummaryLoading"
                              Currency="@_currency.ShortName" />

    <SubscriptionsListView Subscriptions="_subscriptions"
                           IsLoading="_isListLoading"
                           Currency="@_currency.ShortName"
                           ShowInactive="_showInactive"
                           UpdatingIds="_updating"
                           OnToggleFlag="ToggleFlag"
                           OnToggleMuted="ToggleMuted"
                           OnToggleCancelled="ToggleCancelled" />
</MudContainer>
