@namespace FinanceManager.Components.Features.Alerts.Components
@using FinanceManager.Application.Alerts.Models

@if (Outcome.MatchingTransactions is { Count: > 0 } transactions)
{
    <div class="d-flex flex-column gap-1" data-testid="alert-matching-transactions" style="min-width:0; max-width:100%;">
        @foreach (var transaction in transactions)
        {
            var metadata = GetTransactionMetadata(transaction);
            <div class="d-flex align-center w-100" style="min-width:0;">
                <MudLink Href="@AlertPresentation.TransactionHref(transaction)"
                         aria-label="@AlertPresentation.TransactionAriaLabel(transaction)"
                         Typo="Typo.caption"
                         Class="text-truncate flex-grow-1"
                         Style="min-width:0;">
                    @AlertPresentation.TransactionTitle(transaction)
                </MudLink>
                @if (!string.IsNullOrEmpty(metadata))
                {
                    <MudText Inline="true" Typo="Typo.caption" Class="mud-text-secondary ms-1 flex-shrink-0">
                        @metadata
                    </MudText>
                }
            </div>
        }
        @if (Outcome.MatchingTransactionCount > transactions.Count)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary flex-shrink-0">
                +@(Outcome.MatchingTransactionCount - transactions.Count) more matching
            </MudText>
        }
    </div>
}

@code {
    [Parameter] public required AlertEvaluationOutcome Outcome { get; set; }

    private static string GetTransactionMetadata(AlertTransactionReference transaction)
    {
        return string.IsNullOrWhiteSpace(transaction.ContractorDetails)
            && string.IsNullOrWhiteSpace(transaction.Description)
            ? $"on {transaction.PostingDate:yyyy-MM-dd}"
            : $"· {transaction.PostingDate:yyyy-MM-dd}";
    }
}
