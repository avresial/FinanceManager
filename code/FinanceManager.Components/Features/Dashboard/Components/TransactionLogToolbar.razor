@using FinanceManager.Components.Shared.Helpers
@using FinanceManager.Domain.FinancialAccounts.Shared.Entities

@* Toolbar of the Transactions page. Mirrors the date-range control of the account details toolbar
   (same presets, same custom range picker) without its account-specific actions, followed by the
   account-type chips and the account multi-select. The row scrolls itself instead of overflowing
   on a phone, and keeps all filters available on narrow screens. *@
<div class="fm-tx-toolbar mb-4">
    <div class="d-flex align-center fm-txlog-toolbar-row" style="gap: 8px;">
        <MudIconButton @ref="_searchButton" Icon="@(_isSearchExpanded ? Icons.Material.Filled.SearchOff : Icons.Material.Filled.Search)"
                       Size="Size.Small" Color="@(_isSearchExpanded || !string.IsNullOrWhiteSpace(SearchText) ? Color.Primary : Color.Default)"
                       OnClick="ToggleSearch" Class="fm-toolbar-search-button" Style="flex-shrink: 0;"
                       aria-label="@(_isSearchExpanded ? "Hide search" : "Search transactions")"
                       title="@(_isSearchExpanded ? "Hide search" : "Search transactions")"
                       aria-expanded="@(_isSearchExpanded ? "true" : "false")" aria-controls="@_searchPanelId" />

        <MudMenu @ref="_rangeMenu" Dense="true" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft"
                 Style="flex-shrink: 0;">
            <ActivatorContent>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           EndIcon="@Icons.Material.Filled.KeyboardArrowDown" OnClick="ToggleRangeMenu"
                           aria-label="@RangeButtonAccessibleText" title="@RangeButtonAccessibleText" aria-haspopup="menu"
                           Class="fm-range-button">
                    @RangeButtonText
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudText Typo="Typo.overline" Class="px-4 pt-2 pb-1" Style="display:block">Date range</MudText>
                @foreach (var range in Ranges)
                {
                    <MudMenuItem OnClick="@(() => OnRangeSelected(range))">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small"
                                     Style="@(SelectedRange == range ? "" : "visibility: hidden;")" />
                            <MudText Typo="Typo.body2">@range</MudText>
                        </MudStack>
                    </MudMenuItem>
                }
                <MudDivider />
                <MudMenuItem OnClick="OpenCustomDateRangePicker">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@(IsCustomRange ? Icons.Material.Filled.Check : Icons.Material.Filled.CalendarMonth)" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Custom range…</MudText>
                    </MudStack>
                </MudMenuItem>
            </ChildContent>
        </MudMenu>

        <MudChipSet T="AccountType" SelectionMode="SelectionMode.MultiSelection" CheckMark="true"
                    SelectedValues="Filter.AccountTypes" SelectedValuesChanged="OnAccountTypesChanged"
                    Class="fm-txlog-type-chips" data-testid="transactions-type-filter" aria-label="Account types">
            @foreach (var (type, label) in _typeOptions)
            {
                <MudChip T="AccountType" Value="type" Size="Size.Small" Variant="Variant.Outlined"
                         Color="Color.Default" SelectedColor="Color.Primary" Class="fm-txlog-type-chip">
                    @label
                </MudChip>
            }
        </MudChipSet>

        <MudSelect T="int" Label="Accounts" MultiSelection="true" Dense="true" Margin="Margin.Dense"
                   Variant="Variant.Outlined" Clearable="true" Disabled="@(VisibleAccounts.Count == 0)"
                   SelectedValues="Filter.AccountIds" SelectedValuesChanged="OnAccountIdsChanged"
                   ToStringFunc="GetAccountName" MultiSelectionTextFunc="GetAccountsSummary"
                   Class="fm-txlog-account-select" AnchorOrigin="Origin.BottomLeft"
                   data-testid="transactions-account-filter">
            @foreach (var account in VisibleAccounts)
            {
                <MudSelectItem T="int" Value="@account.AccountId">@account.AccountName</MudSelectItem>
            }
        </MudSelect>
    </div>

    <MudCollapse Expanded="_isSearchExpanded">
        <div id="@_searchPanelId" class="pt-2">
            <MudTextField @ref="_searchField" T="string" Value="SearchText" ValueChanged="OnSearchChanged"
                          Placeholder="Search accounts, descriptions, bonds, investments…" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate
                          DebounceInterval="150" Clearable OnKeyDown="OnSearchKeyDown" FullWidth="true"
                          aria-label="Search transactions" />
        </div>
    </MudCollapse>

    @* Hidden picker opened programmatically from the date-range menu; the Dialog variant avoids
       the broken nested-popover behaviour of embedding the picker inside a MudMenu. *@
    <div class="fm-custom-range-picker">
        <MudDateRangePicker @ref="_customDateRangePicker" DateRange="CustomDateRange" DateFormat="@DateFormatter.PickerFormat" Culture="@DateFormatter.Culture"
                            DateRangeChanged="OnCustomDateRangeChanged" PickerVariant="PickerVariant.Dialog" />
    </div>
</div>
