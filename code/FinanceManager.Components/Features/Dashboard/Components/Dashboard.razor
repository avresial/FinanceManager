@using FinanceManager.Components.Features.Dashboard.Components.Cards
@using FinanceManager.Components.Features.Dashboard.Components.Cards.Assets
@using FinanceManager.Components.Features.Dashboard.Components.Cards.Liabilities
@using FinanceManager.Components.Features.Dashboard.Components.Cards.TimeSeries
@using FinanceManager.Components.Features.Dashboard.Models
@using FinanceManager.Components.Shared.Helpers

<MudContainer Class="py-6">
    <PageHeader Title="Dashboard" Subtitle="Your net worth, cash flow and insights for the selected period.">
        <Actions>
            <DashboardDatePicker DateChanged=DateChanged StartingOption="@DateRangeHelper.CustomRangeKey"
                                 InitialCustomStart="@StartDate" InitialCustomEnd="@EndDate" />
        </Actions>
    </PageHeader>
    <SectionContent SectionName="page-actions">
        <MudMenu @ref="_customizeMenu" Label="Customize" StartIcon="@Icons.Material.Filled.Tune" Variant="Variant.Text"
                 Color="Color.Default" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudText Typo="Typo.overline" Class="px-4 pt-2 pb-1" Style="display:block">Show cards</MudText>
            @foreach (var card in DashboardCards.All)
            {
                <MudMenuItem OnClick="@(() => ToggleCard(card.Id))" AutoClose="false" Style="padding: 2.65px;">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudCheckBox Value="@(!CardVisibility.IsHidden(card.Id))" T="bool" Dense="true" ReadOnly="true"
                                     Color="Color.Primary" />
                        <MudText Typo="Typo.body2">@card.Title</MudText>
                        @if (IsAutoHiddenWhenEmpty(card.Id))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">(no data)</MudText>
                        }
                    </MudStack>
                </MudMenuItem>
            }
        </MudMenu>
    </SectionContent>

    @if (_overview is null && _isLoading)
    {
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@($"{_unitHeight * 2}px")" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@($"{_unitHeight * 2}px")" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@($"{_unitHeight * 2}px")" />
            </MudItem>
            <MudItem xs="12" md="6" lg="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@($"{_unitHeight * 3}px")" />
            </MudItem>
            <MudItem xs="12" md="6" lg="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@($"{_unitHeight * 3}px")" />
            </MudItem>
            <MudItem xs="12" md="6" lg="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@($"{_unitHeight * 3}px")" />
            </MudItem>
        </MudGrid>
    }
    else
    {
        @if (_hasError)
        {
            <MudAlert Severity="Severity.Error" Class="mb-2" ShowCloseIcon="false">
                <div class="d-flex align-center justify-space-between" style="width:100%">
                    <span>Unable to load dashboard data.</span>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LoadOverview">Retry</MudButton>
                </div>
            </MudAlert>
        }

        @if (!AnyCardVisible)
        {
            <MudAlert Severity="Severity.Info" Class="mb-2" ShowCloseIcon="false">
                All cards are hidden. Use <b>Customize</b> to choose the cards you want to see.
            </MudAlert>
        }

        <MudGrid Spacing="2">

            @if (IsCardVisible(DashboardCards.NetWorth))
            {
                <MudItem xs="12">
                    <NetWorthTimeSeriesCard Height="@_halfCardHeight" StartDateTime="@DisplayStartDate" EndDateTime="@DisplayEndDate" Model="@NetWorthModel" />
                </MudItem>
            }

            @* Each height tier is laid out as its own run so a hidden card never pulls a card of a
               different height into the same row; DashboardCardLayout decides the widths. *@
            @foreach (var slot in ArrangeTier(_halfWidthCards))
            {
                var cardId = slot.CardId;
                <MudItem xs="12" md="@slot.Medium.Span" lg="@slot.Large.Span" @key="cardId">
                    @switch (cardId)
                    {
                        case DashboardCards.NetCashFlow:
                            <NetCashFlowOverviewCard Height="@_halfCardHeight" StartDateTime="@DisplayStartDate"
                                                     EndDateTime="@DisplayEndDate" Model="@NetCashFlowModel" />
                            break;
                        case DashboardCards.CashFlowForecast:
                            <CashFlowForecastCard Height="@_halfCardHeight" />
                            break;
                        case DashboardCards.ClosingBalance:
                            <ClosingBalanceOverviewCard Height="@_halfCardHeight" StartDateTime="@DisplayStartDate"
                                                        EndDateTime="@DisplayEndDate" Model="@ClosingBalanceModel" />
                            break;
                    }
                </MudItem>
                <DashboardRowFiller MediumSpan="@slot.Medium.FillerSpanAfter" LargeSpan="@slot.Large.FillerSpanAfter"
                                    Height="@_halfCardHeight" OnClick="OpenCustomizeMenu" />
            }

            @foreach (var slot in ArrangeTier(_thirdWidthCards))
            {
                var cardId = slot.CardId;
                <MudItem xs="12" md="@slot.Medium.Span" lg="@slot.Large.Span" @key="cardId">
                    @switch (cardId)
                    {
                        case DashboardCards.Labels:
                            <FinancialLabelsListCard Height="@_thirdCardHeight" StartDateTime="@DisplayStartDate"
                                                     EndDateTime="@DisplayEndDate" Model="@LabelsModel" />
                            break;
                        case DashboardCards.Assets:
                            <AssetsDistributionOverviewCard Height="@_thirdCardHeight" StartDateTime="@DisplayStartDate"
                                                            EndDateTime="@DisplayEndDate" Model="@AssetsModel" />
                            break;
                        case DashboardCards.Liabilities:
                            <LiabilitiesDistributionOverviewCard Height="@_thirdCardHeight" StartDateTime="@DisplayStartDate"
                                                                 EndDateTime="@DisplayEndDate" Model="@LiabilitiesModel" />
                            break;
                        case DashboardCards.Expenses:
                            <ExpenseDistributionOverviewCard Height="@_thirdCardHeight" StartDateTime="@DisplayStartDate"
                                                             EndDateTime="@DisplayEndDate" Model="@ExpenseModel" />
                            break;
                        case DashboardCards.Insights:
                            <FinancialInsightsCarousel Height="@_thirdCardHeight" Count="3" />
                            break;
                        case DashboardCards.FinancialAlerts:
                            <FinancialAlertsCard Height="@_thirdCardHeight" />
                            break;
                        case DashboardCards.RecurringTransactions:
                            <RecurringTransactionDetectorCard Height="@_thirdCardHeight" />
                            break;
                    }
                </MudItem>
                <DashboardRowFiller MediumSpan="@slot.Medium.FillerSpanAfter" LargeSpan="@slot.Large.FillerSpanAfter"
                                    Height="@_thirdCardHeight" OnClick="OpenCustomizeMenu" />
            }

            @if (IsCardVisible(DashboardCards.TransactionLog))
            {
                <MudItem xs="12">
                    <TransactionLogCard Height="@_thirdCardHeight" />
                </MudItem>
            }

        </MudGrid>
    }
</MudContainer>
