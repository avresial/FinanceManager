@using FinanceManager.Components.Features.Dashboard.Components.Cards
@using FinanceManager.Components.Features.Dashboard.Components.Cards.Assets
@using FinanceManager.Components.Features.Dashboard.Components.Cards.Liabilities
@using FinanceManager.Components.Features.Dashboard.Components.Cards.TimeSeries
@using FinanceManager.Components.Features.Dashboard.Models
@using FinanceManager.Components.Shared.Helpers

<MudContainer Class="py-6">
    <PageHeader Title="Dashboard" />
    @if (_hasError)
    {
        <MudAlert Severity="Severity.Error" Class="mb-2" ShowCloseIcon="false">
            <div class="d-flex align-center justify-space-between" style="width:100%">
                <span>Unable to load dashboard data.</span>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LoadOverview">Retry</MudButton>
            </div>
        </MudAlert>
    }
    <DashboardCardGrid Page="dashboard" Cards="_cards" MenuCards="DashboardCards.All"
                       AutoHidden="IsAutoHiddenWhenEmpty" IsLoading="@(_overview is null && _isLoading)">
        <Actions>
            <DashboardDatePicker DateChanged=DateChanged StartingOption="@DateRangeHelper.CustomRangeKey"
                                 InitialCustomStart="@StartDate" InitialCustomEnd="@EndDate" />
        </Actions>
        <LoadingContent>
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@DashboardCardGrid.CardHeight" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@DashboardCardGrid.CardHeight" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@DashboardCardGrid.CardHeight" />
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@DashboardCardGrid.CardHeight" />
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@DashboardCardGrid.CardHeight" />
                </MudItem>
                <MudItem xs="12" md="6" lg="4">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@DashboardCardGrid.CardHeight" />
                </MudItem>
            </MudGrid>
        </LoadingContent>
        <CardContent Context="cardId">
            @switch (cardId)
            {
                case DashboardCards.NetWorth:
                    <NetWorthTimeSeriesCard Height="@DashboardCardGrid.CardHeight" StartDateTime="@DisplayStartDate"
                                            EndDateTime="@DisplayEndDate" Model="@NetWorthModel" />
                    break;
                case DashboardCards.NetCashFlow:
                    <NetCashFlowOverviewCard Height="@DashboardCardGrid.CardHeight" StartDateTime="@DisplayStartDate"
                                             EndDateTime="@DisplayEndDate" Model="@NetCashFlowModel" />
                    break;
                case DashboardCards.CashFlowForecast:
                    <CashFlowForecastCard Height="@DashboardCardGrid.CardHeight" />
                    break;
                case DashboardCards.ClosingBalance:
                    <ClosingBalanceOverviewCard Height="@DashboardCardGrid.CardHeight" StartDateTime="@DisplayStartDate"
                                                EndDateTime="@DisplayEndDate" Model="@ClosingBalanceModel" />
                    break;
                case DashboardCards.Labels:
                    <FinancialLabelsListCard Height="@DashboardCardGrid.CardHeight" StartDateTime="@DisplayStartDate"
                                             EndDateTime="@DisplayEndDate" Model="@LabelsModel" />
                    break;
                case DashboardCards.Assets:
                    <AssetsDistributionOverviewCard Height="@DashboardCardGrid.CardHeight" StartDateTime="@DisplayStartDate"
                                                    EndDateTime="@DisplayEndDate" Model="@AssetsModel" />
                    break;
                case DashboardCards.Liabilities:
                    <LiabilitiesDistributionOverviewCard Height="@DashboardCardGrid.CardHeight" StartDateTime="@DisplayStartDate"
                                                         EndDateTime="@DisplayEndDate" Model="@LiabilitiesModel" />
                    break;
                case DashboardCards.Expenses:
                    <ExpenseDistributionOverviewCard Height="@DashboardCardGrid.CardHeight" StartDateTime="@DisplayStartDate"
                                                     EndDateTime="@DisplayEndDate" Model="@ExpenseModel" />
                    break;
                case DashboardCards.Insights:
                    <FinancialInsightsCarousel Height="@DashboardCardGrid.CardHeight" Count="3" />
                    break;
                case DashboardCards.FinancialAlerts:
                    <FinancialAlertsCard Height="@DashboardCardGrid.CardHeight" />
                    break;
                case DashboardCards.RecurringTransactions:
                    <RecurringTransactionDetectorCard Height="@DashboardCardGrid.CardHeight" />
                    break;
                case DashboardCards.TransactionLog:
                    <TransactionLogCard Height="@DashboardCardGrid.CardHeight" />
                    break;
            }
        </CardContent>
    </DashboardCardGrid>
</MudContainer>
