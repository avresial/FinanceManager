@page "/Liabilities"
@using FinanceManager.Components.Features.Dashboard.Components.Cards.Liabilities
@using FinanceManager.Components.Shared.Helpers
@using FinanceManager.Components.Features.Dashboard.Models
@using FinanceManager.Components.Features.Dashboard.Components.Cards.TimeSeries

<PageTitle>Liabilities</PageTitle>

<MudContainer Class="py-6">
    <PageHeader Title="Liabilities" />
    <DashboardCardGrid Page="liabilities" Cards="_cards">
        <Actions>
            <DashboardDatePicker DateChanged=DateChanged StartingOption="@DateRangeHelper.CustomRangeKey"
                                 InitialCustomStart="@StartDate" InitialCustomEnd="@EndDate" />
        </Actions>
        <CardContent Context="cardId">
            @switch (cardId)
            {
                case "liabilities-history":
                    <LiabilitiesTimeSeriesCard StartDateTime=StartDate EndDateTime="@EndDate" Height="@DashboardCardGrid.CardHeight" />
                    break;
                case "liabilities-distribution":
                    <LiabilitiesDistributionOverviewCard StartDateTime=StartDate EndDateTime="@EndDate" Height="@DashboardCardGrid.CardHeight" />
                    break;
            }
        </CardContent>
    </DashboardCardGrid>
</MudContainer>
