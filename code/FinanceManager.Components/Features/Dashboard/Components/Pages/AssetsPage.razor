@page "/Assets"
@using FinanceManager.Components.Features.Dashboard.Components.Cards.Assets
@using FinanceManager.Components.Shared.Helpers

<PageTitle>Assets</PageTitle>
<MudContainer Class="py-6">
    <PageHeader Title="Assets" />
    <SectionContent SectionName="page-actions">
        <DashboardDatePicker DateChanged=DateChanged StartingOption="@DateRangeHelper.CustomRangeKey"
                             InitialCustomStart="@StartDate" InitialCustomEnd="@EndDate" />
    </SectionContent>
    <MudGrid Spacing="2">
        <MudItem xs="12">
            <AssetsTimeSeriesCardContainer StartDateTime=StartDate EndDateTime="@EndDate" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <AssetsDistributionOverviewCard StartDateTime=StartDate EndDateTime="@EndDate"
                                            Height="@($"{2 * _unitHeight}px")" />
        </MudItem>

        <MudItem xs="12" lg="8">
            <PortfolioReturnCardContainer StartDateTime=StartDate EndDateTime="@EndDate" FetchReturns="GetPortfolioReturns" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <PortfolioReturnAttributionCardContainer StartDateTime=StartDate EndDateTime="@EndDate" FetchReturns="GetPortfolioReturns"
                                            Height="@($"{2 * _unitHeight}px")" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <InvestmentPaycheckEstimatorCard Height="@($"{2 * _unitHeight}px")" />
        </MudItem>

        <MudItem xs="12" lg="4">
            <InvestmentRateCard Height="@($"{2 * _unitHeight}px")" />
        </MudItem>

        <MudItem xs="12" md="6">
            <DiversificationProxyCard Height="@($"{2 * _unitHeight}px")" />
        </MudItem>

        <MudItem xs="12" md="6">
            <FeeDragCard Height="@($"{2 * _unitHeight}px")" AsOfDate="@EndDate" />
        </MudItem>
    </MudGrid>
</MudContainer>
