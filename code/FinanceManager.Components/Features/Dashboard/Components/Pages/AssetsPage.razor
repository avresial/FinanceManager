@page "/Assets"
@using FinanceManager.Components.Features.Dashboard.Components.Cards.Assets
@using FinanceManager.Components.Shared.Helpers
@using FinanceManager.Components.Features.Dashboard.Models
@using FinanceManager.Components.Features.Dashboard.Components.Cards.TimeSeries

<PageTitle>Assets</PageTitle>
<MudContainer Class="py-6">
    <PageHeader Title="Assets" />
    <DashboardCardGrid Page="assets" Cards="_cards">
        <Actions>
            <DashboardDatePicker DateChanged=DateChanged StartingOption="@DateRangeHelper.CustomRangeKey"
                                 InitialCustomStart="@StartDate" InitialCustomEnd="@EndDate" />
        </Actions>
        <CardContent Context="cardId">
            <RefreshingCardFrame IsRefreshing="@_refreshingCards.Contains(cardId)">
            @switch (cardId)
            {
                case "assets-history":
                    <AssetsTimeSeriesCardContainer StartDateTime=StartDate EndDateTime="@EndDate" Height="@DashboardCardGrid.CardHeight"
                                                   RefreshingChanged="@(refreshing => SetCardRefreshing(cardId, refreshing))" />
                    break;
                case "assets-distribution":
                    <AssetsDistributionOverviewCard StartDateTime=StartDate EndDateTime="@EndDate" Height="@DashboardCardGrid.CardHeight"
                                                    RefreshingChanged="@(refreshing => SetCardRefreshing(cardId, refreshing))" />
                    break;
                case "portfolio-return":
                    <PortfolioReturnCardContainer StartDateTime=StartDate EndDateTime="@EndDate" FetchReturns="GetPortfolioReturns" Height="@DashboardCardGrid.CardHeight"
                                                  RefreshingChanged="@(refreshing => SetCardRefreshing(cardId, refreshing))" />
                    break;
                case "return-attribution":
                    <PortfolioReturnAttributionCardContainer StartDateTime=StartDate EndDateTime="@EndDate" FetchReturns="GetPortfolioReturns" Height="@DashboardCardGrid.CardHeight"
                                                             RefreshingChanged="@(refreshing => SetCardRefreshing(cardId, refreshing))" />
                    break;
                case "investment-paycheck":
                    <InvestmentPaycheckEstimatorCard Height="@DashboardCardGrid.CardHeight" />
                    break;
                case "investment-rate":
                    <InvestmentRateCard Height="@DashboardCardGrid.CardHeight" />
                    break;
                case "diversification":
                    <DiversificationProxyCard Height="@DashboardCardGrid.CardHeight" />
                    break;
                case "fee-drag":
                    <FeeDragCard AsOfDate="@EndDate" Height="@DashboardCardGrid.CardHeight" />
                    break;
            }
            </RefreshingCardFrame>
        </CardContent>
    </DashboardCardGrid>
</MudContainer>
