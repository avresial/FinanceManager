@using FinanceManager.Components.Features.Transactions.Investments.Components.TransactionHistory
@using FinanceManager.Components.Features.Dashboard.Models
<div data-testid="transaction-history-row" data-kind="@Item.Kind">
    @switch (Item)
    {
        case CurrencyTransactionHistoryItem currency:
            <TransactionRow @key="Item.Key" Entry="currency.Entry" Currency="@currency.Currency"
                            IsMobile="@IsMobile" SiblingsShareSameTime="@SiblingsShareSameTime" />
            break;
        case BondTransactionHistoryItem bond:
            <BondTransactionRow @key="Item.Key" BondName="@bond.BondName" Entry="bond.Entry" BondDetails="@BondDetails" IsMobile="@IsMobile" />
            break;
        case InvestmentTransactionHistoryItem investment:
            <InvestmentTransactionRow @key="Item.Key" Transaction="investment.Transaction" Valuation="@Valuation" IsMobile="@IsMobile"
                                      OnEdit="OnEditInvestment" OnDelete="OnDeleteInvestment" />
            break;
    }
</div>
