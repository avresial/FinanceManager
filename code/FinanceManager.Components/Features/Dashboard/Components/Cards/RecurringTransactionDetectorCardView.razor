@using FinanceManager.Domain.FinancialAccounts.Currencies.Entities

<MudCard Outlined Class="rounded-lg d-flex flex-column" Style="@($"height:{Height};")" data-testid="recurring-transactions-card">
    <CardHeader Title="@(SelectedItem?.Name ?? "Recurring transactions")"
                InfoText="Transactions that repeat on a schedule, grouped by income and outgoing with monthly totals. Select one to see its entries."
                InfoAriaLabel="About recurring transactions card"
                StackedAside="true"
                Leading="@(SelectedItem is null ? null : BackButton)"
                Actions="@(SelectedItem is null ? ViewAllButton : null)">
        <SubtitleContent>
            @if (SelectedItem is null)
            {
                @if (IsLoading)
                {
                    <StringSpinner CharactersCount="4" />
                }
                else if (Data.Count > 0)
                {
                    <span data-testid="recurring-subtitle" style="white-space:normal;">
                        @if (_income.Count > 0)
                        {
                            @* One line on purpose: whitespace between the spans would land in the text. Each fragment stays whole
                               and the line only breaks at the spaces between them. *@
                            <span data-testid="recurring-net" class="text-nowrap @(NetMonthlyFlow > 0 ? "mud-success-text" : NetMonthlyFlow < 0 ? "mud-error-text" : null)">Net @MoneyFormatter.FormatSigned(NetMonthlyFlow, Currency)/mo</span>@(" ")<span class="text-nowrap">· @MoneyFormatter.Format(TotalMonthlyIncome, Currency) in</span>@(" ")<span class="text-nowrap">· @MoneyFormatter.Format(TotalMonthlyOutgoing, Currency) out</span>
                        }
                        else
                        {
                            @($"Outgoing {MoneyFormatter.Format(TotalMonthlyOutgoing, Currency)}/mo")
                        }
                    </span>
                }
            }
            else if (DetailEntries.Count > 0)
            {
                @DetailEntries.First().PostingDate.Year
            }
        </SubtitleContent>
    </CardHeader>

    <ScrollFadeArea Class="flex-grow-1 overflow-auto" Style="min-height:0;">
        @if (SelectedItem is null)
        {
            @if (IsLoading)
            {
                <div style="height:100%">
                    <ChartSpinner MaxHeight=@Height />
                </div>
            }
            else if (HasError)
            {
                <MudAlert Severity="Severity.Error" Dense="true">Unable to load recurring transactions.
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="OnRetry">Retry</MudButton>
                </MudAlert>
            }
            else if (Data.Count > 0)
            {
                @foreach (var isIncome in new[] { true, false })
                {
                    var items = isIncome ? _income : _outgoing;
                    var color = isIncome ? Color.Success : Color.Error;
                    var label = isIncome ? "Income" : "Outgoing";
                    @if (items.Count > 0)
                    {
                        <section class="px-2 pb-2" aria-label="@label" data-testid="@(isIncome ? "recurring-income-group" : "recurring-outgoing-group")">
                            <div class="d-flex justify-space-between align-center gap-2 px-2 py-1">
                                <MudText Typo="Typo.overline" HtmlTag="h3" Class="fm-caps font-weight-600">@label</MudText>
                                <MudText Typo="Typo.caption" Color="@color" Class="font-weight-600">@FormatFlow(isIncome, items.Sum(item => Math.Abs(item.Value)))/mo</MudText>
                            </div>
                            @foreach (var item in items)
                            {
                                <MudButton @ref="_rowButtons[item]" Variant="Variant.Text" Color="Color.Default" FullWidth Class="py-1 px-2" Style="text-transform:none;" OnClick="() => OnItemSelected.InvokeAsync(item)">
                                    <span class="d-flex align-center gap-3 w-100">
                                        <span class="flex-grow-1" style="min-width:0;text-align:left;">
                                            <MudText Typo="Typo.body2" HtmlTag="span" Class="d-block font-weight-500 mb-1" Style="display:-webkit-box!important;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;white-space:normal;" title="@item.Name">@item.Name</MudText>
                                            <MudProgressLinear Value="@GetPercentage(item.Value, items)" Color="@color" aria-label="@($"{item.Name}: relative monthly {label.ToLowerInvariant()}")"
                                                               Class="mt-1" Size="Size.Small" />
                                        </span>
                                        @* A shared minimum width for the amounts gives every bar the same track, so lengths compare across rows. *@
                                        <MudText Typo="Typo.body2" HtmlTag="span" Color="@color" Class="font-weight-600 flex-shrink-0" Style="min-width:8rem;text-align:right;white-space:nowrap;">
                                            @($"{FormatFlow(isIncome, item.Value)}/mo")
                                        </MudText>
                                    </span>
                                </MudButton>
                            }
                        </section>
                    }
                }
            }
            else
            {
                <div class="d-flex flex-grow-1 justify-center align-content-center flex-wrap">
                    <MudText Typo="Typo.button" HtmlTag="h3">No recurring transactions</MudText>
                </div>
            }
        }
        else
        {
            @if (IsLoadingDetail)
            {
                <div style="height:100%">
                    <ChartSpinner MaxHeight=@Height />
                </div>
            }
            else if (HasDetailError)
            {
                <MudAlert Severity="Severity.Error" Dense="true">Unable to load transaction details.
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="OnRetryDetail">Retry</MudButton>
                </MudAlert>
            }
            else if (DetailEntries.Count > 0)
            {
                <MudTable Items="DetailEntries" Dense Hover Striped Elevation="0" Class="pa-2">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh Style="text-align:right">Amount</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@DateFormatter.FormatDayMonth(context.PostingDate)</MudTd>
                        <MudTd DataLabel="Description">
                            @{
                                var desc = string.IsNullOrEmpty(context.ContractorDetails) ? context.Description : context.ContractorDetails;
                                var maxLength = 30;
                                var displayDesc = desc.Length > maxLength ? desc.Substring(0, maxLength) + "..." : desc;
                            }
                            <MudTooltip Text="@desc" Arrow Placement="Placement.Bottom">
                                <MudText>@displayDesc</MudText>
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Amount" Style="text-align:right">
                            <MudText Color="@(SelectedItem.IsIncome ? Color.Success : Color.Error)">
                                @FormatFlow(SelectedItem.IsIncome, context.ValueChange)
                            </MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <div class="d-flex flex-grow-1 justify-center align-content-center flex-wrap">
                    <MudText Typo="Typo.button" HtmlTag="h3">No entries found</MudText>
                </div>
            }
        }
    </ScrollFadeArea>
</MudCard>

@code {
    private RenderFragment BackButton => @<MudIconButton @ref="_backButton" Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" OnClick="OnBack" aria-label="Back to recurring transactions" />;

    private RenderFragment ViewAllButton => @<MudButton Href="/Subscriptions" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                                       Class="flex-shrink-0" aria-label="See all recurring transactions">
        View all
    </MudButton>;
}
