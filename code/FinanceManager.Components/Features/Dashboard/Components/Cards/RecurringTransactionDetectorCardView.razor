@using FinanceManager.Domain.FinancialAccounts.Currencies.Entities

<MudCard Outlined Class="d-flex flex-nowrap" Style="@($"height:{Height};")">
    <MudPaper Class="d-flex align-center flex-grow-0 px-4 pt-3 pb-1 fm-card-info-header" Elevation="0">
        <div class="flex-grow-1" style="min-width:0;">
            <div class="d-flex align-center gap-1">
                @if (SelectedItem is not null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" OnClick="OnBack" aria-label="Back to recurring transactions" />
                }
                <CardInfoTooltip Text="Transactions that repeat on a schedule, with their monthly cost. Select one to see its entries."
                                 AriaLabel="About recurring transactions card">
                    @if (SelectedItem is null)
                    {
                        <MudText Typo=Typo.h5>Recurring transactions</MudText>
                    }
                    else
                    {
                        <MudText Typo=Typo.h5>@SelectedItem.Name</MudText>
                    }
                </CardInfoTooltip>
            </div>
            @if (SelectedItem is null)
            {
                @if (IsLoading)
                {
                    <MudText Typo=Typo.subtitle1 Class="text-muted">
                        <StringSpinner CharactersCount="4" />
                    </MudText>
                }
                else if (Data.Count > 0)
                {
                    <MudText Typo=Typo.subtitle1 Class="text-muted">@MoneyFormatter.Format(TotalMonthlySpend, Currency)/mo</MudText>
                }
            }
            else if (DetailEntries.Count > 0)
            {
                <MudText Typo=Typo.caption Class="text-muted">@DetailEntries.First().PostingDate.Year</MudText>
            }
        </div>
        @if (SelectedItem is null)
        {
            <MudButton Href="/Subscriptions" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                       Class="flex-shrink-0" aria-label="See all recurring transactions">
                View all
            </MudButton>
        }
    </MudPaper>

    <ScrollFadeArea Class="flex-grow-1 overflow-auto" Style="min-height:0;">
        @if (SelectedItem is null)
        {
            @if (IsLoading)
            {
                <div style="height:100%">
                    <ChartSpinner MaxHeight=@Height />
                </div>
            }
            else if (Data.Count > 0)
            {
                <MudList T="string" Dense Class="px-2 py-0">
                    @foreach (var item in Data)
                    {
                        <MudListItem Class="py-1 px-2 cursor-pointer" @onclick="() => OnItemSelected.InvokeAsync(item)">
                            <div class="d-flex align-items-center gap-3 w-100">
                                <MudIcon Icon="@(item.IsIncome ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.Repeat)"
                                         Color="@(item.IsIncome ? Color.Success : Color.Inherit)" Size="Size.Small" />
                                <div class="flex-grow-1">
                                    <MudText Typo="Typo.body2" Class="font-weight-500">@item.Name</MudText>
                                    <MudProgressLinear Value="@GetPercentage(item.Value)" Color="Color.Warning"
                                                      Class="mt-1" Size="Size.Small" />
                                </div>
                                <MudText Typo="Typo.body2" Color="@(item.IsIncome ? Color.Success : Color.Warning)" Class="font-weight-600"
                                         Style="min-width: 120px; text-align: right;">
                                    @($"{FormatFlow(item.IsIncome, item.Value)}/mo")
                                </MudText>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
            else
            {
                <div class="d-flex flex-grow-1 justify-center align-content-center flex-wrap">
                    <MudText Typo="Typo.button" HtmlTag="h3">No recurring transactions</MudText>
                </div>
            }
        }
        else
        {
            @if (IsLoadingDetail)
            {
                <div style="height:100%">
                    <ChartSpinner MaxHeight=@Height />
                </div>
            }
            else if (DetailEntries.Count > 0)
            {
                <MudTable Items="DetailEntries" Dense Hover Striped Elevation="0" Class="pa-2">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh Style="text-align:right">Amount</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Date">@DateFormatter.FormatDayMonth(context.PostingDate)</MudTd>
                        <MudTd DataLabel="Description">
                            @{
                                var desc = string.IsNullOrEmpty(context.ContractorDetails) ? context.Description : context.ContractorDetails;
                                var maxLength = 30;
                                var displayDesc = desc.Length > maxLength ? desc.Substring(0, maxLength) + "..." : desc;
                            }
                            <MudTooltip Text="@desc" Arrow Placement="Placement.Bottom">
                                <MudText>@displayDesc</MudText>
                            </MudTooltip>
                        </MudTd>
                        <MudTd DataLabel="Amount" Style="text-align:right">
                            <MudText Color="@(SelectedItem.IsIncome ? Color.Success : Color.Error)">
                                @FormatFlow(SelectedItem.IsIncome, context.ValueChange)
                            </MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <div class="d-flex flex-grow-1 justify-center align-content-center flex-wrap">
                    <MudText Typo="Typo.button" HtmlTag="h3">No entries found</MudText>
                </div>
            }
        }
    </ScrollFadeArea>
</MudCard>
