@using FinanceManager.Components.Shared.Components
@using FinanceManager.Domain.MoneyFlow.Entities

<MudCard Outlined Class="rounded-lg fm-phone-auto-height" data-testid="portfolio-return-card" Style="@($"height:{Height};overflow-y:auto;")">
    <CardHeader Title="Portfolio return"
                InfoText="XIRR reflects cash-flow size and timing as a yearly rate. TWR measures the selected period's return, adjusting for external cash flows. Their signs can differ."
                InfoAriaLabel="About portfolio return"
                Subtitle="@RangeText" />
    <MudCardContent Class="pa-4 pt-1">
        @if (HasError)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">Could not load portfolio returns.</MudAlert>
        }
        <div class="portfolio-return-metrics">
            <section class="portfolio-return-metric portfolio-return-metric--money" aria-label="Money-weighted return">
                <div class="portfolio-return-metric-heading">
                    <span class="portfolio-return-metric-icon"><MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Small" /></span>
                    <MudTooltip Text="XIRR accounts for the size and timing of contributions and withdrawals, using actual days between cash flows and a 365-day year. It is annualized, not the percentage gained during the selected period." Arrow="true">
                        <span tabindex="0" aria-label="About money-weighted return">Money-weighted return (XIRR) ⓘ</span>
                    </MudTooltip>
                </div>
                @if (IsLoading)
                {
                    <MudText Typo="Typo.h4" Class="text-muted"><StringSpinner CharactersCount="6" /></MudText>
                }
                else if (MoneyWeightedReturn?.IsAvailable == true && MoneyWeightedReturn.AnnualizedReturn is decimal annualizedReturn)
                {
                    <div class="@(annualizedReturn >= 0 ? "portfolio-return-value portfolio-return-value--money" : "portfolio-return-value portfolio-return-value--negative")">@FormatReturn(annualizedReturn)</div>
                }
                else
                {
                    <MudText Typo="Typo.h6" Class="portfolio-return-muted">@MoneyWeightedStatusLabel</MudText>
                    <MudText Typo="Typo.caption" Class="portfolio-return-muted">@MoneyWeightedStatusText</MudText>
                }
                <MudText Typo="Typo.caption" Class="portfolio-return-muted">Annualized · @Currency.ShortName</MudText>
            </section>

            <section class="portfolio-return-metric portfolio-return-metric--time" aria-label="Time-weighted return">
                <div class="portfolio-return-metric-heading">
                    <span class="portfolio-return-metric-icon"><MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" /></span>
                    <MudTooltip Text="TWR compounds daily returns after adjusting for external cash flows at the start of each day. It measures cumulative performance over the selected period and is not annualized." Arrow="true">
                        <span tabindex="0" aria-label="About time-weighted return">Time-weighted return (TWR) ⓘ</span>
                    </MudTooltip>
                </div>
                @if (IsLoading)
                {
                    <MudText Typo="Typo.h4" Class="text-muted"><StringSpinner CharactersCount="6" /></MudText>
                }
                else if (TimeWeightedReturn?.IsAvailable == true && TimeWeightedReturn.TotalReturn is decimal totalReturn)
                {
                    <div class="@(totalReturn >= 0 ? "portfolio-return-value portfolio-return-value--time" : "portfolio-return-value portfolio-return-value--negative")">@FormatReturn(totalReturn)</div>
                }
                else
                {
                    <MudText Typo="Typo.h6" Class="portfolio-return-muted">@TimeWeightedStatusLabel</MudText>
                    <MudText Typo="Typo.caption" Class="portfolio-return-muted">@TimeWeightedStatusText</MudText>
                }
                <MudText Typo="Typo.caption" Class="portfolio-return-muted">Cumulative · @Currency.ShortName</MudText>
            </section>
        </div>

        @if (!IsLoading)
        {
            @if (!HasAvailableReturn)
            {
                <MudText Typo="Typo.body2" Class="portfolio-return-muted mt-3">Neither return is available for this range.</MudText>
            }
            @if (HasError || MoneyWeightedReturn is null || TimeWeightedReturn is null)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="Retry"
                           AriaLabel="Retry unavailable return">Retry unavailable return</MudButton>
            }
            @* The insight explains the two returns, so it only earns its space when one is available. *@
            @if (HasAvailableReturn)
            {
                <div class="portfolio-return-insight" data-testid="portfolio-return-insight">
                    <span class="portfolio-return-insight-icon"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" /></span>
                    <span>@InsightText</span>
                </div>
            }
        }

        <div class="portfolio-return-footer">
            @if (!IsLoading && ExternalCashMovement is decimal movement)
            {
                <div class="portfolio-return-fact">
                    <span class="portfolio-return-muted">Net external cash flow</span>
                    <strong>@FormatAmount(movement)</strong>
                </div>
            }
            <div class="portfolio-return-fact">
                <span class="portfolio-return-muted">Period length</span>
                <strong>@PeriodLength days</strong>
            </div>
        </div>
    </MudCardContent>
</MudCard>
