@using FinanceManager.Components.Shared.Components
@using FinanceManager.Domain.MoneyFlow.Entities

<MudCard Outlined Class="rounded-lg d-flex flex-column" Style="@($"height:{Height};")">
    <MudCardContent Class="d-flex flex-column flex-grow-1 pa-4">
        <CardInfoTooltip Text="Annualized investment performance that accounts for when contributions and withdrawals happened."
                         AriaLabel="About money-weighted return">
            <MudText Typo="Typo.h6">Money-weighted return</MudText>
        </CardInfoTooltip>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Investment performance for the selected range, not raw account-value growth.
        </MudText>

        @if (_isLoading)
        {
            <MudText Typo="Typo.h3" Class="text-muted"><StringSpinner CharactersCount="6" /></MudText>
        }
        else if (_hasError)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">Could not load the return.</MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Reload" AriaLabel="Retry money-weighted return">Retry</MudButton>
        }
        else if (_result?.IsAvailable == true && _result.AnnualizedReturn is decimal annualizedReturn)
        {
            <MudText Typo="Typo.h3" Color="@(annualizedReturn >= 0 ? Color.Success : Color.Error)">
                @FormatReturn(annualizedReturn)
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Annualized money-weighted return · @_currency.ShortName</MudText>
        }
        else
        {
            <MudText Typo="Typo.h5" Color="Color.Secondary">@StatusLabel</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@StatusText</MudText>
        }

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-auto">@RangeText</MudText>
    </MudCardContent>
</MudCard>
