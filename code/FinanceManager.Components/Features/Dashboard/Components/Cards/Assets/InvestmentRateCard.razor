@using ApexCharts

<MudCard Outlined Class="rounded-lg d-flex flex-column investment-rate-card" Style="@($"height:{Height};overflow:hidden;")">
    <MudCardContent Class="d-flex flex-column flex-grow-1 pa-4">
        <div class="mb-2">
            <MudText Typo="Typo.h6">Investment rate</MudText>
            <MudText Typo="Typo.body2" Color="MudBlazor.Color.Secondary">Net investment purchases relative to salary.</MudText>
        </div>

        @if (_isLoading)
        {
            <MudText Typo="Typo.h3" Class="mb-1 text-muted">
                <StringSpinner CharactersCount="6" />
            </MudText>
        }
        else
        {
            <div class="d-flex flex-wrap align-end gap-3 mb-2" style="row-gap:4px;">
                @if (_currentMonthPercentage is decimal currentRate)
                {
                    <div class="d-flex align-baseline mr-auto">
                        <MudText Typo="Typo.h3" Color="MudBlazor.Color.Primary">@FormatRateNumber(currentRate)</MudText>
                        <MudText Typo="Typo.h6" Color="MudBlazor.Color.Primary" Class="ml-1">%</MudText>
                    </div>
                }
                else
                {
                    @* No salary in the period means no denominator — say so instead of showing a misleading rate. *@
                    <div class="d-flex flex-column mr-auto">
                        <MudText Typo="Typo.h5" Color="MudBlazor.Color.Secondary">No rate</MudText>
                        <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">no salary this month</MudText>
                    </div>
                }
                <div class="d-none d-sm-flex flex-column align-end">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">ON TRACK FOR</MudText>
                    <MudText Typo="Typo.subtitle1">@FormatProjection()</MudText>
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">by year end</MudText>
                </div>
            </div>

            <div class="d-flex justify-space-between mb-1">
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">Monthly rate · last 12 months</MudText>
                <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">avg @FormatAveragePercentage(_ytdAveragePercentage)</MudText>
            </div>
            <div class="investment-rate-card__chart">
                @if (_chartOptions is not null)
                {
                    <ApexChart TItem="MonthBar"
                               Options="@_chartOptions"
                               OnDataPointSelection="OnBarSelected"
                               @key="_selectedRateIndex"
                               Height="@("100%")">
                        <ApexPointSeries TItem="MonthBar"
                                         Items="@_series"
                                         Name="Rate"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(p => (object)p.Label)"
                                         YValue="@(p => (decimal?)p.Percentage)"
                                         PointColor="@(p => p.IsSelected ? _highlightColor : _mutedBarColor)" />
                    </ApexChart>
                }
            </div>

            @* flex-grow:0 keeps the divider a thin line; MudDivider's default flex-grow:1 would stretch it vertically in this flex-column card. *@
            <MudDivider Class="my-1" Style="flex-grow:0;" />
            <MudGrid Spacing="1">
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@SelectedMonthName salary</MudText>
                    <MudText Typo="Typo.body2">@FormatAmount(SelectedMonthRate?.Salary ?? 0)</MudText>
                </MudItem>
                <MudItem xs="6">
                    <MudText Typo="Typo.caption" Color="MudBlazor.Color.Secondary">@SelectedMonthName invested</MudText>
                    <MudText Typo="Typo.body2"
                             Color="@(SelectedMonthRate?.InvestmentsChange > 0 ? MudBlazor.Color.Success : MudBlazor.Color.Default)">
                        @FormatChange(SelectedMonthRate?.InvestmentsChange ?? 0)
                    </MudText>
                </MudItem>
            </MudGrid>
        }
    </MudCardContent>
</MudCard>
