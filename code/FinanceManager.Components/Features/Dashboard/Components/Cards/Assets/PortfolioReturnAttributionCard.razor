@using FinanceManager.Components.Shared.Components
@using FinanceManager.Domain.MoneyFlow.Entities

<MudCard Outlined Class="rounded-lg d-flex flex-column" Style="@($"height:{Height};")" data-testid="return-attribution-card">
    <MudCardContent Class="d-flex flex-column flex-grow-1 pa-4">
        <CardInfoTooltip Text="Explains the selected portfolio value change using external cash movement, known fees, currency translation, and the remaining investment effect."
                         AriaLabel="About return attribution">
            <MudText Typo="Typo.h6">Return attribution</MudText>
        </CardInfoTooltip>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Why the portfolio changed over the selected range.
        </MudText>

        @if (_isLoading)
        {
            <MudText Typo="Typo.h3" Class="text-muted"><StringSpinner CharactersCount="6" /></MudText>
        }
        else if (_hasError)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">Could not load return attribution.</MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Reload" AriaLabel="Retry return attribution">Retry</MudButton>
        }
        else if (_result?.IsAvailable == true)
        {
            <div class="d-flex flex-column ga-1" data-testid="return-attribution-breakdown" role="list" aria-label="Portfolio return attribution breakdown">
                <div class="d-flex justify-space-between" role="listitem">
                    <MudText Typo="Typo.body2">Total change</MudText>
                    <MudText Typo="Typo.body2"><strong>@FormatAmount(_result.TotalChange)</strong></MudText>
                </div>
                <div class="d-flex justify-space-between" role="listitem">
                    <MudText Typo="Typo.body2">External cash movement</MudText>
                    <MudText Typo="Typo.body2"><strong>@FormatAmount(_result.ExternalCashMovement)</strong></MudText>
                </div>
                <div class="d-flex justify-space-between" role="listitem">
                    <MudText Typo="Typo.body2">Market / valuation effect</MudText>
                    <MudText Typo="Typo.body2"><strong>@FormatAmount(_result.MarketEffect)</strong></MudText>
                </div>
                <div class="d-flex justify-space-between" role="listitem">
                    <MudText Typo="Typo.body2">FX effect</MudText>
                    <MudText Typo="Typo.body2"><strong>@FormatAmount(_result.FxEffect)</strong></MudText>
                </div>
                <div class="d-flex justify-space-between" role="listitem">
                    <MudText Typo="Typo.body2">Known transaction fees</MudText>
                    <MudText Typo="Typo.body2"><strong>@FormatAmount(_result.FeeEffect)</strong></MudText>
                </div>
            </div>

            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-3">
                Unavailable: @UnsupportedComponentsText
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-auto">
                Reconciliation difference: @FormatAmount(_result.ReconciliationDifference)
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.h5" Color="Color.Secondary">@StatusLabel</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@StatusText</MudText>
        }

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@RangeText</MudText>
    </MudCardContent>
</MudCard>
