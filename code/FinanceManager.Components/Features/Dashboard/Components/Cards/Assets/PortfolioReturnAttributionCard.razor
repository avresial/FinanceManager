@using FinanceManager.Components.Shared.Components
@using FinanceManager.Domain.MoneyFlow.Entities

<MudCard Outlined Class="rounded-lg d-flex flex-column" Style="@($"height:{Height};")" data-testid="return-attribution-card">
    <MudCardContent Class="d-flex flex-column flex-grow-1 pa-4">
        <div class="attribution-heading">
            <CardInfoTooltip Text="Explains the selected portfolio value change using external cash movement, known fees, currency translation, and the remaining investment effect."
                             AriaLabel="About return attribution">
                <MudText Typo="Typo.h6">Return attribution</MudText>
            </CardInfoTooltip>
            <span class="attribution-range">@RangeText</span>
        </div>
        <div class="attribution-helper">
            Why the portfolio changed over the selected range.
        </div>

        @if (_isLoading)
        {
            <MudText Typo="Typo.h3" Class="text-muted"><StringSpinner CharactersCount="6" /></MudText>
        }
        else if (_hasError)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">Could not load return attribution.</MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Reload" AriaLabel="Retry return attribution">Retry</MudButton>
        }
        else if (_result?.IsAvailable == true)
        {
            var steps = AttributionSteps;
            <div class="attribution-total" data-testid="return-attribution-total">
                <span>Total change</span>
                <strong>@FormatAmount(_result.TotalChange)</strong>
            </div>

            <div class="attribution-chart" role="img" aria-label="@AttributionSummary" data-testid="return-attribution-chart">
                @foreach (var step in steps)
                {
                    <div class="attribution-row" data-testid="return-attribution-step" aria-hidden="true">
                        <span class="attribution-label">@step.Label</span>
                        <div class="attribution-plot">
                            <span class="attribution-zero-line" style="left:@ChartPosition(0m, steps)%"></span>
                            <span class="attribution-connector" style="left:@ChartPosition(step.End, steps)%"></span>
                            <span class="attribution-bar @(step.Value > 0m ? "positive" : step.Value < 0m ? "negative" : "zero")"
                                  style="@BarStyle(step.Start, step.End, steps)"></span>
                        </div>
                        <strong class="attribution-value">@FormatAmount(step.Value)</strong>
                    </div>
                }
                <div class="attribution-row attribution-final" aria-hidden="true">
                    <span class="attribution-label">Total change</span>
                    <div class="attribution-plot">
                        <span class="attribution-zero-line" style="left:@ChartPosition(0m, steps)%"></span>
                        <span class="attribution-bar total" style="@BarStyle(0m, _result.TotalChange!.Value, steps)"></span>
                    </div>
                </div>
            </div>

            <div class="attribution-footer mt-auto">
                <div>
                    Reconciliation difference: @FormatAmount(_result.ReconciliationDifference)
                </div>
                @if (_result.UnsupportedComponents.Count > 0)
                {
                    <div>
                        Unavailable: @UnsupportedComponentsText
                    </div>
                }
            </div>
        }
        else
        {
            <MudText Typo="Typo.h5" Color="Color.Secondary">@StatusLabel</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@StatusText</MudText>
        }
    </MudCardContent>
</MudCard>
