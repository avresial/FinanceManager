@using FinanceManager.Components.Shared.Components
@using FinanceManager.Domain.MoneyFlow.Entities
@using System.Globalization

<MudCard Outlined Class="rounded-lg d-flex flex-column" Style="@($"height:{Height};overflow-y:auto;")" data-testid="return-attribution-card">
    <CardHeader Title="Return attribution"
                InfoText="Explains the selected portfolio value change using external cash movement, known fees, currency translation, and the remaining investment effect."
                InfoAriaLabel="About return attribution"
                Subtitle="@RangeText" />
    <MudCardContent Class="d-flex flex-column flex-grow-1 pa-4 pt-1">
        <div class="attribution-helper">
            Why the portfolio changed over the selected range.
        </div>

        @if (HasError)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">Could not load return attribution.
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="Retry" AriaLabel="Retry return attribution">Retry</MudButton>
            </MudAlert>
        }
        @if (IsLoading)
        {
            <MudText Typo="Typo.h3" Class="text-muted"><StringSpinner CharactersCount="6" /></MudText>
        }
        else if (Model?.IsAvailable == true)
        {
            var columns = ChartColumns;
            var scale = ChartScale;
            var ticks = ChartTicks(scale);
            <div class="attribution-total" data-testid="return-attribution-total">
                <span>Total change</span>
                <strong class="@ValueTone(Model.TotalChange!.Value)">@FormatAmount(Model.TotalChange)</strong>
            </div>

            <div class="attribution-chart" role="img" aria-label="@AttributionSummary" data-testid="return-attribution-chart">
                <div class="attribution-axis" aria-hidden="true">
                    <div class="attribution-axis-track">
                        @foreach (var tick in ticks)
                        {
                            <span class="attribution-axis-label" style="@PositionStyle(tick, scale)">@FormatAxisValue(tick)</span>
                        }
                    </div>
                </div>
                <div class="attribution-plot" aria-hidden="true">
                    <div class="attribution-plot-area">
                        @foreach (var tick in ticks)
                        {
                            <span class="attribution-gridline @(tick == 0m ? "baseline" : null)" style="@PositionStyle(tick, scale)"></span>
                        }
                        @for (var index = 0; index < columns.Count - 1; index++)
                        {
                            var column = columns[index];
                            <span class="attribution-connector" style="@ConnectorStyle(index, columns.Count, column.End, scale)"></span>
                        }
                        <div class="attribution-columns">
                            @foreach (var column in columns)
                            {
                                <div class="attribution-column"
                                     data-testid="return-attribution-column"
                                     data-start="@column.Start.ToString(CultureInfo.InvariantCulture)"
                                     data-end="@column.End.ToString(CultureInfo.InvariantCulture)">
                                    <span class="attribution-bar @BarTone(column)" style="@BarStyle(column, scale)"></span>
                                    <span class="attribution-value @ValueTone(column.Value) @(column.IsTotal ? "total" : null)"
                                          data-testid="return-attribution-value"
                                          style="@PositionStyle(column.End, scale)">@FormatColumnValue(column)</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="attribution-axis-spacer" aria-hidden="true"></div>
                <div class="attribution-categories" aria-hidden="true">
                    @foreach (var column in columns)
                    {
                        <span class="attribution-category @(column.IsTotal ? "total" : null)"
                              title="@column.Label"
                              data-testid="return-attribution-category">@column.ShortLabel</span>
                    }
                </div>
            </div>

            <div class="attribution-footer mt-auto">
                <div>
                    Reconciliation difference: @FormatAmount(Model.ReconciliationDifference)
                </div>
                @if (Model.UnsupportedComponents.Count > 0)
                {
                    <div>
                        Unavailable: @UnsupportedComponentsText
                    </div>
                }
            </div>
        }
        else if (!HasError)
        {
            <MudText Class="mud-text-secondary" Typo="Typo.h5">@StatusLabel</MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">@StatusText</MudText>
        }
    </MudCardContent>
</MudCard>
