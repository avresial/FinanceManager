@using FinanceManager.Components.Shared.Components
@using FinanceManager.Domain.MoneyFlow.Entities

<MudCard Outlined Class="rounded-lg d-flex flex-column" Style="@($"height:{Height};")">
    <MudCardContent Class="d-flex flex-column flex-grow-1 pa-4">
        <CardInfoTooltip Text="Portfolio performance with contributions and withdrawals removed from the return calculation."
                         AriaLabel="About time-weighted return">
            <MudText Typo="Typo.h6">Time-weighted return</MudText>
        </CardInfoTooltip>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Portfolio performance for the selected range, independent of cash-flow timing.
        </MudText>

        @if (_isLoading)
        {
            <MudText Typo="Typo.h3" Class="text-muted"><StringSpinner CharactersCount="6" /></MudText>
        }
        else if (_hasError)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">Could not load the return.</MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="Reload" AriaLabel="Retry time-weighted return">Retry</MudButton>
        }
        else if (_result?.IsAvailable == true && _result.TotalReturn is decimal totalReturn)
        {
            <MudText Typo="Typo.h3" Color="@(totalReturn >= 0 ? Color.Success : Color.Error)">
                @FormatReturn(totalReturn)
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Cumulative time-weighted return · @_currency.ShortName</MudText>
        }
        else
        {
            <MudText Typo="Typo.h5" Color="Color.Secondary">@StatusLabel</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@StatusText</MudText>
        }

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-auto">@RangeText</MudText>
    </MudCardContent>
</MudCard>
