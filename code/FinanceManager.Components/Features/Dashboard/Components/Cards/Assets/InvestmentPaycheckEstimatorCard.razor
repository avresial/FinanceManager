@using FinanceManager.Domain.MoneyFlow.Entities

<MudCard Outlined Class="pc-card d-flex flex-column" Style="@($"height:{Height};")">
    <MudCardContent Class="pc-card-content d-flex flex-column flex-grow-1">
        <div class="pc-head">
            <div class="pc-title-row">
                <CardInfoTooltip Text="What your portfolio could pay you each month if your salary stopped, at the chosen withdrawal rate."
                                 AriaLabel="About investment paycheck card"
                                 TooltipClass="fm-card-info-glossary">
                    <ChildContent>
                        <MudText Typo="Typo.h6" Class="pc-title">Investment paycheck</MudText>
                    </ChildContent>
                    <TooltipContent>
                        <div class="fm-card-info-glossary-head">What's in this card</div>
                        <dl>
                            <dt>Investment paycheck</dt>
                            <dd>The monthly amount your portfolio could sustainably pay you if your salary stopped today.</dd>
                            <dt>Withdrawal rate</dt>
                            <dd>The annual share of your portfolio you'd draw down. 4% is the classic "safe withdrawal rate", historically tested to last 30+ years of retirement.</dd>
                            <dt>Conservative / Standard / Aggressive</dt>
                            <dd>Presets at 3% / 4% / 5%. Lower rates reduce the risk of running out. Higher rates pay more but deplete faster.</dd>
                            <dt>Replacement %</dt>
                            <dd>What share of your average monthly salary this paycheck would cover.</dd>
                            <dt>Total investments value</dt>
                            <dd>Current market value of your investable assets, including stocks, bonds and funds. Cash and liabilities are excluded.</dd>
                            <dt>@_estimate.SalaryMonthsUsed of @_estimate.SalaryMonthsRequested months</dt>
                            <dd>Months of salary history used to calculate the average.</dd>
                        </dl>
                    </TooltipContent>
                </CardInfoTooltip>
            </div>
            <MudText Typo="Typo.body2" Class="pc-sub">
                If you stopped earning today, your portfolio could pay you:
            </MudText>
        </div>

        @if (_isLoading)
        {
            <div class="pc-hero">
                <MudText Typo="Typo.h3" Class="pc-hero-num pc-hero-num--loading">
                    <StringSpinner CharactersCount="4" />
                </MudText>
            </div>
        }
        else
        {
            <div class="pc-hero">
                <span class="pc-hero-num">@FormatMonthly(MonthlyPaycheck)</span>
                <span class="pc-hero-cur">@_currency.ShortName</span>
                <span class="pc-hero-per">/mo</span>
            </div>

            @if (_estimate.HasSalaryData && _estimate.AverageMonthlySalary is { } avgSalary)
            {
                <div class="pc-vs">
                    Covers
                    <button type="button" class="pc-vs-pill" title="Click to expand">
                        @FormatReplacement(ReplacementRatio)
                    </button>
                    of your average @FormatNumber(avgSalary, 0)&nbsp;@_currency.ShortName salary.
                </div>
            }
            else
            {
                <div class="pc-vs pc-vs--muted">
                    No salary history yet — replacement % will appear once income entries are recorded.
                </div>
            }
        }

        <div class="pc-slider-block">
            <div class="pc-slider-head">
                <span class="pc-slider-label">Withdrawal rate</span>
                <span class="pc-slider-val">@FormatRate(_annualWithdrawalRate)</span>
            </div>
            <MudSlider T="decimal" Value="_annualWithdrawalRate" ValueChanged="OnRateChanged"
                       Min="_rateMin" Max="_rateMax" Step="_rateStep" Immediate="true"
                       Color="Color.Primary" Class="pc-slider" />
            <div class="pc-named-chips">
                @foreach (var preset in _presets)
                {
                    var isOn = Math.Abs(preset.Rate - _annualWithdrawalRate) < 0.0005m;
                    <button type="button"
                            class="@($"pc-named-chip {(isOn ? "pc-named-chip--on" : string.Empty)}")"
                            @onclick="() => OnPresetSelected(preset.Rate)">
                        <span class="pc-named-chip-label">@preset.Label</span>
                        <span class="pc-named-chip-rate">@($"{preset.Rate * 100:0}%")</span>
                    </button>
                }
            </div>
        </div>

        <div class="pc-foot">
            <span>
                <MudTooltip Text="The total value of all investments currently owned by the user.">
                    <span class="pc-foot-label">Total investments value:</span>
                </MudTooltip>
                <span class="pc-foot-num">@FormatCurrency(_estimate.InvestableAssetsValue)</span>
            </span>
            @if (_estimate.SalaryMonthsUsed != _estimate.SalaryMonthsRequested)
            {
                <span class="@(_estimate.HasPartialSalaryHistory ? "pc-foot-meta pc-foot-meta--warn" : "pc-foot-meta")">
                    @_estimate.SalaryMonthsUsed of @_estimate.SalaryMonthsRequested mo
                </span>
            }
        </div>
    </MudCardContent>
</MudCard>
