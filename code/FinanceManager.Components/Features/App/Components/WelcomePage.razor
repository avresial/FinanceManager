@namespace FinanceManager.Components.Features.App.Components

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">

    @* Hero: what FinanceManager is for *@
    <MudGrid Class="align-center mb-4">
        <MudItem xs="12" md="9" lg="8" Class="order-1">
            <MudText Typo="Typo.h3" Class="mb-3">Welcome to FinanceManager</MudText>
            <MudText Typo="Typo.h6" Style="color: var(--mud-palette-text-secondary);" Class="mb-4">
                Keep all of your finances in one place. Track your net worth, cash flow and
                investments across cash, bonds, shares and ETFs — and watch your dashboard
                come alive as you add data.
            </MudText>
            <MudText Typo="Typo.body1" Class="mb-2">
                It only takes a minute: <b>add your first transaction</b>, or import a CSV
                statement from your bank.
            </MudText>
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-6" />

    @* Primary call to action: pick what to track first *@
    <div class="text-center mb-5">
        <MudText Typo="Typo.h4" Class="mb-2">Add your first transaction</MudText>
        <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
            Pick whichever fits what you want to track first — you can always add the rest later.
        </MudText>
    </div>

    <MudGrid Class="mb-2">
        <MudItem xs="12" sm="4" Class="d-flex">
            <MudCard Elevation="0" Outlined="true" Class="rounded-lg d-flex flex-column flex-grow-1" data-testid="welcome-cash">
                <MudCardHeader Class="py-2 px-4">
                    <CardHeaderContent>
                        <div class="fm-card-info-centered">
                            <CardInfoTooltip Text="Add cash transactions for everyday money: salary, bills and spending."
                                             AriaLabel="About the cash card">
                                <MudText Typo="Typo.h6" Class="w-100 text-center">Cash</MudText>
                            </CardInfoTooltip>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="d-flex flex-column align-center text-center flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Color="Color.Default" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mt-2">
                        Everyday money: salary, bills and spending. Add transactions by hand or import a CSV statement from your bank.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="justify-center pb-4 gap-2 flex-wrap">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" data-testid="welcome-import-csv"
                               StartIcon="@Icons.Material.Filled.UploadFile" OnClick="ImportCsv">
                        Import CSV
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" data-testid="welcome-add-cash"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddTransaction("cash"))">
                        Add transaction
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="4" Class="d-flex">
            <MudCard Elevation="0" Outlined="true" Class="rounded-lg d-flex flex-column flex-grow-1" data-testid="welcome-bond">
                <MudCardHeader Class="py-2 px-4">
                    <CardHeaderContent>
                        <div class="fm-card-info-centered">
                            <CardInfoTooltip Text="Add bond purchases and redemptions for treasury and savings bonds."
                                             AriaLabel="About the bond card">
                                <MudText Typo="Typo.h6" Class="w-100 text-center">Bond</MudText>
                            </CardInfoTooltip>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="d-flex flex-column align-center text-center flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.Savings" Color="Color.Default" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mt-2">
                        Treasury and savings bonds. Add entries by hand or import a CSV export of your bond purchases.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="justify-center pb-4 gap-2 flex-wrap">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" data-testid="welcome-import-bond-csv"
                               StartIcon="@Icons.Material.Filled.UploadFile" OnClick="ImportBondCsv">
                        Import CSV
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" data-testid="welcome-add-bond"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddTransaction("bond"))">
                        Add transaction
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="4" Class="d-flex">
            <MudCard Elevation="0" Outlined="true" Class="rounded-lg d-flex flex-column flex-grow-1" data-testid="welcome-investment">
                <MudCardHeader Class="py-2 px-4">
                    <CardHeaderContent>
                        <div class="fm-card-info-centered">
                            <CardInfoTooltip Text="Add buys and sells of shares and ETFs, with valuation of your holdings."
                                             AriaLabel="About the investment card">
                                <MudText Typo="Typo.h6" Class="w-100 text-center">Investment</MudText>
                            </CardInfoTooltip>
                        </div>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="d-flex flex-column align-center text-center flex-grow-1">
                    <MudIcon Icon="@Icons.Material.Filled.ShowChart" Color="Color.Default" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mt-2">
                        Shares and ETFs. Track holdings and see how your portfolio value changes over time.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="justify-center pb-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" data-testid="welcome-add-investment"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddTransaction("investment"))">
                        Add transaction
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudDivider Class="my-6" />

    @* Preview carousel: what the app looks like with data *@
    <div class="text-center mb-4">
        <MudText Typo="Typo.h4" Class="mb-2">See what you'll get</MudText>
        <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-secondary);">
            A quick look at the dashboard, transactions and assets once they fill up with data.
        </MudText>
    </div>

    <div class="onb-carousel-host">
    <MudCarousel TData="object" Class="rounded-lg mud-width-full mb-6 fm-onb-carousel"
                 ShowArrows="true" ShowBullets="true" EnableSwipeGesture="true" AutoCycle="true"
                 AutoCycleTime="TimeSpan.FromSeconds(6)" Elevation="0">
        @foreach (var preview in _previews)
        {
            <MudCarouselItem Transition="Transition.Slide">
                <div class="d-flex flex-column align-center justify-center onb-slide">
                    <img src="@preview.Light" alt="@preview.Caption" class="onb-img onb-carousel onb-light rounded-lg" />
                    <img src="@preview.Dark" alt="@preview.Caption" class="onb-img onb-carousel onb-dark rounded-lg" />
                </div>
            </MudCarouselItem>
        }
    </MudCarousel>
    </div>

</MudContainer>

@code {
    private record Preview(string Light, string Dark, string Caption);

    private readonly Preview[] _previews =
    [
        new("IMGS/onboarding/dashboard-light.jpg", "IMGS/onboarding/dashboard-dark.jpg", "Dashboard — your finances at a glance"),
        new("IMGS/onboarding/transactions-light.jpg", "IMGS/onboarding/transactions-dark.jpg", "Transactions — every cash, bond and investment entry in one list"),
        new("IMGS/onboarding/assets-light.jpg", "IMGS/onboarding/assets-dark.jpg", "Assets — net worth, holdings and portfolio value over time"),
    ];
}
