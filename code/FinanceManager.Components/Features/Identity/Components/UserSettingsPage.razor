@page "/UserSettings"
@using FinanceManager.Domain.Assets.Dtos
@using FinanceManager.Domain.Identity.Entities

<PageTitle>User settings</PageTitle>

<SectionContent SectionName="page-title">
    <MudText Typo="Typo.h6">Settings</MudText>
</SectionContent>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    @if (_userData is not null)
    {
        <MudGrid>
            <MudItem xs="12" md="3" Class="d-none d-md-block">
                <div style="position:sticky; top:16px;">
                    <MudList T="string"
                             SelectionMode="SelectionMode.SingleSelection"
                             @bind-SelectedValue="_selectedSection"
                             @bind-SelectedValue:after="OnSectionSelectedAfter">
                        <MudListItem T="string" Value="@("profile")" Text="Profile" />
                        <MudListItem T="string" Value="@("preferences")" Text="Preferences" />
                        <MudListItem T="string" Value="@("password")" Text="Password" />
                        <MudListItem T="string" Value="@("subscription")" Text="Subscription" />
                        <MudListItem T="string" Value="@("danger")" Text="Danger zone" />
                    </MudList>
                </div>
            </MudItem>

            <MudItem xs="12" md="9" Style="max-width:720px;">
                <MudText Typo="Typo.h4">Account settings</MudText>
                <MudText Class="mud-text-secondary" Typo="Typo.body2">
                    Manage your Finance Manager account, security, and subscription.
                </MudText>

                <MudDivider Class="my-6" />

                <section class="settings-section" id="profile">
                    <MudText Typo="Typo.h6">Profile</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
                        Your public identity within Finance Manager.
                    </MudText>

                    <div class="d-flex flex-column flex-md-row align-md-center gap-3 mb-4">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mud-width-full" Style="min-width:0;">
                            <MudAvatar Color="Color.Primary" Size="Size.Large">@char.ToUpperInvariant(_displayName[0])</MudAvatar>
                            <MudStack Spacing="0" Style="min-width:0;">
                                <MudText Typo="Typo.subtitle1" Style="word-break:break-word;">@_displayName</MudText>
                                <MudText Class="mud-text-secondary" Typo="Typo.body2" Style="word-break:break-word;">@_userData.Login</MudText>
                            </MudStack>
                        </MudStack>
                        <MudStack Row="true" Spacing="2" Class="flex-wrap">
                            <MudButton Variant="Variant.Outlined" Disabled="true">Upload photo</MudButton>
                            <MudButton Variant="Variant.Text" Disabled="true">Remove</MudButton>
                        </MudStack>
                    </div>

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="Display name"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Value="@_displayName"
                                          ReadOnly="true"
                                          HelperText="Taken from your account." />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="Email"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Value="@_email"
                                          Disabled="true" />
                        </MudItem>
                    </MudGrid>
                </section>

                <MudDivider Class="my-6" />

                <section class="settings-section" id="preferences">
                    <MudText Typo="Typo.h6">Preferences</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
                        All balances and asset values are recalculated to your preferred currency.
                    </MudText>

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSelect T="int"
                                       Label="Preferred currency"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Value="@_selectedCurrencyId"
                                       ValueChanged="@(v => _selectedCurrencyId = v)">
                                @foreach (var currency in _currencies)
                                {
                                    <MudSelectItem T="int" Value="@currency.Id">@($"{currency.ShortName} ({currency.Symbol})")</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudAutocomplete T="InstrumentSearchResultDto"
                                             Label="Investment benchmark"
                                             Value="@_selectedBenchmark"
                                             ValueChanged="OnBenchmarkChanged"
                                             SearchFunc="SearchBenchmarksAsync"
                                             ToStringFunc="@(benchmark => benchmark is null ? string.Empty : $"{benchmark.Ticker} — {benchmark.ExchangeName}")"
                                             HelperText="Leave empty to compare against Polish inflation."
                                             Placeholder="Polish inflation"
                                             Clearable="true"
                                             AdornmentAriaLabel="Show benchmark suggestions"
                                             MinCharacters="1"
                                             DebounceInterval="300"
                                             ResetValueOnEmptyText="true"
                                             CoerceText="false"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                    <div class="d-flex justify-end mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check"
                                   Disabled="@(!HasPreferenceChanges || _isSavingPreferences)" OnClick="SavePreferencesAsync"
                                   data-testid="save-preferences">Save preferences</MudButton>
                    </div>
                </section>

                <MudDivider Class="my-6" />

                <section class="settings-section" id="password">
                    <MudText Typo="Typo.h6">Password</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
                        Use at least 12 characters with a mix of letters, numbers, and symbols.
                    </MudText>

                    <div @key="_passwordFormVersion">
                        <MudGrid>
                            <MudItem xs="12">
                                <MudTextField T="string"
                                              @bind-Value="_currentPassword"
                                              Immediate="true"
                                              Label="Current password"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              InputType="InputType.Password" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string"
                                              @bind-Value="_newPassword"
                                              Immediate="true"
                                              Label="New password"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              InputType="InputType.Password"
                                              Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudTextField T="string"
                                              @bind-Value="_confirmPassword"
                                              Immediate="true"
                                              Label="Repeat new password"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              InputType="InputType.Password"
                                              Validation="@(new Func<string, string?>(PasswordMatch))" />
                            </MudItem>
                        </MudGrid>
                        <div class="d-flex justify-end mt-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Check"
                                       Disabled="@(!CanChangePassword || _isSavingPassword)" OnClick="SavePasswordAsync"
                                       data-testid="save-password">Update password</MudButton>
                        </div>
                    </div>
                </section>

                <MudDivider Class="my-6" />

                <section class="settings-section" id="subscription">
                    <MudText Typo="Typo.h6">Subscription</MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mb-4">
                        You're on the lifetime @_userData.PricingLevel plan.
                    </MudText>

                    @if (_recordCapacity is not null)
                    {
                        <MudText Typo="Typo.body2" Class="mb-1">Storage usage</MudText>
                        <MudProgressLinear Color="@GetStorageIndicatorColor()" Size="Size.Medium" Value="@_recordCapacity.GetStorageUsedPercentage()" Class="mb-1" />
                        <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);" Class="mb-4">
                            @($"{_recordCapacity.UsedCapacity} of {_recordCapacity.TotalCapacity} records")
                        </MudText>
                    }

                    <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);" Class="mb-3">
                        Paid tiers are granted with one-time gift codes. Redeemed upgrades remain active for the lifetime of your account.
                    </MudText>
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                        <MudTextField T="string" @bind-Value="_giftCode" Label="Gift code" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true" MaxLength="64" Disabled="_isRedeemingGiftCode" Class="flex-grow-1" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RedeemGiftCode"
                                   Disabled="@(_isRedeemingGiftCode || string.IsNullOrWhiteSpace(_giftCode))"
                                   StartIcon="@Icons.Material.Filled.CardGiftcard">
                            @(_isRedeemingGiftCode ? "Redeeming…" : "Redeem")
                        </MudButton>
                    </MudStack>
                </section>

                <MudDivider Class="my-6" />

                <section class="settings-section" id="danger">
                    <MudText Typo="Typo.h6" Color="Color.Error">Danger zone</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
                        Permanently delete this account and all associated financial data. This cannot be undone.
                    </MudText>

                    <div class="d-flex flex-column flex-sm-row align-sm-center gap-3">
                        <MudTextField T="string"
                                      @bind-Value="_deleteConfirmation"
                                      Immediate="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Label="@($"Type '{_requiredDeleteConfirmation}' to confirm")"
                                      Error="@(!string.IsNullOrEmpty(_deleteConfirmation) && _deleteConfirmation != _requiredDeleteConfirmation)"
                                      Class="flex-grow-1" />
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Error"
                                   Disabled="@(_deleteConfirmation != _requiredDeleteConfirmation)"
                                   OnClick="DeleteMyAccount">
                            Delete account
                        </MudButton>
                    </div>
                </section>

                @if (_errors.Count > 0 || _warnings.Count > 0 || _info.Count > 0)
                {
                    <MudStack Spacing="2" Class="mt-6">
                        @foreach (var message in _errors)
                        {
                            <MudAlert Severity="Severity.Error">@message</MudAlert>
                        }
                        @foreach (var message in _warnings)
                        {
                            <MudAlert Severity="Severity.Warning">@message</MudAlert>
                        }
                        @foreach (var message in _info)
                        {
                            <MudAlert Severity="Severity.Info">@message</MudAlert>
                        }
                    </MudStack>
                }
            </MudItem>
        </MudGrid>
    }
    else if (_isLoadingPage)
    {
    }
    else
    {
        <MudAlert Severity="Severity.Error">User data could not be loaded. Please refresh the page.</MudAlert>
    }
</MudContainer>
