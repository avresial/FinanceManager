@using FinanceManager.Components.Features.Dashboard.Models;
@using FinanceManager.Components.Features.Dashboard.Services;
@using FinanceManager.Components.Features.FinancialAccounts.Models;
@using FinanceManager.Components.Features.FinancialAccounts.Services;
@using FinanceManager.Components.Features.Identity.Models;
@using FinanceManager.Components.Features.Identity.Services;
@using FinanceManager.Components.Shared.Models;
@using FinanceManager.Components.Shared.Services;
@using Blazored.LocalStorage
@using Blazored.SessionStorage
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

<MudContainer MaxWidth="MaxWidth.Small" style="height:100vh;" Class="d-flex flex-column justify-center">
    <MudGrid Justify="Justify.Center">
        <MudItem sm="10" xs="12">
            <MudPaper Class="py-12 px-4 px-sm-12">
                <MudText Typo="Typo.h4" Class="text-center mb-3 mt-3">Finance Manager</MudText>
                <MudText Typo="Typo.h2" Class="mb-4 fs-6 fw-normal text-center">Create your account</MudText>
                @if (_errors is not null)
                {
                    @foreach (var error in _errors)
                    {
                        <MudAlert Severity="Severity.Error" Class="my-3">@error</MudAlert>
                    }
                }
                @if (_accountCreated)
                {
                    <MudAlert Severity="Severity.Info" Class="my-3">
                        Account created. Please <MudLink Href="login">sign in</MudLink>.
                    </MudAlert>
                }
                <MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors">
                    <MudTextField @bind-Value="_loginModel.Login" T="string" Label="Email" Variant="Variant.Outlined"
                        Validation="@(new Func<string, string?>(ValidateEmail))" Immediate Required Class="mt-5"
                        InputType="InputType.Email" />
                    <MudTextField @bind-Value="FirstName" T="string" Label="First name" Variant="Variant.Outlined"
                        Immediate Required />
                    <MudTextField @bind-Value="LastName" T="string" Label="Last name (optional)"
                        Variant="Variant.Outlined" Immediate />
                    <MudTextField @bind-Value="_loginModel.Password" T="string" Label="Password"
                        Variant="Variant.Outlined" Immediate Required InputType="InputType.Password" />
                    <MudTextField @bind-Value="ConfirmPassword" T="string" Label="Confirm Password"
                        Validation="@(new Func<string, string?>(PasswordMatch))" Variant="Variant.Outlined" Class="mb-5"
                        Immediate Required InputType="InputType.Password" />

                    <MudButton Class="my-2" Variant="Variant.Filled" Color="Color.Primary" type="submit"
                        @onclick=Register Disabled="_isRegistering">
                        <MudText Typo="Typo.h5">@(_isRegistering ? "Registering…" : "Register")</MudText>
                    </MudButton>
                    <MudButton Href="login" Class="my-2" Variant="Variant.Outlined" Color="Color.Primary">
                        <MudText Typo="Typo.h5">Login</MudText>
                    </MudButton>
                    <MudLink Href="landingpage" Class="mt-3">
                        <MudText Typo="Typo.subtitle1">Learn more</MudText>
                    </MudLink>
                </MudForm>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
